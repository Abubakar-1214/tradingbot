# ============================================================================ #
# Trading Bot — Environment Configuration
# ============================================================================ #
# Copy this file to `.env` and fill in values.  `core/config.py` loads it via
# python-dotenv and VALIDATES every value.  Invalid values raise at startup.
#
# SECURITY: never commit the real `.env` (it is gitignored).  The example
# values below are safe defaults.

# --------------------------------------------------------------------------- #
# TRADING MODE GATE (MOST IMPORTANT)
# --------------------------------------------------------------------------- #
# demo (default) | live
#   demo  -> paper/simulation only (MockBroker or demo MT5 account).
#   live  -> REFUSES TO START unless every live gate passes:
#            feature contract present + model present + risk state loadable
#            + reconciliation passed + MT5_LOGIN/PASSWORD/SERVER configured.
TRADING_MODE=demo

# --------------------------------------------------------------------------- #
# SYMBOL / TIMEFRAME
# --------------------------------------------------------------------------- #
# Only XAUUSD currently has data in data/ (validated by config).
SYMBOL=XAUUSD
# Candle timeframe the strategy trades on (M1,M5,M15,H1,H4,D1,W1).
TIMEFRAME=H1

# Long AND short support (short = sell-first).  Default False (long/flat only).
# When True the strategy may open SHORT positions.
ALLOW_SHORT=false

# --------------------------------------------------------------------------- #
# SIGNAL SOURCE (live-loop strategy backend)
# --------------------------------------------------------------------------- #
# rule (default) -> causal SMA fast/slow crossover signal (no model needed).
# ppo            -> trained PPO checkpoint; requires MODEL_PATH + feature
#                   contract (live mode refuses to start without them).
SIGNAL_SOURCE=rule

# --------------------------------------------------------------------------- #
# RISK MANAGEMENT (circuit breakers — validated, persisted to SQLite)
# --------------------------------------------------------------------------- #
# Max fraction of equity lost in one day before all trading halts for the day.
MAX_DAILY_LOSS=0.05
# Max drawdown from peak equity before a hard halt.
MAX_DRAWDOWN=0.15
# Max consecutive losing trades before a cooldown/halt.
MAX_CONSECUTIVE_LOSSES=5
# Fraction of equity risked per trade (drives position sizing).
MAX_RISK_PER_TRADE=0.02
# Max fraction of equity held as notional exposure per position.
MAX_POSITION=0.10
# Max trades per day.
MAX_TRADES_PER_DAY=20
# Minimum seconds between two trades.
MIN_TRADE_INTERVAL_SEC=300
# Volatility z-score threshold above which new entries are blocked.
VOL_THRESHOLD=3.0
# Max spread (fraction of price) acceptable for an entry.
MAX_SPREAD=0.0005
# Block entries outside liquid market hours.  Default false.
MARKET_HOURS_ONLY=false

# Correlation guard (configurable now — was hardcoded before).
# When enabled, a strong UP move in CORRELATION_ASSET blocks NEW LONG entries.
CORRELATION_GUARD_ENABLED=false
CORRELATION_ASSET=DXY
CORRELATION_BLOCK_LONG_ON_UP=0.01

# --------------------------------------------------------------------------- #
# COST MODEL (backtests + mock broker)
# --------------------------------------------------------------------------- #
COST_SPREAD=0.00025
COST_COMMISSION=0.00003
COST_SLIPPAGE=0.00005
COST_SWAP_LONG=-0.00004
COST_SWAP_SHORT=-0.00002

# --------------------------------------------------------------------------- #
# FEATURE PIPELINE (causal, contract-validated)
# --------------------------------------------------------------------------- #
# Observation window in bars (matches model input).
FEATURE_WINDOW=64
# Shift applied to daily macro data so the bar only sees CLOSED daily candles.
MACRO_SHIFT=1
# Bars dropped while rolling features warm up (must exceed max rolling window).
FEATURE_DROP_WARMUP=200
# Z-score features using TRAIN-window stats only (no test leakage).
FEATURE_NORMALIZE=true

# --------------------------------------------------------------------------- #
# MODEL / CONTRACT PATHS
# --------------------------------------------------------------------------- #
MODEL_PATH=train/ppo_xauusd_latest.zip
FEATURE_CONTRACT_PATH=train/feature_contract.json

# --------------------------------------------------------------------------- #
# PERSISTENCE PATHS
# --------------------------------------------------------------------------- #
RISK_STATE_DB=state/risk_state.db
LOCAL_STATE_FILE=state/bot_state.json
LOG_DIR=logs
KILL_SWITCH_PATH=KILL_SWITCH
BACKTEST_RESULTS_DIR=research/backtest_results

# --------------------------------------------------------------------------- #
# MT5 BROKER (live trading)
# --------------------------------------------------------------------------- #
# Required for TRADING_MODE=live.  Leave blank to use the MockBroker (demo).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional explicit path to terminal64.exe (auto-detected on most installs).
MT5_PATH=
# Magic number tags every order from this bot (idempotency/ownership).
MT5_MAGIC=234000
# Max price deviation in points accepted for market orders.
MT5_DEVIATION=20
# Stop-loss / take-profit distances in ATR units (applied to EVERY order).
SL_ATR_MULT=2.0
TP_ATR_MULT=3.0
# Retry policy on TRADE_RETCODE_REQUOTE.
MAX_REQUOTE_RETRIES=3
ORDER_RETRY_DELAY_SEC=1.0

# --------------------------------------------------------------------------- #
# LOGGING
# --------------------------------------------------------------------------- #
LOG_LEVEL=INFO

# --------------------------------------------------------------------------- #
# OPTIONAL DATA-PROVIDER API KEYS (sentiment/news — not required for core)
# --------------------------------------------------------------------------- #
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=

# MetaAPI (secondary broker adapter; MT5 is primary).
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
