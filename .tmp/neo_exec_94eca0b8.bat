powershell -Command "$r='e:\Desktop\NeoMind\Bazz\autonoumuse_trader'; $f=Join-Path $r 'scripts\generate_economic_calendar.py'; if(Test-Path -LiteralPath $f){$c=Get-Content -LiteralPath $f; '__LINES__ '+$c.Count; ($c | Select-String -Pattern 'first Friday|first_friday|13:30|DST|synthetic|placeholder' | Select-Object -First 6) | ForEach-Object { $_.LineNumber.ToString() + ' ' + $_.Line.Trim() }}else{'__NOFILE__'}"