powershell -Command "$csv='e:\Desktop\NeoMind\Bazz\autonoumuse_trader\Advanced_100_AI_Models_List.csv'; $rows = Import-Csv $csv; $srcFiles = Get-ChildItem -LiteralPath 'e:\Desktop\NeoMind\Bazz\autonoumuse_trader' -Recurse -Include *.py,*.md,*.ipynb -File | Where-Object { $_.FullName -notmatch '\\.venv\\|\\archive\\|\\__pycache__\\|\\site-packages\\' }; Write-Host ('MODELS_IN_CSV=' + $rows.Count); $found = 0; foreach($r in $rows){ $name = $r.'Model Name'; $hits = @(); foreach($f in $srcFiles){ $content = Get-Content -LiteralPath $f.FullName -Raw -ErrorAction SilentlyContinue; if($content -and $content.Contains($name)){ $rel = $f.FullName.Replace('e:\Desktop\NeoMind\Bazz\autonoumuse_trader\',''); $hits += $rel } }; if($hits.Count -gt 0){ $found++; Write-Host ('FOUND|' + $name + '|' + ($hits -join ';')) } }; Write-Host ('MODELS_WITH_CODE_REF=' + $found)"