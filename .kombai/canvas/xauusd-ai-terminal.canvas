      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Saira:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#050604] font-[Saira] text-[#edf0dc]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#343923] bg-[#0a0c07]\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n        <div class=\"flex h-[58px] items-center justify-between px-7\" data-kid=\"1-1-1\" data-name=\"header top row\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-1\" data-name=\"logo and mode indicator container\">\n                <div class=\"flex h-8 w-8 items-center justify-center border border-[#deff00] text-[#deff00]\" data-kid=\"1-1-1-1-1\" data-name=\"hex icon container\">\n                    <i class=\"ti ti-hexagon-letter-a text-xl\" data-kid=\"1-1-1-1-1-1\" data-name=\"hexagon letter A icon\">\n                    </i>\n                </div>\n                <div class=\"text-[15px] font-bold tracking-[.04em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    AUREL\n                    <span class=\"font-normal text-[#7f866c]\" data-kid=\"1-1-1-1-2-1\" data-name=\"separator slash\">\n                        /\n                    </span>\n                    OPERATIONS\n                </div>\n                <div class=\"ml-5 h-5 border-l border-[#343923]\" data-kid=\"1-1-1-1-3\" data-name=\"vertical divider line\">\n                </div>\n                <div class=\"flex items-center gap-2 font-['Space_Mono'] text-[12px]\" data-kid=\"1-1-1-1-4\" data-name=\"trading mode status group\">\n                    <span class=\"h-2 w-2 bg-[#deff00]\" data-kid=\"1-1-1-1-4-1\" data-name=\"mode active dot\">\n                    </span>\n                    <span class=\"text-[#a9af91]\" data-kid=\"1-1-1-1-4-2\" data-name=\"mode label text\">\n                        TRADING_MODE\n                    </span>\n                    <span class=\"bg-[#deff00] px-2 py-0.5 font-bold text-black\" data-kid=\"1-1-1-1-4-3\" data-name=\"demo mode badge\">\n                        DEMO\n                    </span>\n                    <span class=\"text-[#899078]\" data-kid=\"1-1-1-1-4-4\" data-name=\"default configuration label\">\n                        DEFAULT\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3 font-['Space_Mono'] text-[11px] text-[#969d81]\" data-kid=\"1-1-1-2\" data-name=\"state readers header section\">\n                <span class=\"flex items-center gap-2 border border-[#343923] px-3 py-2\" data-kid=\"1-1-1-2-1\" data-name=\"state readers status indicator\">\n                    <i class=\"ti ti-database text-sm\" data-kid=\"1-1-1-2-1-1\" data-name=\"database icon\">\n                    </i>\n                    STATE READERS\n                    <b class=\"font-normal text-[#e6e9d5]\" data-kid=\"1-1-1-2-1-2\" data-name=\"availability status text\">\n                        UNAVAILABLE\n                    </b>\n                </span>\n                <span class=\"border border-[#343923] px-3 py-2\" data-kid=\"1-1-1-2-2\" data-name=\"UTC time indicator\">\n                    UTC\n                </span>\n            </div>\n        </div>\n        <nav aria-label=\"Application screens\" class=\"flex items-stretch gap-1 border-t border-[#25291b] px-7\" data-kid=\"1-1-2\" data-name=\"main navigation tabs\">\n            <a class=\"border-b-2 border-[#deff00] px-4 py-3 text-[14px] font-semibold text-[#deff00]\" data-kid=\"1-1-2-1\" data-name=\"operations navigation link\">\n                Operations\n            </a>\n            <a class=\"border-b-2 border-transparent px-4 py-3 text-[14px] text-[#9da38a]\" data-kid=\"1-1-2-2\" data-name=\"training navigation link\">\n                Training\n            </a>\n            <a class=\"border-b-2 border-transparent px-4 py-3 text-[14px] text-[#9da38a]\" data-kid=\"1-1-2-3\" data-name=\"prepare run navigation link\">\n                Prepare Run\n            </a>\n            <a class=\"border-b-2 border-transparent px-4 py-3 text-[14px] text-[#9da38a]\" data-kid=\"1-1-2-4\" data-name=\"models evaluation navigation link\">\n                Models / Evaluation\n            </a>\n            <a class=\"border-b-2 border-transparent px-4 py-3 text-[14px] text-[#9da38a]\" data-kid=\"1-1-2-5\" data-name=\"risk settings navigation link\">\n                Risk / Settings\n            </a>\n            <div class=\"ml-auto flex items-center gap-2 self-center font-['Space_Mono'] text-[11px] text-[#969d81]\" data-kid=\"1-1-2-6\" data-name=\"live control status indicator\">\n                <i class=\"ti ti-lock text-base\" data-kid=\"1-1-2-6-1\" data-name=\"lock icon\">\n                </i>\n                LIVE CONTROL GATED\n            </div>\n        </nav>\n    </header>\n    <main class=\"space-y-4 px-7 py-5\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-label=\"Trading permission interlock\" class=\"grid grid-cols-[1.12fr_.88fr] border border-[#454022]\" data-kid=\"1-2-1\" data-name=\"trading permission interlock section\">\n            <div class=\"relative flex min-h-[196px] flex-col justify-between overflow-hidden bg-[#a00000] p-6 text-[#efffac]\" data-kid=\"1-2-1-1\" data-name=\"interlock alert container\" style=\"clip-path:polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%)\">\n                <div class=\"absolute right-5 top-4 font-['Space_Mono'] text-[10px] text-[#efb5a0]\" data-kid=\"1-2-1-1-1\" data-name=\"permission interlock label\">\n                    PERMISSION INTERLOCK\n                </div>\n                <div data-kid=\"1-2-1-1-2\" data-name=\"alert details\">\n                    <div class=\"mb-3 flex items-center gap-2 text-[13px] font-semibold\" data-kid=\"1-2-1-1-2-1\" data-name=\"authorization denied status group\">\n                        <i class=\"ti ti-lock text-xl\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"lock icon\">\n                        </i>\n                        <span data-kid=\"1-2-1-1-2-1-2\" data-name=\"denied status text\">\n                            MODEL AUTHORIZATION DENIED\n                        </span>\n                    </div>\n                    <h1 class=\"font-['Alfa_Slab_One'] text-[38px] leading-[1.08] tracking-[.005em]\" data-kid=\"1-2-1-1-2-2\" data-name=\"alert headline\">\n                        MODEL-DRIVEN\n                        <br data-kid=\"1-2-1-1-2-2-1\" data-name=\"headline line break\"/>\n                        TRADING BLOCKED\n                    </h1>\n                </div>\n                <p class=\"mt-3 max-w-[590px] text-[14px] leading-5 text-[#fff1e4]\" data-kid=\"1-2-1-1-3\" data-name=\"alert description text\">\n                    Live model-driven trading cannot start. No production model has passed the promotion gate.\n                </p>\n            </div>\n            <div class=\"bg-[#0b0d07] px-6 py-5\" data-kid=\"1-2-1-2\" data-name=\"interlock diagnostic table\">\n                <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-1-2-1\" data-name=\"diagnostic header\">\n                    <h2 class=\"text-[16px] font-semibold\" data-kid=\"1-2-1-2-1-1\" data-name=\"diagnostic section title\">\n                        Why the gate is closed\n                    </h2>\n                    <span class=\"font-['Space_Mono'] text-[11px] text-[#9da38a]\" data-kid=\"1-2-1-2-1-2\" data-name=\"require promoted model diagnostic value\">\n                        REQUIRE_PROMOTED_MODEL · TRUE\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-[1fr_auto] items-center border-t border-[#292d1d] py-[9px] text-[14px]\" data-kid=\"1-2-1-2-2\" data-name=\"diagnostic row 1\">\n                    <span data-kid=\"1-2-1-2-2-1\" data-name=\"diagnostic row 1 label\">\n                        Trading mode\n                    </span>\n                    <span class=\"font-['Space_Mono'] text-[12px] font-bold text-[#deff00]\" data-kid=\"1-2-1-2-2-2\" data-name=\"diagnostic row 1 value\">\n                        DEMO DEFAULT\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-[1fr_auto] items-center border-t border-[#292d1d] py-[9px] text-[14px]\" data-kid=\"1-2-1-2-3\" data-name=\"diagnostic row 2\">\n                    <span data-kid=\"1-2-1-2-3-1\" data-name=\"diagnostic row 2 label\">\n                        Production manifest\n                    </span>\n                    <span class=\"font-['Space_Mono'] text-[12px] text-[#e9ebdc]\" data-kid=\"1-2-1-2-3-2\" data-name=\"diagnostic row 2 value\">\n                        MISSING\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-[1fr_auto] items-center border-t border-[#292d1d] py-[9px] text-[14px]\" data-kid=\"1-2-1-2-4\" data-name=\"diagnostic row 3\">\n                    <span data-kid=\"1-2-1-2-4-1\" data-name=\"diagnostic row 3 label\">\n                        Inspected evaluations\n                    </span>\n                    <span class=\"font-['Space_Mono'] text-[11px] text-[#e9ebdc]\" data-kid=\"1-2-1-2-4-2\" data-name=\"diagnostic row 3 value\">\n                        3 / 3 · passed=false\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-[1fr_auto] items-center border-y border-[#292d1d] py-[9px] text-[14px]\" data-kid=\"1-2-1-2-5\" data-name=\"diagnostic row 4\">\n                    <span data-kid=\"1-2-1-2-5-1\" data-name=\"diagnostic row 4 label\">\n                        Live control\n                    </span>\n                    <span class=\"font-['Space_Mono'] text-[12px] font-bold text-[#ff4136]\" data-kid=\"1-2-1-2-5-2\" data-name=\"diagnostic row 4 value\">\n                        GATED\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Vela historical chart\" class=\"overflow-hidden border border-[#363d1b] bg-[#101400]\" data-kid=\"1-2-2\" data-name=\"vela historical chart section\" style=\"clip-path:polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%)\">\n            <div class=\"flex h-[49px] items-center justify-between border-b border-[#303719] px-4\" data-kid=\"1-2-2-1\" data-name=\"chart toolbar\">\n                <div class=\"flex h-full items-center gap-0\" data-kid=\"1-2-2-1-1\" data-name=\"chart configuration tools\">\n                    <button class=\"flex h-full items-center gap-2 border-r border-[#343923] pr-4\" data-kid=\"1-2-2-1-1-1\" data-name=\"symbol selector button\">\n                        <span class=\"font-['Alfa_Slab_One'] text-[22px] text-[#deff00]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"symbol name\">\n                            XAUUSD\n                        </span>\n                        <i class=\"ti ti-chevron-down text-sm text-[#aab18d]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"chevron icon\">\n                        </i>\n                    </button>\n                    <button class=\"ml-3 flex items-center gap-1 border border-[#535b2a] bg-[#1a1e0d] px-3 py-1.5 font-['Space_Mono'] text-[12px] text-[#deff00]\" data-kid=\"1-2-2-1-1-2\" data-name=\"timeframe selector button\">\n                        1h\n                        <i class=\"ti ti-chevron-down\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"chevron icon\">\n                        </i>\n                    </button>\n                    <button class=\"ml-3 flex items-center gap-2 border-r border-[#343923] px-3 py-1.5 text-[13px]\" data-kid=\"1-2-2-1-1-3\" data-name=\"chart type menu button\">\n                        <i class=\"ti ti-chart-candle text-base\" data-kid=\"1-2-2-1-1-3-1\" data-name=\"candle chart icon\">\n                        </i>\n                        Candles\n                        <i class=\"ti ti-chevron-down text-xs text-[#90977a]\" data-kid=\"1-2-2-1-1-3-2\" data-name=\"chevron icon\">\n                        </i>\n                    </button>\n                    <button class=\"flex items-center gap-2 border-r border-[#343923] px-3 py-1.5 text-[13px]\" data-kid=\"1-2-2-1-1-4\" data-name=\"indicators menu button\">\n                        <i class=\"ti ti-chart-dots-3 text-base\" data-kid=\"1-2-2-1-1-4-1\" data-name=\"chart dots icon\">\n                        </i>\n                        Indicators\n                    </button>\n                    <button class=\"flex items-center gap-2 px-3 py-1.5 text-[13px] text-[#aeb49a]\" data-kid=\"1-2-2-1-1-5\" data-name=\"layout settings menu button\">\n                        <i class=\"ti ti-layout-grid text-base\" data-kid=\"1-2-2-1-1-5-1\" data-name=\"grid icon\">\n                        </i>\n                        Layout\n                        <span class=\"font-['Space_Mono'] text-[11px]\" data-kid=\"1-2-2-1-1-5-2\" data-name=\"layout count text\">\n                            1 chart\n                        </span>\n                        <i class=\"ti ti-chevron-down text-xs\" data-kid=\"1-2-2-1-1-5-3\" data-name=\"chevron icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"flex items-center gap-1 text-[#aeb49a]\" data-kid=\"1-2-2-1-2\" data-name=\"chart management tools\">\n                    <button aria-label=\"Undo\" class=\"border-r border-[#343923] px-3 py-1.5\" data-kid=\"1-2-2-1-2-1\" data-name=\"undo button\">\n                        <i class=\"ti ti-arrow-back-up text-lg\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"undo icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Redo\" class=\"px-3 py-1.5\" data-kid=\"1-2-2-1-2-2\" data-name=\"redo button\">\n                        <i class=\"ti ti-arrow-forward-up text-lg\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"redo icon\">\n                        </i>\n                    </button>\n                    <span class=\"mx-2 h-5 border-l border-[#343923]\" data-kid=\"1-2-2-1-2-3\" data-name=\"vertical divider\">\n                    </span>\n                    <button class=\"flex items-center gap-2 border border-[#343923] px-3 py-1.5 text-[12px]\" data-kid=\"1-2-2-1-2-4\" data-name=\"chart settings button\">\n                        <i class=\"ti ti-settings-2 text-base\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"settings icon\">\n                        </i>\n                        Settings\n                    </button>\n                    <button class=\"ml-2 flex items-center gap-2 border border-[#343923] px-3 py-1.5 text-[12px]\" data-kid=\"1-2-2-1-2-5\" data-name=\"object tree button\">\n                        <i class=\"ti ti-list-tree text-base\" data-kid=\"1-2-2-1-2-5-1\" data-name=\"list tree icon\">\n                        </i>\n                        Object tree\n                    </button>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-[42px_minmax(0,1fr)_244px]\" data-kid=\"1-2-2-2\" data-name=\"chart workspace container\">\n                <aside aria-label=\"Drawing toolbar\" class=\"border-r border-[#303719] bg-[#0b0d08] py-2 text-center text-[#abb293]\" data-kid=\"1-2-2-2-1\" data-name=\"drawing toolbar\">\n                    <div class=\"border-b border-[#292d1d] pb-2 text-base text-[#deff00]\" data-kid=\"1-2-2-2-1-1\" data-name=\"select tool\">\n                        <i class=\"ti ti-pointer\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"pointer icon\">\n                        </i>\n                    </div>\n                    <div class=\"space-y-[13px] pt-3 text-[17px]\" data-kid=\"1-2-2-2-1-2\" data-name=\"drawing tools group\">\n                        <div data-kid=\"1-2-2-2-1-2-1\" data-name=\"trend line tool\">\n                            <i class=\"ti ti-trending-up\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"trending up icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-2-2-2-1-2-2\" data-name=\"line tool\">\n                            <i class=\"ti ti-line\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"line icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-2-2-2-1-2-3\" data-name=\"horizontal arrows tool\">\n                            <i class=\"ti ti-arrows-horizontal\" data-kid=\"1-2-2-2-1-2-3-1\" data-name=\"arrows icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-2-2-2-1-2-4\" data-name=\"pencil tool\">\n                            <i class=\"ti ti-pencil\" data-kid=\"1-2-2-2-1-2-4-1\" data-name=\"pencil icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-2-2-2-1-2-5\" data-name=\"rectangle tool\">\n                            <i class=\"ti ti-rectangle\" data-kid=\"1-2-2-2-1-2-5-1\" data-name=\"rectangle icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-2-2-2-1-2-6\" data-name=\"text tool\">\n                            <i class=\"ti ti-text-size\" data-kid=\"1-2-2-2-1-2-6-1\" data-name=\"text size icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-2-2-2-1-2-7\" data-name=\"ruler tool\">\n                            <i class=\"ti ti-ruler-2\" data-kid=\"1-2-2-2-1-2-7-1\" data-name=\"ruler icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-2-2-2-1-2-8\" data-name=\"eraser tool\">\n                            <i class=\"ti ti-eraser\" data-kid=\"1-2-2-2-1-2-8-1\" data-name=\"eraser icon\">\n                            </i>\n                        </div>\n                    </div>\n                </aside>\n                <div class=\"min-w-0 bg-[#070906]\" data-kid=\"1-2-2-2-2\" data-name=\"chart view container\">\n                    <div class=\"flex h-[36px] items-center justify-between px-4 font-['Space_Mono'] text-[10px]\" data-kid=\"1-2-2-2-2-1\" data-name=\"chart header strip\">\n                        <div class=\"flex items-center gap-2 text-[#b9c09e]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"chart status metadata\">\n                            <span class=\"h-2 w-2 bg-[#deff00]\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"active status indicator\">\n                            </span>\n                            XAUUSD\n                            <span class=\"text-[#70775e]\" data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"separator\">\n                                ·\n                            </span>\n                            HISTORICAL\n                            <span class=\"text-[#70775e]\" data-kid=\"1-2-2-2-2-1-1-3\" data-name=\"separator\">\n                                ·\n                            </span>\n                            1h\n                            <span class=\"text-[#70775e]\" data-kid=\"1-2-2-2-2-1-1-4\" data-name=\"separator\">\n                                ·\n                            </span>\n                            UTC\n                        </div>\n                        <div class=\"text-[#82896e]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"last bar data label\">\n                            LAST BAR  O 4313.305  H 4318.719  L 4306.835  C 4318.679  V 0.98619\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-[minmax(0,1fr)_66px]\" data-kid=\"1-2-2-2-2-2\" data-name=\"chart area grid\">\n                        <div class=\"min-w-0\" data-kid=\"1-2-2-2-2-2