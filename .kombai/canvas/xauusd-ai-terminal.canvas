      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@500;600;700&family=Josefin+Slab:wght@500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css');\nform label:focus-within > span { border-color: #C05746; }\n@media (min-width: 64rem) {\n  section[aria-labelledby=\"runtime-heading\"] dl > div:nth-last-child(-n+3) { border-bottom-width: 0; }\n}\n</style>\n<div class=\"min-h-screen bg-[#1E000E] text-[#D6E6CA] [font-family:'Josefin_Slab',serif]\">\n  <header class=\"border-b border-[#67484D] bg-[#1E000E]\">\n    <div class=\"mx-auto flex max-w-[1360px] flex-wrap items-center justify-between gap-x-8 gap-y-4 px-8 py-5\">\n      <div class=\"flex shrink-0 items-center gap-3\">\n        <span class=\"text-[25px] font-semibold tracking-[-0.04em] [font-family:'Bodoni_Moda',serif]\">XAUUSD</span>\n        <span class=\"border-l border-[#67484D] pl-3 text-sm text-[#ADC698]\">AI terminal</span>\n      </div>\n      <nav aria-label=\"Primary navigation\" class=\"flex flex-wrap items-center gap-x-7 gap-y-2 text-[15px] font-semibold\">\n        <span class=\"text-[#ADC698]\">Operations</span>\n        <span class=\"text-[#ADC698]\">Training</span>\n        <span class=\"text-[#ADC698]\">Prepare Run</span>\n        <span class=\"text-[#ADC698]\">Models / Evaluation</span>\n        <span aria-current=\"page\" class=\"border-b-2 border-[#C05746] pb-2 text-[#EBA294]\">Risk / Settings</span>\n      </nav>\n      <div class=\"flex items-center gap-2 text-sm\">\n        <span class=\"h-2 w-2 rounded-full bg-[#C05746]\"></span>\n        <span class=\"font-mono text-[12px] text-[#EBA294]\">CURRENT LIVE STATE UNAVAILABLE</span>\n      </div>\n    </div>\n  </header>\n\n  <main id=\"risk-settings\" class=\"mx-auto max-w-[1360px] px-8 pb-14 pt-8\">\n    <div class=\"flex flex-wrap items-end justify-between gap-6 border-b border-[#67484D] pb-7\">\n      <div>\n        <h1 class=\"text-4xl font-semibold tracking-[-0.025em] [font-family:'Bodoni_Moda',serif]\">Risk / Settings</h1>\n        <p class=\"mt-3 max-w-3xl text-base leading-7 text-[#ADC698]\">Review the runtime limits, then stage a validated configuration for the next process start.</p>\n      </div>\n      <div class=\"flex items-center gap-3 pb-1 text-sm\">\n        <i class=\"bx bx-history text-[22px] text-[#EBA294]\"></i>\n        <span class=\"text-[#ADC698]\">Production context</span>\n        <span class=\"font-mono text-[12px] text-[#EBA294]\">MANIFEST MISSING</span>\n      </div>\n    </div>\n\n    <section aria-labelledby=\"runtime-heading\" class=\"mt-7 grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_350px]\">\n      <div class=\"rounded-2xl bg-[#2B1420] p-6\">\n        <div class=\"flex flex-wrap items-start justify-between gap-5 border-b border-[#67484D] pb-5\">\n          <div>\n            <h2 id=\"runtime-heading\" class=\"text-[22px] font-semibold\">Resolved runtime state</h2>\n            <p class=\"mt-2 text-sm leading-6 text-[#ADC698]\">Unavailable — no current reader is connected. Every resolved value below is shown as —.</p>\n          </div>\n          <span class=\"border border-[#C05746]/60 px-3 py-1.5 font-mono text-[12px] text-[#EBA294]\">NO CURRENT READER</span>\n        </div>\n        <dl class=\"mt-5 grid grid-cols-1 gap-x-8 sm:grid-cols-2 lg:grid-cols-3\">\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">MAX_DAILY_LOSS</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">MAX_DRAWDOWN</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">MAX_CONSECUTIVE_LOSSES</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">MAX_RISK_PER_TRADE</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">MAX_POSITION</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">MAX_TRADES_PER_DAY</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">MIN_TRADE_INTERVAL_SEC</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">VOL_THRESHOLD</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">MAX_SPREAD</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">MARKET_HOURS_ONLY</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">CORRELATION_GUARD_ENABLED</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">CORRELATION_ASSET</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">CORRELATION_BLOCK_LONG_ON_UP</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">MIN_CONFIDENCE</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">MIN_ENSEMBLE_AGREEMENT</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">USE_KELLY</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">KELLY_FRACTION</dt><dd class=\"font-mono text-sm\">—</dd></div>\n          <div class=\"flex min-h-10 items-center justify-between gap-3 border-b border-[#67484D]/70 py-2\"><dt class=\"font-mono text-[12px] text-[#ADC698]\">KELLY_MIN_TRADES</dt><dd class=\"font-mono text-sm\">—</dd></div>\n        </dl>\n      </div>\n\n      <aside class=\"flex flex-col rounded-2xl bg-[#3F2A2B] p-6\" aria-label=\"Production and kill-switch status\">\n        <div class=\"flex items-center gap-3 text-[#EBA294]\"><i class=\"bx bx-lock-alt text-[24px]\"></i><h2 class=\"text-xl font-semibold\">Production model gate</h2></div>\n        <p class=\"mt-5 text-[28px] font-semibold tracking-wide\">BLOCKED</p>\n        <p class=\"mt-2 text-[15px] leading-6\">No model has passed the promotion gate. Model-driven live trades are blocked.</p>\n        <div class=\"mt-4 border-t border-[#82676A] pt-4\">\n          <p class=\"font-mono text-[12px] text-[#EBA294]\">REQUIRE_PROMOTED_MODEL · true</p>\n          <p class=\"mt-2 text-sm leading-5 text-[#ADC698]\">Production manifest missing.</p>\n        </div>\n        <div class=\"mt-5 border-t border-[#82676A] pt-4\">\n          <div class=\"flex items-center justify-between gap-3\"><h3 class=\"text-base font-semibold\">Kill-switch file</h3><span class=\"font-mono text-[12px] text-[#EBA294]\">ABSENT IN REPORT</span></div>\n          <p class=\"mt-2 text-sm leading-5 text-[#ADC698]\">A file sentinel named <code class=\"font-mono text-[#D6E6CA]\">KILL_SWITCH</code>. Current file presence is unavailable without a reader.</p>\n        </div>\n      </aside>\n    </section>\n\n    <section aria-labelledby=\"proposed-heading\" class=\"mt-8 rounded-2xl bg-[#2B1420] p-6\">\n      <div class=\"flex flex-wrap items-end justify-between gap-4 border-b border-[#67484D] pb-5\">\n        <div>\n          <h2 id=\"proposed-heading\" class=\"text-[24px] font-semibold\">Proposed changes</h2>\n          <p class=\"mt-2 text-sm text-[#ADC698]\">Blank · not yet saved. Enter only the values you intend to change.</p>\n        </div>\n        <span class=\"font-mono text-[12px] text-[#ADC698]\">18 WHITELISTED SETTINGS</span>\n      </div>\n\n      <form class=\"mt-5\" aria-label=\"Proposed risk and behavior settings\">\n        <fieldset class=\"border-0 p-0\">\n          <legend class=\"mb-4 text-lg font-semibold\">Risk limits</legend>\n          <div class=\"grid grid-cols-1 gap-x-6 gap-y-4 md:grid-cols-2 xl:grid-cols-3\">\n            <label class=\"block text-[14px] font-semibold\">MAX_DAILY_LOSS<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed MAX_DAILY_LOSS\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm text-[#D6E6CA] outline-hidden\" inputmode=\"decimal\" type=\"number\" step=\"any\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">ratio</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">MAX_DRAWDOWN<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed MAX_DRAWDOWN\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" inputmode=\"decimal\" type=\"number\" step=\"any\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">ratio</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">MAX_CONSECUTIVE_LOSSES<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed MAX_CONSECUTIVE_LOSSES\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" inputmode=\"numeric\" type=\"number\" step=\"1\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">count</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">MAX_RISK_PER_TRADE<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed MAX_RISK_PER_TRADE\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" inputmode=\"decimal\" type=\"number\" step=\"any\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">ratio</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">MAX_POSITION<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed MAX_POSITION\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" inputmode=\"decimal\" type=\"number\" step=\"any\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">lots</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">MAX_TRADES_PER_DAY<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed MAX_TRADES_PER_DAY\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" inputmode=\"numeric\" type=\"number\" step=\"1\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">count</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">MIN_TRADE_INTERVAL_SEC<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed MIN_TRADE_INTERVAL_SEC\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" inputmode=\"numeric\" type=\"number\" step=\"1\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">seconds</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">VOL_THRESHOLD<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed VOL_THRESHOLD\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" inputmode=\"decimal\" type=\"number\" step=\"any\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">config value</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">MAX_SPREAD<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed MAX_SPREAD\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" inputmode=\"decimal\" type=\"number\" step=\"any\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">config value</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">MARKET_HOURS_ONLY<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><select aria-label=\"Proposed MARKET_HOURS_ONLY\" class=\"h-11 min-w-0 flex-1 bg-transparent pr-8 font-mono text-sm text-[#ADC698] outline-hidden\"><option value=\"\" selected disabled>Choose value…</option><option value=\"true\">true</option><option value=\"false\">false</option></select></span></label>\n            <label class=\"block text-[14px] font-semibold\">CORRELATION_GUARD_ENABLED<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><select aria-label=\"Proposed CORRELATION_GUARD_ENABLED\" class=\"h-11 min-w-0 flex-1 bg-transparent pr-8 font-mono text-sm text-[#ADC698] outline-hidden\"><option value=\"\" selected disabled>Choose value…</option><option value=\"true\">true</option><option value=\"false\">false</option></select></span></label>\n            <label class=\"block text-[14px] font-semibold\">CORRELATION_ASSET<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed CORRELATION_ASSET\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" type=\"text\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">asset</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">CORRELATION_BLOCK_LONG_ON_UP<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><select aria-label=\"Proposed CORRELATION_BLOCK_LONG_ON_UP\" class=\"h-11 min-w-0 flex-1 bg-transparent pr-8 font-mono text-sm text-[#ADC698] outline-hidden\"><option value=\"\" selected disabled>Choose value…</option><option value=\"true\">true</option><option value=\"false\">false</option></select></span></label>\n          </div>\n        </fieldset>\n\n        <fieldset class=\"mt-7 border-0 border-t border-[#67484D] p-0 pt-5\">\n          <legend class=\"mb-4 text-lg font-semibold\">Trading behavior</legend>\n          <div class=\"grid grid-cols-1 gap-x-6 gap-y-4 md:grid-cols-2 xl:grid-cols-3\">\n            <label class=\"block text-[14px] font-semibold\">MIN_CONFIDENCE<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed MIN_CONFIDENCE\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" inputmode=\"decimal\" type=\"number\" step=\"any\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">ratio</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">MIN_ENSEMBLE_AGREEMENT<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed MIN_ENSEMBLE_AGREEMENT\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" inputmode=\"decimal\" type=\"number\" step=\"any\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">ratio</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">USE_KELLY<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><select aria-label=\"Proposed USE_KELLY\" class=\"h-11 min-w-0 flex-1 bg-transparent pr-8 font-mono text-sm text-[#ADC698] outline-hidden\"><option value=\"\" selected disabled>Choose value…</option><option value=\"true\">true</option><option value=\"false\">false</option></select></span></label>\n            <label class=\"block text-[14px] font-semibold\">KELLY_FRACTION<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed KELLY_FRACTION\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" inputmode=\"decimal\" type=\"number\" step=\"any\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">ratio</span></span></label>\n            <label class=\"block text-[14px] font-semibold\">KELLY_MIN_TRADES<span class=\"mt-2 flex items-center border-b border-[#806268] bg-[#24101B] px-3\"><input aria-label=\"Proposed KELLY_MIN_TRADES\" class=\"h-11 min-w-0 flex-1 bg-transparent font-mono text-sm outline-hidden\" inputmode=\"numeric\" type=\"number\" step=\"1\"><span class=\"pl-3 font-mono text-[12px] text-[#ADC698]\">count</span></span></label>\n          </div>\n        </fieldset>\n\n        <div class=\"mt-7 grid gap-4 border-t border-[#67484D] pt-5 lg:grid-cols-[1fr_auto] lg:items-center\">\n          <div>\n            <h3 class=\"text-base font-semibold\">Validation and write sequence</h3>\n            <p class=\"mt-2 text-sm leading-6 text-[#ADC698]\">The merged <code class=\"font-mono text-[#D6E6CA]\">.env</code> is parsed and checked with <code class=\"font-mono text-[#D6E6CA]\">core.config.load_config()</code> before any write. A valid file is written atomically (temporary file, then rename); the new settings apply on the next process start.</p>\n            <p class=\"mt-2 font-mono text-[12px] text-[#EBA294]\">No proposed values · no write has occurred</p>\n          </div>\n          <button type=\"button\" disabled class=\"cursor-not-allowed border border-[#806268] bg-[#3F2A2B] px-5 py-3 text-sm font-semibold text-[#D6E6CA]/80\">Save limits for next start</button>\n        </div>\n      </form>\n    </section>\n\n    <section aria-labelledby=\"reasons-heading\" class=\"mt-8 rounded-2xl bg-[#24101B] p-6\">\n      <div class=\"flex flex-wrap items-baseline justify-between gap-4 border-b border-[#67484D] pb-4\">\n        <h2 id=\"reasons-heading\" class=\"text-[23px] font-semibold\">Risk reason taxonomy</h2>\n        <p class=\"font-mono text-[12px] text-[#EBA294]\">Supported reasons · no live counts loaded</p>\n      </div>\n      <p class=\"mt-4 text-sm leading-6 text-[#ADC698]\">Current live state unavailable. These are supported reason labels; no live counts or events are loaded.</p>\n      <ul class=\"mt-4 grid grid-cols-1 gap-x-8 lg:grid-cols-3\">\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">APPROVED</li>\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">CIRCUIT_BREAKER: daily loss …</li>\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">HALTED until …</li>\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">MAX_DRAWDOWN: …</li>\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">POSITION_TOO_LARGE: …</li>\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">TOO_MANY_LOSSES: …</li>\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">HIGH_VOLATILITY: …</li>\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">CORRELATION_GUARD: …</li>\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">EVENT_RISK: …</li>\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">MAX_TRADES: …</li>\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">COOLDOWN: …</li>\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">SPREAD_TOO_WIDE: …</li>\n        <li class=\"border-b border-[#67484D] py-3 font-mono text-[13px]\">MARKET_CLOSED: …</li>\n      </ul>\n    </section>\n\n    <section aria-label=\"Frontend safety invariant\" class=\"mt-6 border border-[#C05746]/60 bg-[#3F2A2B] px-6 py-5\">\n      <div class=\"flex flex-wrap items-start gap-4\">\n        <i class=\"bx bx-lock-alt text-[24px] text-[#EBA294]\"></i>\n        <div>\n          <h2 class=\"text-lg font-semibold\">Security invariant</h2>\n          <p class=\"mt-2 text-[15px] leading-6\">The frontend NEVER calls broker or order functions directly. This screen can stage validated configuration only; it has no broker client, order path, or position-exit action.</p>\n        </div>\n      </div>\n    </section>\n  </main>\n</div>",
