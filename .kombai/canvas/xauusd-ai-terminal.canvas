      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Saira:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-full bg-[#050600] font-[Saira] text-[#e8f2bd]\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"flex min-h-full\" data-kid=\"1-1\" data-name=\"sidebar and main content layout\">\n        <aside class=\"w-[228px] shrink-0 border-r border-[#30370a] bg-[#080900] px-5 py-6\" data-kid=\"1-1-1\" data-name=\"sidebar container\">\n            <div class=\"mb-11 flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"branding container\">\n                <div class=\"grid h-10 w-10 place-items-center bg-[#deff00] font-[Space_Mono] text-sm font-bold text-black\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo initial box\">\n                    Au\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"brand name and subtitle container\">\n                    <div class=\"text-[16px] font-bold tracking-[0.02em] text-white\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand title text\">\n                        XAUUSD\n                    </div>\n                    <div class=\"font-[Space_Mono] text-[10px] text-[#a0ab72]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                        AI TERMINAL\n                    </div>\n                </div>\n            </div>\n            <nav aria-label=\"Main navigation\" class=\"space-y-1\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n                <button class=\"flex w-full items-center gap-3 px-3 py-3 text-left text-[14px] text-[#a7b184]\" data-kid=\"1-1-1-2-1\" data-name=\"navigation operations button\" type=\"button\">\n                    <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"operations label\">\n                        Operations\n                    </span>\n                </button>\n                <button aria-current=\"page\" class=\"flex w-full items-center gap-3 border border-[#deff00] bg-[#deff00] px-3 py-3 text-left text-[14px] font-semibold text-black\" data-kid=\"1-1-1-2-2\" data-name=\"navigation training button\" type=\"button\">\n                    <i class=\"ti ti-activity text-[18px]\" data-kid=\"1-1-1-2-2-1\" data-name=\"activity icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-2-2\" data-name=\"training label\">\n                        Training\n                    </span>\n                </button>\n                <button class=\"flex w-full items-center gap-3 px-3 py-3 text-left text-[14px] text-[#a7b184]\" data-kid=\"1-1-1-2-3\" data-name=\"navigation prepare run button\" type=\"button\">\n                    <i class=\"ti ti-adjustments-horizontal text-[18px]\" data-kid=\"1-1-1-2-3-1\" data-name=\"adjustments icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-3-2\" data-name=\"prepare run label\">\n                        Prepare Run\n                    </span>\n                </button>\n                <button class=\"flex w-full items-center gap-3 px-3 py-3 text-left text-[14px] text-[#a7b184]\" data-kid=\"1-1-1-2-4\" data-name=\"navigation models evaluation button\" type=\"button\">\n                    <i class=\"ti ti-chart-bar text-[18px]\" data-kid=\"1-1-1-2-4-1\" data-name=\"chart bar icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-4-2\" data-name=\"models evaluation label\">\n                        Models / Evaluation\n                    </span>\n                </button>\n                <button class=\"flex w-full items-center gap-3 px-3 py-3 text-left text-[14px] text-[#a7b184]\" data-kid=\"1-1-1-2-5\" data-name=\"navigation risk settings button\" type=\"button\">\n                    <i class=\"ti ti-settings text-[18px]\" data-kid=\"1-1-1-2-5-1\" data-name=\"settings icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-5-2\" data-name=\"risk settings label\">\n                        Risk / Settings\n                    </span>\n                </button>\n            </nav>\n            <div class=\"mt-12 border-t border-[#30370a] pt-5\" data-kid=\"1-1-1-3\" data-name=\"host status container\">\n                <div class=\"flex items-center gap-2 text-[13px] font-medium text-[#dce8ae]\" data-kid=\"1-1-1-3-1\" data-name=\"host supervisor status line\">\n                    <span class=\"h-2 w-2 bg-[#87964a]\" data-kid=\"1-1-1-3-1-1\" data-name=\"host status indicator dot\">\n                    </span>\n                    Host supervisor\n                </div>\n                <div class=\"mt-2 pl-4 font-[Space_Mono] text-[11px] text-[#879064]\" data-kid=\"1-1-1-3-2\" data-name=\"host status text\">\n                    Unavailable\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 px-8 py-7\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <header class=\"mb-6 flex items-end justify-between border-b border-[#30370a] pb-5\" data-kid=\"1-1-2-1\" data-name=\"content header\">\n                <div data-kid=\"1-1-2-1-1\" data-name=\"page title and description\">\n                    <h1 class=\"text-[34px] font-semibold leading-none tracking-[-0.03em] text-white\" data-kid=\"1-1-2-1-1-1\" data-name=\"page title heading\">\n                        Training\n                    </h1>\n                    <p class=\"mt-2 text-[14px] text-[#a5b17a]\" data-kid=\"1-1-2-1-1-2\" data-name=\"page status subtitle\">\n                        Supervisor snapshot unavailable\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-2 border border-[#414925] px-3 py-2 font-[Space_Mono] text-[11px] text-[#d7e3a5]\" data-kid=\"1-1-2-1-2\" data-name=\"job state indicator\">\n                    <i class=\"ti ti-cloud-off text-[15px]\" data-kid=\"1-1-2-1-2-1\" data-name=\"cloud off icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-1-2-2\" data-name=\"job state text\">\n                        JOB STATE · UNAVAILABLE\n                    </span>\n                </div>\n            </header>\n            <section aria-label=\"Supervisor snapshot and process controls\" class=\"mb-5 grid grid-cols-[minmax(0,1.55fr)_minmax(290px,0.85fr)] gap-4\" data-kid=\"1-1-2-2\" data-name=\"supervisor control panel section\">\n                <div class=\"border border-[#465018] bg-[#101400] p-5\" data-kid=\"1-1-2-2-1\" data-name=\"job supervisor section\">\n                    <div class=\"flex items-center justify-between border-b border-[#333b12] pb-3\" data-kid=\"1-1-2-2-1-1\" data-name=\"job supervisor header\">\n                        <h2 class=\"text-[17px] font-semibold text-white\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"job supervisor title\">\n                            Job supervisor snapshot\n                        </h2>\n                        <span class=\"border border-[#626a42] px-2 py-1 font-[Space_Mono] text-[10px] text-[#d0d9a6]\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"job supervisor availability label\">\n                            UNAVAILABLE\n                        </span>\n                    </div>\n                    <div class=\"flex min-h-[112px] items-center gap-4 border-b border-[#333b12] py-5\" data-kid=\"1-1-2-2-1-2\" data-name=\"job warning notice container\">\n                        <i class=\"ti ti-database-off text-[25px] text-[#b6c383]\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"database off icon\">\n                        </i>\n                        <div data-kid=\"1-1-2-2-1-2-2\" data-name=\"job status warning details\">\n                            <p class=\"text-[17px] font-semibold text-[#eef5d1]\" data-kid=\"1-1-2-2-1-2-2-1\" data-name=\"job status warning title\">\n                                No supervisor snapshot can be retrieved.\n                            </p>\n                            <p class=\"mt-1 max-w-[620px] text-[13px] leading-5 text-[#a6b17b]\" data-kid=\"1-1-2-2-1-2-2-2\" data-name=\"job status warning explanation\">\n                                Job status and runtime readings are unavailable because the host-supervisor API does not exist in this build.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex flex-wrap items-center gap-3\" data-kid=\"1-1-2-2-1-3\" data-name=\"supervisor control buttons\">\n                        <button aria-disabled=\"true\" class=\"flex cursor-not-allowed items-center gap-2 border border-[#555d39] px-3 py-2 font-[Space_Mono] text-[11px] text-[#879064]\" data-kid=\"1-1-2-2-1-3-1\" data-name=\"stop clean button\" disabled=\"\" type=\"button\">\n                            <i class=\"ti ti-player-stop text-[15px]\" data-kid=\"1-1-2-2-1-3-1-1\" data-name=\"player stop icon\">\n                            </i>\n                            Stop · clean\n                        </button>\n                        <button aria-disabled=\"true\" class=\"flex cursor-not-allowed items-center gap-2 border border-[#842d25] bg-[#260e0b] px-3 py-2 font-[Space_Mono] text-[11px] text-[#df8c7e]\" data-kid=\"1-1-2-2-1-3-2\" data-name=\"kill hard button\" disabled=\"\" type=\"button\">\n                            <i class=\"ti ti-skull text-[15px]\" data-kid=\"1-1-2-2-1-3-2-1\" data-name=\"skull icon\">\n                            </i>\n                            Kill · hard\n                        </button>\n                        <span class=\"text-[12px] text-[#929b70]\" data-kid=\"1-1-2-2-1-3-3\" data-name=\"action disclaimer text\">\n                            Separate host-supervisor actions · unavailable until the API exists\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex flex-col border border-[#30370a] bg-[#090b02] p-5\" data-kid=\"1-1-2-2-2\" data-name=\"environment status card\">\n                    <h2 class=\"text-[16px] font-semibold text-white\" data-kid=\"1-1-2-2-2-1\" data-name=\"environment status title\">\n                        Execution environment\n                    </h2>\n                    <div class=\"mt-4 flex items-end justify-between border-b border-[#30370a] pb-3\" data-kid=\"1-1-2-2-2-2\" data-name=\"device verification container\">\n                        <span class=\"text-[13px] text-[#a8b27f]\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"device verification label\">\n                            Verified device\n                        </span>\n                        <span class=\"font-[Space_Mono] text-[14px] font-bold text-[#deff00]\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"device verification status\">\n                            CPU only\n                        </span>\n                    </div>\n                    <p class=\"mt-3 text-[12px] leading-5 text-[#929b70]\" data-kid=\"1-1-2-2-2-3\" data-name=\"device availability disclaimer\">\n                        CUDA is unavailable in the verified environment. Runtime CPU and RAM readings are unavailable.\n                    </p>\n                </div>\n            </section>\n            <section class=\"mb-5 grid grid-cols-[minmax(0,1.8fr)_minmax(260px,0.72fr)] gap-4\" data-kid=\"1-1-2-3\" data-name=\"training metrics section\">\n                <div class=\"border border-[#465018] bg-[#101400] p-5\" data-kid=\"1-1-2-3-1\" data-name=\"metrics chart container\">\n                    <div class=\"flex flex-wrap items-end justify-between gap-3 border-b border-[#333b12] pb-4\" data-kid=\"1-1-2-3-1-1\" data-name=\"metrics header\">\n                        <div data-kid=\"1-1-2-3-1-1-1\" data-name=\"metrics title and description\">\n                            <h2 class=\"text-[18px] font-semibold text-white\" data-kid=\"1-1-2-3-1-1-1-1\" data-name=\"training metrics title\">\n                                Training metrics\n                            </h2>\n                            <p class=\"mt-1 text-[13px] text-[#9eaa72]\" data-kid=\"1-1-2-3-1-1-1-2\" data-name=\"metrics source description\">\n                                Dreamer · per-step values\n                            </p>\n                        </div>\n                        <span class=\"font-[Space_Mono] text-[10px] text-[#9eaa72]\" data-kid=\"1-1-2-3-1-1-2\" data-name=\"metrics source indicator\">\n                            SOURCE · train_step metrics dict\n                        </span>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-[44px_minmax(0,1fr)] grid-rows-[224px_35px]\" data-kid=\"1-1-2-3-1-2\" data-name=\"metrics chart drawing area\">\n                        <div class=\"flex items-center justify-center border-r border-[#3b4516] pr-2\" data-kid=\"1-1-2-3-1-2-1\" data-name=\"axis label container\">\n                            <span class=\"[writing-mode:vertical-rl] rotate-180 font-[Space_Mono] text-[10px] text-[#9eaa72]\" data-kid=\"1-1-2-3-1-2-1-1\" data-name=\"y-axis label\">\n                                metric value\n                            </span>\n                        </div>\n                        <div class=\"relative border-x border-t border-[#465018] bg-[#060800]\" data-kid=\"1-1-2-3-1-2-2\" data-name=\"empty chart grid\">\n                            <div class=\"absolute inset-x-0 inset-y-3 flex flex-col justify-between\" data-kid=\"1-1-2-3-1-2-2-1\" data-name=\"grid lines container\">\n                                <div class=\"border-t border-dashed border-[#252b0e]\" data-kid=\"1-1-2-3-1-2-2-1-1\" data-name=\"grid line 1\">\n                                </div>\n                                <div class=\"border-t border-dashed border-[#252b0e]\" data-kid=\"1-1-2-3-1-2-2-1-2\" data-name=\"grid line 2\">\n                                </div>\n                                <div class=\"border-t border-dashed border-[#252b0e]\" data-kid=\"1-1-2-3-1-2-2-1-3\" data-name=\"grid line 3\">\n                                </div>\n                                <div class=\"border-t border-dashed border-[#252b0e]\" data-kid=\"1-1-2-3-1-2-2-1-4\" data-name=\"grid line 4\">\n                                </div>\n                            </div>\n                            <div class=\"absolute inset-0 flex items-center justify-center px-4 text-center\" data-kid=\"1-1-2-3-1-2-2-2\" data-name=\"no data message container\">\n                                <div data-kid=\"1-1-2-3-1-2-2-2-1\" data-name=\"no data message text\">\n                                    <p class=\"font-[Space_Mono] text-[13px] text-[#deff00]\" data-kid=\"1-1-2-3-1-2-2-2-1-1\" data-name=\"no data title\">\n                                        No per-step values received\n                                    </p>\n                                    <p class=\"mt-2 text-[13px] text-[#a6b17b]\" data-kid=\"1-1-2-3-1-2-2-2-1-2\" data-name=\"no data subtitle\">\n                                        Per-step values will come from a supervisor WebSocket.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div data-kid=\"1-1-2-3-1-2-3\" data-name=\"chart bottom padding\">\n                        </div>\n                        <div class=\"flex items-center border-x border-b border-[#465018] px-3 font-[Space_Mono] text-[10px] text-[#9eaa72]\" data-kid=\"1-1-2-3-1-2-4\" data-name=\"x-axis label container\">\n                            <span data-kid=\"1-1-2-3-1-2-4-1\" data-name=\"x-axis label\">\n                                training_step\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 border-t border-[#333b12] pt-3\" data-kid=\"1-1-2-3-1-3\" data-name=\"metrics keys section\">\n                        <div class=\"mb-2 font-[Space_Mono] text-[10px] text-[#7f8a54]\" data-kid=\"1-1-2-3-1-3-1\" data-name=\"metric keys header\">\n                            METRIC KEYS · NO LINE DATA\n                        </div>\n                        <div class=\"grid grid-cols-4 gap-x-3 gap-y-2 font-[Space_Mono] text-[11px] leading-4 text-[#cbd59e]\" data-kid=\"1-1-2-3-1-3-2\" data-name=\"metric keys grid\">\n                            <span data-kid=\"1-1-2-3-1-3-2-1\" data-name=\"metric world model loss\">\n                                world_model_loss\n                            </span>\n                            <span data-kid=\"1-1-2-3-1-3-2-2\" data-name=\"metric recon loss\">\n                                recon_loss\n                            </span>\n                            <span data-kid=\"1-1-2-3-1-3-2-3\" data-name=\"metric reward loss\">\n                                reward_loss\n                            </span>\n                            <span data-kid=\"1-1-2-3-1-3-2-4\" data-name=\"metric kl loss\">\n                                kl_loss\n                            </span>\n                            <span data-kid=\"1-1-2-3-1-3-2-5\" data-name=\"metric value loss\">\n                                value_loss\n                            </span>\n                            <span data-kid=\"1-1-2-3-1-3-2-6\" data-name=\"metric policy loss\">\n                                policy_loss\n                            </span>\n                            <span data-kid=\"1-1-2-3-1-3-2-7\" data-name=\"metric entropy\">\n                                entropy\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex flex-col border border-[#30370a] bg-[#090b02]\" data-kid=\"1-1-2-3-2\" data-name=\"replay buffer and regime card\">\n                    <div class=\"p-5\" data-kid=\"1-1-2-3-2-1\" data-name=\"replay buffer card\">\n                        <h2 class=\"text-[16px] font-semibold text-white\" data-kid=\"1-1-2-3-2-1-1\" data-name=\"replay buffer title\">\n                            Replay buffer\n                        </h2>\n                        <p class=\"mt-1 text-[12px] text-[#929b70]\" data-kid=\"1-1-2-3-2-1-2\" data-name=\"replay buffer description\">\n                            Configured capacity · not current usage\n                        </p>\n                        <div class=\"mt-4 flex items-baseline gap-2\" data-kid=\"1-1-2-3-2-1-3\" data-name=\"capacity display container\">\n                            <span class=\"font-[Space_Mono] text-[29px] leading-none text-[#deff00]\" data-kid=\"1-1-2-3-2-1-3-1\" data-name=\"capacity value\">\n                                100,000\n                            </span>\n                            <span class=\"font-[Space_Mono] text-[11px] text-[#a5b17a]\" data-kid=\"1-1-2-3-2-1-3-2\" data-name=\"capacity label\">\n                                capacity\n                            </span>\n                        </div>\n                        <div class=\"mt-4 flex justify-between border-t border-[#30370a] pt-3 text-[13px] text-[#c7d29a]\" data-kid=\"1-1-2-3-2-1-4\" data-name=\"sequence length container\">\n                            <span data-kid=\"1-1-2-3-2-1-4-1\" data-name=\"sequence length label\">\n                                Sequence length\n                            </span>\n                            <span class=\"font-[Space_Mono]\" data-kid=\"1-1-2-3-2-1-4-2\" data-name=\"sequence length value\">\n                                64\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[12px] text-[#929b70]\" data-kid=\"1-1-2-3-2-1-5\" data-name=\"buffer availability disclaimer\">\n                            Current buffer usage unavailable.\n                        </p>\n                    </div>\n                    <div class=\"border-t border-[#30370a] p-5\" data-kid=\"1-1-2-3-2-2\" data-name=\"regime labels card\">\n                        <h2 class=\"text-[16px] font-semibold text-white\" data-kid=\"1-1-2-3-2-2-1\" data-name=\"regime labels title\">\n                            Regime labels\n                        </h2>\n                        <div class=\"mt-3 flex flex-wrap gap-2 font-[Space_Mono] text-[10px] text-[#d0dba2]\" data-kid=\"1-1-2-3-2-2-2\" data-name=\"regime tags container\">\n                            <span class=\"border border-[#515d24] px-2 py-1\" data-kid=\"1-1-2-3-2-2-2-1\" data-name=\"regime tag trend up\">\n                                trend_up\n                            </span>\n                            <span class=\"border border-[#515d24] px-2 py-1\" data-kid=\"1-1-2-3-2-2-2-2\" data-name=\"regime tag trend down\">\n                                trend_down\n                            </span>\n                            <span class=\"border border-[#515d24] px-2 py-1\" data-kid=\"1-1-2-3-2-2-2-3\" data-name=\"regime tag range\">\n                                range\n                            </span>\n                            <span class=\"border border-[#515d24] px-2 py-1\" data-kid=\"1-1-2-3-2-2-2-4\" data-name=\"regime tag high vol\">\n                                high_vol\n                            </span>\n                            <span class=\"border border-[#515d24] px-2 py-1\" data-kid=\"1-1-2-3-2-2-2-5\" data-name=\"regime tag low vol\">\n                                low_vol\n                            </span>\n                            <span class=\"border border-[#515d24] px-2 py-1\" data-kid=\"1-1-2-3-2-2-2-6\" data-name=\"regime tag unknown\">\n                                unknown\n                            </span>\n                        </div>\n                        <p class=\"mt-3 text-[12px] text-[#929b70]\" data-kid=\"1-1-2-3-2-2-3\" data-name=\"regime labels disclaimer\">\n                            Legend only · no regime timeline.\n                        </p>\n                    </div>\n                </div>\n            </section>\n            <section class=\"border border-[#465018] bg-[#0b0d03]\" data-kid=\"1-1-2-4\" data-name=\"artifact evaluations section\">\n                <div class=\"flex flex-wrap items-end justify-between gap-3 border-b border-[#3c4418] px-5 py-4\" data-kid=\"1-1-2-4-1\" data-name=\"evaluations section header\">\n                    <div data-kid=\"1-1-2-4-1-1\" data-name=\"evaluations header content\">\n                        <h2 class=\"text-[18px] font-semibold text-white\" data-kid=\"1-1-2-4-1-1-1\" data-name=\"evaluations title\">\n                            Artifact evaluations\n                        </h2>\n                        <p class=\"mt-1 text-[13px] text-[#9eaa72]\" data-kid=\"1-1-2-4-1-1-2\" data-name=\"evaluations subtitle\">\n                            Historical evaluation records · not training jobs\n                        </p>\n                    </div>\n                    <span class=\"font-[Space_Mono] text-[10px] text-[#89945f]\" data-kid=\"1-1-2-4-1-2\" data-name=\"evaluations source indicator\">\n                        SOURCE · artifacts/models/*/evaluation.json\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-[minmax(260px,2.2fr)_0.65fr_0.85fr_1fr_minmax(150px,1.1fr)] gap-3 border-b border-[#3c4418] px-5 py-3 font-[Space_Mono] text-[10px] text-[#9aa66f]\" data-kid=\"1-1-2-4-2\" data-name=\"table header row\">\n                    <span data-kid=\"1-1-2-4-2-1\" data-name=\"table header artifact\">\n                        ARTIFACT\n                    </span>\n                    <span data-kid=\"1-1-2-4-2-2\" data-name=\"table header sharpe\">\n                        SHARPE\n                    </span>\n                    <span data-kid=\"1-1-2-4-2-3\" data-name=\"table header return\">\n                        RETURN\n                    </span>\n                    <span data-kid=\"1-1-2-4-2-4\" data-name=\"table header trades\">\n                        TRADES (MIN 20)\n                    </span>\n                    <span data-kid=\"1-1-2-4-2-5\" data-name=\"table header gate\">\n                        GATE\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-[minmax(260px,2.2fr)_0.65fr_0.85fr_1fr_minmax(150px,1.1fr)] items-center gap-3 border-b border-[#252b10] px-5 py-4\" data-kid=\"1-1-2-4-3\" data-name=\"evaluation row 1\">\n                    <div data-kid=\"1-1-2-4-3-1\" data-name=\"artifact details container\">\n                        <div class=\"font-[Space_Mono] text-[11px] text-[#ecf3d2]\" data-kid=\"1-1-2-4-3-1-1\" data-name=\"artifact name\">\n                            Dreamer · 20261003T230304213562Z\n                        </div>\n                        <div class=\"mt-1 font-[Space_Mono] text-[10px] text-[#828d59]\" data-kid=\"1-1-2-4-3-1-2\" data-name=\"evaluation timestamp\">\n                            evaluated_at 2026-10-03T23:03:23.483202+00:00\n                        </div>\n                    </div>\n                    <span class=\"font-[Space_Mono] text-[13px] text-[#e8f2bd]\" data-kid=\"1-1-2-4-3-2\" data-name=\"sharpe value 1\">\n                        3.10\n                    </span>\n                    <span class=\"font-[Space_Mono] text-[13px] text-[#deff00]\" data-kid=\"1-1-2-4-3-3\" data-name=\"return value 1\">\n                        +6.04%\n                    </span>\n                    <span class=\"font-[Space_Mono] text-[12px] text-[#e8f2bd]\" data-kid=\"1-1-2-4-3-4\" data-name=\"trades count 1\">\n                        3 / 20\n                    </span>\n                    <span class=\"inline-flex w-fit flex-col border border-[#812a22] bg-[#270d0a] px-2 py-1 text-[#ffb2a7]\" data-kid=\"1-1-2-4-3-5\" data-name=\"promotability status box 1\">\n                        <b class=\"font-[Space_Mono] text-[10px]\" data-kid=\"1-1-2-4-3-5-1\" data-name=\"promotability text\">\n                            NOT PROMOTABLE\n                        </b>\n                        <small class=\"mt-0.5 font-[Space_Mono] text-[9px]\" data-kid=\"1-1-2-4-3-5-2\" data-name=\"promotability reason code\">\n                            passed=false\n                        </small>\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-[minmax(260px,2.2fr)_0.65fr_0.85fr_1fr_minmax(150px,1.1fr)] items-center gap-3 border-b border-[#252b10] px-5 py-4\" data-kid=\"1-1-2-4-4\" data-name=\"evaluation row 2\">\n                    <div data-kid=\"1-1-2-4-4-1\" data-name=\"artifact details container\">\n                        <div class=\"font-[Space_Mono] text-[11px] text-[#ecf3d2]\" data-kid=\"1-1-2-4-4-1-1\" data-name=\"artifact name\">\n                            Dreamer · 20261003T230535411560Z\n                        </div>\n                        <div class=\"mt-1 font-[Space_Mono] text-[10px] text-[#828d59]\" data-kid=\"1-1-2-4-4-1-2\" data-name=\"evaluation timestamp\">\n                            evaluated_at 2026-10-03T23:06:36.982822+00:00\n                        </div>\n                    </div>\n                    <span class=\"font-[Space_Mono] text-[13px] text-[#e8f2bd]\" data-kid=\"1-1-2-4-4-2\" data-name=\"sharpe value 2\">\n                        1.71\n                    </span>\n                    <span class=\"font-[Space_Mono] text-[13px] text-[#deff00]\" data-kid=\"1-1-2-4-4-3\" data-name=\"return value 2\">\n                        +0.02%\n                    </span>\n                    <span class=\"font-[Space_Mono] text-[12px] text-[#e8f2bd]\" data-kid=\"1-1-2-4-4-4\" data-name=\"trades count 2\">\n                  