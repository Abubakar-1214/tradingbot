      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Cuprum:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"min-h-full bg-[#000000] text-[#EDCC69] font-['Chakra_Petch']\">\n  <header class=\"border-b border-[#554D34] bg-[#0D0A03]\">\n    <div class=\"mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-x-8 gap-y-3 px-6 py-4\">\n      <div class=\"flex shrink-0 items-center gap-3\">\n        <div class=\"grid h-10 w-10 place-items-center rounded-full border border-[#EC8022] text-[21px] text-[#EC8022]\">✳</div>\n        <div>\n          <div class=\"text-[17px] font-semibold tracking-[0.08em]\">XAUUSD</div>\n          <div class=\"font-['Cuprum'] text-[12px] text-[#9E936E]\">AI control desk</div>\n        </div>\n      </div>\n      <nav aria-label=\"Primary\" class=\"flex flex-wrap items-center gap-x-2 gap-y-1 text-[14px]\">\n        <a class=\"rounded-full px-4 py-2 text-[#A99D74]\" href=\"#operations\"><i class=\"ph ph-chart-line-up mr-2 text-[17px]\"></i>Operations</a>\n        <a aria-current=\"page\" class=\"rounded-full border border-[#554D34] bg-[#171308] px-4 py-2 font-medium text-[#EDCC69]\" href=\"#training\"><i class=\"ph ph-cpu mr-2 text-[17px] text-[#EC8022]\"></i>Training</a>\n        <a class=\"rounded-full px-4 py-2 text-[#A99D74]\" href=\"#prepare\"><i class=\"ph ph-sliders-horizontal mr-2 text-[17px]\"></i>Prepare Run</a>\n        <a class=\"rounded-full px-4 py-2 text-[#A99D74]\" href=\"#models\"><i class=\"ph ph-folder-open mr-2 text-[17px]\"></i>Models / Evaluation</a>\n        <a class=\"rounded-full px-4 py-2 text-[#A99D74]\" href=\"#risk\"><i class=\"ph ph-shield-check mr-2 text-[17px]\"></i>Risk / Settings</a>\n      </nav>\n      <div class=\"flex items-center gap-2 rounded-full border border-[#554D34] px-3 py-2 font-['Cuprum'] text-[13px] text-[#F4A9A9]\">\n        <span class=\"h-2 w-2 rounded-full bg-[#F4A9A9]\"></span>\n        Supervisor API unavailable\n      </div>\n    </div>\n  </header>\n\n  <main id=\"training\" class=\"mx-auto max-w-[1440px] px-6 pb-10 pt-7\">\n    <section class=\"border-b border-[#554D34] pb-6\">\n      <div class=\"flex flex-col justify-between gap-6 xl:flex-row xl:items-start\">\n        <div class=\"max-w-[720px]\">\n          <h1 class=\"text-[34px] font-semibold leading-tight tracking-[-0.03em]\">Training</h1>\n          <p class=\"mt-2 text-[15px] leading-6 text-[#B4A778]\">Supervisor status <span class=\"font-semibold text-[#F4A9A9]\">Unavailable · training supervisor state not loaded</span></p>\n          <p class=\"mt-1 font-['Cuprum'] text-[14px] text-[#897E5C]\">No dashboard backend exists to report a process, job state, or live telemetry.</p>\n        </div>\n        <div class=\"flex flex-wrap items-center gap-2.5 xl:pt-1\">\n          <button disabled aria-disabled=\"true\" class=\"cursor-not-allowed rounded-full border border-[#EC8022]/50 bg-[#EC8022]/15 px-4 py-2.5 text-[13px] font-semibold text-[#EC8022]/70\">Launch run</button>\n          <button disabled aria-disabled=\"true\" class=\"cursor-not-allowed rounded-full border border-[#554D34] bg-[#0D0A03] px-4 py-2.5 text-[13px] text-[#A99D74]/60\"><i class=\"ph ph-pause-circle mr-1.5 text-[16px]\"></i>Pause</button>\n          <button disabled aria-disabled=\"true\" class=\"cursor-not-allowed rounded-full border border-[#554D34] bg-[#0D0A03] px-4 py-2.5 text-[13px] text-[#A99D74]/60\">Resume</button>\n          <button disabled aria-disabled=\"true\" class=\"cursor-not-allowed rounded-full border border-[#8B805E] px-4 py-2.5 text-[13px] text-[#C8BC91]/60\"><i class=\"ph ph-stop-circle mr-1.5 text-[16px]\"></i>Stop training</button>\n          <button disabled aria-disabled=\"true\" class=\"cursor-not-allowed rounded-[10px] border border-[#F4A9A9]/60 bg-[#F4A9A9]/10 px-4 py-2.5 text-[13px] font-semibold text-[#F4A9A9]/70\"><i class=\"ph ph-prohibit mr-1.5 text-[16px]\"></i>Kill process</button>\n        </div>\n      </div>\n      <div class=\"mt-5 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-[#554D34]/70 pt-3 font-['Cuprum'] text-[13px]\">\n        <span class=\"text-[#A99D74]\">Planned supervisor actions <span class=\"mx-1 text-[#554D34]\">/</span> disabled until the control service is present</span>\n        <span class=\"text-[#F4A9A9]\">No local process control is available</span>\n      </div>\n    </section>\n\n    <section aria-label=\"Training telemetry\" class=\"mt-6 grid grid-cols-1 gap-5 xl:grid-cols-[minmax(0,1.9fr)_minmax(290px,0.82fr)]\">\n      <div class=\"overflow-hidden rounded-[24px] border border-[#554D34] bg-[#0D0A03]\">\n        <div class=\"flex flex-wrap items-start justify-between gap-4 px-6 pt-5\">\n          <div>\n            <h2 class=\"text-[21px] font-semibold\">Dreamer train_step metrics</h2>\n            <p class=\"mt-1 font-['Cuprum'] text-[14px] text-[#9E936E]\">Live values unavailable · no series plotted</p>\n          </div>\n          <span class=\"rounded-full border border-[#F4A9A9]/50 px-3 py-1 font-['Cuprum'] text-[12px] text-[#F4A9A9]\">INACTIVE / UNLOADED</span>\n        </div>\n        <div class=\"mx-6 mt-4 overflow-hidden rounded-[18px] border border-[#554D34] bg-[#050402]\">\n          <div class=\"relative h-[220px]\" style=\"background-image:linear-gradient(to right,rgba(85,77,52,.22) 1px,transparent 1px),linear-gradient(to bottom,rgba(85,77,52,.22) 1px,transparent 1px);background-size:20% 25%;\">\n            <div class=\"absolute left-3 top-3 font-['Cuprum'] text-[11px] text-[#746A4E]\">metric value</div>\n            <div class=\"absolute inset-0 flex flex-col items-center justify-center px-5 text-center\">\n              <span class=\"grid h-10 w-10 place-items-center rounded-full border border-[#554D34] font-['Cuprum'] text-[22px] text-[#746A4E]\">—</span>\n              <p class=\"mt-3 text-[16px] text-[#D9C783]\">No training data received</p>\n              <p class=\"mt-1 font-['Cuprum'] text-[13px] text-[#897E5C]\">Chart remains empty until live train_step metrics are supplied.</p>\n            </div>\n            <div class=\"absolute bottom-2 right-3 font-['Cuprum'] text-[11px] text-[#746A4E]\">training_step</div>\n          </div>\n        </div>\n        <div class=\"grid grid-cols-1 gap-x-8 px-6 pb-5 pt-4 sm:grid-cols-2\">\n          <div class=\"flex items-center justify-between gap-3 border-b border-[#554D34]/70 py-2.5 font-['Cuprum'] text-[14px]\"><code class=\"text-[#D9C783]\">world_model_loss</code><span class=\"text-[12px] text-[#F4A9A9]\">inactive / unloaded</span></div>\n          <div class=\"flex items-center justify-between gap-3 border-b border-[#554D34]/70 py-2.5 font-['Cuprum'] text-[14px]\"><code class=\"text-[#D9C783]\">recon_loss</code><span class=\"text-[12px] text-[#F4A9A9]\">inactive / unloaded</span></div>\n          <div class=\"flex items-center justify-between gap-3 border-b border-[#554D34]/70 py-2.5 font-['Cuprum'] text-[14px]\"><code class=\"text-[#D9C783]\">reward_loss</code><span class=\"text-[12px] text-[#F4A9A9]\">inactive / unloaded</span></div>\n          <div class=\"flex items-center justify-between gap-3 border-b border-[#554D34]/70 py-2.5 font-['Cuprum'] text-[14px]\"><code class=\"text-[#D9C783]\">kl_loss</code><span class=\"text-[12px] text-[#F4A9A9]\">inactive / unloaded</span></div>\n          <div class=\"flex items-center justify-between gap-3 border-b border-[#554D34]/70 py-2.5 font-['Cuprum'] text-[14px]\"><code class=\"text-[#D9C783]\">value_loss</code><span class=\"text-[12px] text-[#F4A9A9]\">inactive / unloaded</span></div>\n          <div class=\"flex items-center justify-between gap-3 border-b border-[#554D34]/70 py-2.5 font-['Cuprum'] text-[14px]\"><code class=\"text-[#D9C783]\">policy_loss</code><span class=\"text-[12px] text-[#F4A9A9]\">inactive / unloaded</span></div>\n          <div class=\"flex items-center justify-between gap-3 border-b border-[#554D34]/70 py-2.5 font-['Cuprum'] text-[14px]\"><code class=\"text-[#D9C783]\">entropy</code><span class=\"text-[12px] text-[#F4A9A9]\">inactive / unloaded</span></div>\n        </div>\n      </div>\n\n      <aside class=\"rounded-[24px] border border-[#554D34] bg-[#0D0A03] px-6 py-5\">\n        <h2 class=\"text-[20px] font-semibold\">Training context</h2>\n        <div class=\"mt-4 border-t border-[#554D34] pt-4\">\n          <div class=\"text-[15px]\">Replay buffer</div>\n          <p class=\"mt-1 font-['Cuprum'] text-[13px] text-[#9E936E]\">Documented configuration · not utilization</p>\n          <div class=\"mt-3 flex items-end justify-between gap-4 font-['Cuprum']\">\n            <div><span class=\"text-[25px] font-semibold tabular-nums text-[#EDCC69]\">100,000</span><span class=\"ml-2 text-[13px] text-[#A99D74]\">capacity</span></div>\n            <div class=\"text-right\"><span class=\"block text-[12px] text-[#897E5C]\">sequence length</span><span class=\"text-[20px] tabular-nums\">64</span></div>\n          </div>\n          <p class=\"mt-2 text-[12px] text-[#897E5C]\">Buffer size and usage have not been loaded.</p>\n        </div>\n        <div class=\"mt-4 border-t border-[#554D34] pt-4\">\n          <div class=\"text-[15px]\">Compute environment</div>\n          <div class=\"mt-2 flex items-center gap-2 font-['Cuprum'] text-[16px]\"><span class=\"h-2 w-2 rounded-full bg-[#7B8A68]\"></span>CPU only</div>\n          <p class=\"mt-1 text-[12px] text-[#897E5C]\">CUDA unavailable in the documented environment.</p>\n        </div>\n        <div class=\"mt-4 border-t border-[#554D34] pt-4\">\n          <div class=\"text-[15px]\">Regime labels</div>\n          <p class=\"mt-1 font-['Cuprum'] text-[12px] text-[#897E5C]\">Legend only · no training timeline loaded</p>\n          <div class=\"mt-3 flex flex-wrap gap-x-4 gap-y-2 font-['Cuprum'] text-[13px]\">\n            <span class=\"inline-flex items-center gap-2\"><i class=\"h-2 w-2 rounded-full bg-[#D9C783]\"></i>trend_up</span>\n            <span class=\"inline-flex items-center gap-2\"><i class=\"h-2 w-2 rounded-full bg-[#C98962]\"></i>trend_down</span>\n            <span class=\"inline-flex items-center gap-2\"><i class=\"h-2 w-2 rounded-full bg-[#A99D74]\"></i>range</span>\n            <span class=\"inline-flex items-center gap-2\"><i class=\"h-2 w-2 rounded-full bg-[#EC8022]\"></i>high_vol</span>\n            <span class=\"inline-flex items-center gap-2\"><i class=\"h-2 w-2 rounded-full bg-[#7B8A68]\"></i>low_vol</span>\n            <span class=\"inline-flex items-center gap-2\"><i class=\"h-2 w-2 rounded-full bg-[#746A4E]\"></i>unknown</span>\n          </div>\n        </div>\n      </aside>\n    </section>\n\n    <section class=\"mt-6 overflow-hidden rounded-[24px] border border-[#554D34] bg-[#0D0A03]\">\n      <div class=\"flex flex-wrap items-end justify-between gap-3 border-b border-[#554D34] px-6 py-5\">\n        <div>\n          <h2 class=\"text-[21px] font-semibold\">Evaluated artifact evidence</h2>\n          <p class=\"mt-1 font-['Cuprum'] text-[14px] text-[#9E936E]\">Evaluation records only · these are not running jobs</p>\n        </div>\n        <div class=\"font-['Cuprum'] text-[14px] text-[#F4A9A9]\">All listed artifacts: NOT PROMOTABLE</div>\n      </div>\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full min-w-[820px] border-separate border-spacing-0 text-left font-['Cuprum']\">\n          <thead class=\"text-[12px] text-[#9E936E]\">\n            <tr>\n              <th class=\"px-6 py-3 font-medium\">Artifact</th>\n              <th class=\"px-4 py-3 font-medium\">Sharpe</th>\n              <th class=\"px-4 py-3 font-medium\">Total return</th>\n              <th class=\"px-4 py-3 font-medium\">Max DD</th>\n              <th class=\"px-4 py-3 font-medium\">Trades</th>\n              <th class=\"px-6 py-3 text-right font-medium\">Evaluation gate</th>\n            </tr>\n          </thead>\n          <tbody class=\"text-[14px] tabular-nums\">\n            <tr>\n              <td class=\"border-t border-[#554D34] px-6 py-3.5\"><div class=\"font-semibold text-[#EDCC69]\">Dreamer</div><div class=\"mt-0.5 text-[12px] text-[#9E936E]\">dreamer_20261003T230304213562Z</div></td>\n              <td class=\"border-t border-[#554D34] px-4 py-3.5\">3.10</td>\n              <td class=\"border-t border-[#554D34] px-4 py-3.5\">+6.04%</td>\n              <td class=\"border-t border-[#554D34] px-4 py-3.5\">3.04%</td>\n              <td class=\"border-t border-[#554D34] px-4 py-3.5\">3 / 20</td>\n              <td class=\"border-t border-[#554D34] px-6 py-3.5 text-right\"><span class=\"inline-flex rounded-full border border-[#F4A9A9]/55 p-[2px] text-[#F4A9A9]\"><span class=\"rounded-full border border-[#F4A9A9]/25 px-3 py-1 text-[12px]\">passed:false / NOT PROMOTABLE</span></span></td>\n            </tr>\n            <tr>\n              <td class=\"border-t border-[#554D34] px-6 py-3.5\"><div class=\"font-semibold text-[#EDCC69]\">Dreamer</div><div class=\"mt-0.5 text-[12px] text-[#9E936E]\">dreamer_20261003T230535411560Z</div></td>\n              <td class=\"border-t border-[#554D34] px-4 py-3.5\">1.71</td>\n              <td class=\"border-t border-[#554D34] px-4 py-3.5\">+0.02%</td>\n              <td class=\"border-t border-[#554D34] px-4 py-3.5\">0.02%</td>\n              <td class=\"border-t border-[#554D34] px-4 py-3.5\">1 / 20</td>\n              <td class=\"border-t border-[#554D34] px-6 py-3.5 text-right\"><span class=\"inline-flex rounded-full border border-[#F4A9A9]/55 p-[2px] text-[#F4A9A9]\"><span class=\"rounded-full border border-[#F4A9A9]/25 px-3 py-1 text-[12px]\">passed:false / NOT PROMOTABLE</span></span></td>\n            </tr>\n            <tr>\n              <td class=\"border-t border-[#554D34] px-6 py-3.5\"><div class=\"font-semibold text-[#EDCC69]\">PPO</div><div class=\"mt-0.5 text-[12px] text-[#9E936E]\">ppo_gold_v1</div></td>\n              <td class=\"border-t border-[#554D34] px-4 py-3.5 text-[#F4A9A9]\">-3.21</td>\n              <td class=\"border-t border-[#554D34] px-4 py-3.5 text-[#F4A9A9]\">-74.74%</td>\n              <td class=\"border-t border-[#554D34] px-4 py-3.5 text-[#F4A9A9]\">74.78%</td>\n              <td class=\"border-t border-[#554D34] px-4 py-3.5\">2849</td>\n              <td class=\"border-t border-[#554D34] px-6 py-3.5 text-right\"><span class=\"inline-flex rounded-full border border-[#F4A9A9]/55 p-[2px] text-[#F4A9A9]\"><span class=\"rounded-full border border-[#F4A9A9]/25 px-3 py-1 text-[12px]\">passed:false / NOT PROMOTABLE</span></span></td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <div class=\"flex flex-wrap justify-between gap-2 border-t border-[#554D34] px-6 py-3 font-['Cuprum'] text-[12px] text-[#897E5C]\">\n        <span>Source: artifacts/models/&lt;run&gt;/evaluation.json</span>\n        <span>Evaluation history does not imply a current training process.</span>\n      </div>\n    </section>\n\n    <section class=\"mt-6 grid grid-cols-1 gap-5 xl:grid-cols-[minmax(0,1.5fr)_minmax(300px,0.8fr)]\">\n      <div class=\"overflow-hidden rounded-[24px] border border-[#554D34] bg-[#0D0A03]\">\n        <div class=\"border-b border-[#554D34] px-6 py-4\">\n          <h2 class=\"text-[20px] font-semibold\">Training jobs</h2>\n          <p class=\"mt-1 font-['Cuprum'] text-[13px] text-[#9E936E]\">Supervisor-owned job registry</p>\n        </div>\n        <div class=\"overflow-x-auto\">\n          <table class=\"w-full min-w-[620px] text-left font-['Cuprum']\">\n            <thead class=\"text-[12px] text-[#897E5C]\"><tr><th class=\"px-6 py-3 font-medium\">Job / run name</th><th class=\"px-4 py-3 font-medium\">Training script</th><th class=\"px-4 py-3 font-medium\">Status</th><th class=\"px-6 py-3 text-right font-medium\">Steps</th></tr></thead>\n            <tbody><tr><td colspan=\"4\" class=\"border-t border-[#554D34] px-6 py-8 text-center\"><div class=\"text-[15px] text-[#D9C783]\">No job records loaded</div><div class=\"mt-1 text-[13px] text-[#897E5C]\">The job table is empty because the training supervisor state is unavailable; no job state is inferred.</div></td></tr></tbody>\n          </table>\n        </div>\n      </div>\n      <div class=\"rounded-[24px] border border-[#554D34] bg-[#0D0A03]\">\n        <div class=\"px-6 py-4\">\n          <h2 class=\"text-[20px] font-semibold\">Logs &amp; checkpoints</h2>\n          <div class=\"mt-4 border-t border-[#554D34] pt-3\">\n            <div class=\"flex items-center justify-between gap-4 text-[14px]\"><span>Training logs</span><span class=\"font-['Cuprum'] text-[#F4A9A9]\">Unavailable</span></div>\n            <p class=\"mt-1 font-['Cuprum'] text-[13px] text-[#897E5C]\">Supervisor log stream not connected · no log lines loaded.</p>\n          </div>\n          <div class=\"mt-4 border-t border-[#554D34] pt-3\">\n            <div class=\"text-[14px]\">Checkpoint files</div>\n            <p class=\"mt-1 font-['Cuprum'] text-[13px] text-[#897E5C]\">File index unavailable · no checkpoint paths loaded.</p>\n          </div>\n          <div class=\"mt-4 border-t border-[#554D34] pt-3\">\n            <div class=\"text-[14px]\">File-backed evaluation artifacts</div>\n            <p class=\"mt-1 font-['Cuprum'] text-[12px] leading-5 text-[#9E936E]\">artifacts/models/dreamer_20261003T230304213562Z/evaluation.json<br>artifacts/models/dreamer_20261003T230535411560Z/evaluation.json<br>artifacts/models/ppo_gold_v1/evaluation.json</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <footer class=\"mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-[#554D34] pt-4 font-['Cuprum'] text-[12px] text-[#746A4E]\">\n      <span>Training telemetry is read-only until a supervisor API is available.</span>\n      <span>CPU-only environment · no GPU state assumed</span>\n    </footer>\n  </main>\n</div>",
