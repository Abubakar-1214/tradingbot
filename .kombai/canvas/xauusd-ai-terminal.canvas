4-5-4\" data-name=\"trades count 3\">\n                        2849 / 20\n                    </span>\n                    <span class=\"inline-flex w-fit flex-col border border-[#812a22] bg-[#270d0a] px-2 py-1 text-[#ffb2a7]\" data-kid=\"1-1-2-4-5-5\" data-name=\"promotability status box 3\">\n                        <b class=\"font-[Space_Mono] text-[10px]\" data-kid=\"1-1-2-4-5-5-1\" data-name=\"promotability text\">\n                            NOT PROMOTABLE\n                        </b>\n                        <small class=\"mt-0.5 font-[Space_Mono] text-[9px]\" data-kid=\"1-1-2-4-5-5-2\" data-name=\"promotability reason code\">\n                            passed=false\n                        </small>\n                    </span>\n                </div>\n            </section>\n        </main>\n    </div>\n</div>\n",
