  <span data-kid=\"1-1-3-3-1-2-2-12-1\" data-name=\"key label\">\n                                    CORRELATION_ASSET\n                                </span>\n                                <span data-kid=\"1-1-3-3-1-2-2-12-2\" data-name=\"value label\">\n                                    —\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-2 py-1.5 font-mono text-[13px]\" data-kid=\"1-1-3-3-1-2-2-13\" data-name=\"correlation block row\">\n                                <span data-kid=\"1-1-3-3-1-2-2-13-1\" data-name=\"key label\">\n                                    CORRELATION_BLOCK_LONG_ON_UP\n                                </span>\n                                <span data-kid=\"1-1-3-3-1-2-2-13-2\" data-name=\"value label\">\n                                    —\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-2 py-1.5 font-mono text-[13px]\" data-kid=\"1-1-3-3-1-2-2-14\" data-name=\"min confidence row\">\n                                <span data-kid=\"1-1-3-3-1-2-2-14-1\" data-name=\"key label\">\n                                    MIN_CONFIDENCE\n                                </span>\n                                <span data-kid=\"1-1-3-3-1-2-2-14-2\" data-name=\"value label\">\n                                    —\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-2 py-1.5 font-mono text-[13px]\" data-kid=\"1-1-3-3-1-2-2-15\" data-name=\"min ensemble agreement row\">\n                                <span data-kid=\"1-1-3-3-1-2-2-15-1\" data-name=\"key label\">\n                                    MIN_ENSEMBLE_AGREEMENT\n                                </span>\n                                <span data-kid=\"1-1-3-3-1-2-2-15-2\" data-name=\"value label\">\n                                    —\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-2 py-1.5 font-mono text-[13px]\" data-kid=\"1-1-3-3-1-2-2-16\" data-name=\"use kelly row\">\n                                <span data-kid=\"1-1-3-3-1-2-2-16-1\" data-name=\"key label\">\n                                    USE_KELLY\n                                </span>\n                                <span data-kid=\"1-1-3-3-1-2-2-16-2\" data-name=\"value label\">\n                                    —\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-2 py-1.5 font-mono text-[13px]\" data-kid=\"1-1-3-3-1-2-2-17\" data-name=\"kelly fraction row\">\n                                <span data-kid=\"1-1-3-3-1-2-2-17-1\" data-name=\"key label\">\n                                    KELLY_FRACTION\n                                </span>\n                                <span data-kid=\"1-1-3-3-1-2-2-17-2\" data-name=\"value label\">\n                                    —\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-2 py-1.5 font-mono text-[13px]\" data-kid=\"1-1-3-3-1-2-2-18\" data-name=\"kelly min trades row\">\n                                <span data-kid=\"1-1-3-3-1-2-2-18-1\" data-name=\"key label\">\n                                    KELLY_MIN_TRADES\n                                </span>\n                                <span data-kid=\"1-1-3-3-1-2-2-18-2\" data-name=\"value label\">\n                                    —\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"mt-4 border-t border-[#554D34] pt-4\" data-kid=\"1-1-3-3-1-2-3\" data-name=\"runtime statistics sub-section\">\n                            <h3 class=\"font-['Chakra_Petch',sans-serif] text-base font-semibold\" data-kid=\"1-1-3-3-1-2-3-1\" data-name=\"statistics title\">\n                                Runtime risk statistics\n                            </h3>\n                            <p class=\"mt-1 text-sm leading-5 text-[#A79D79]\" data-kid=\"1-1-3-3-1-2-3-2\" data-name=\"statistics details\">\n                                Unavailable · equity, daily P&L, drawdown, trades, consecutive losses and active rejection counts: —\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"mt-4 rounded-md border border-[#554D34] bg-black/60 p-4 text-sm leading-5 text-[#A79D79]\" data-kid=\"1-1-3-3-1-3\" data-name=\"disclaimer box\">\n                        Dashes indicate unresolved values, not zero.\n                    </p>\n                    <div class=\"mt-5 border-t border-[#554D34] pt-4\" data-kid=\"1-1-3-3-1-4\" data-name=\"kill-switch section\">\n                        <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-3-3-1-4-1\" data-name=\"kill-switch header\">\n                            <h3 class=\"font-['Chakra_Petch',sans-serif] text-base font-semibold\" data-kid=\"1-1-3-3-1-4-1-1\" data-name=\"kill-switch title\">\n                                Kill-switch file\n                            </h3>\n                            <span class=\"rounded-full border border-[#F4A9A9]/40 px-3 py-1 text-sm text-[#F4A9A9]\" data-kid=\"1-1-3-3-1-4-1-2\" data-name=\"kill-switch status badge\">\n                                Absent\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-sm leading-5 text-[#A79D79]\" data-kid=\"1-1-3-3-1-4-2\" data-name=\"kill-switch instruction\">\n                            Reported baseline: absent. The action writes the\n                            <code class=\"text-[#EDCC69]\" data-kid=\"1-1-3-3-1-4-2-1\" data-name=\"code label\">\n                                KILL_SWITCH\n                            </code>\n                            sentinel file only.\n                        </p>\n                        <button class=\"mt-4 w-full rounded-md border border-[#F4A9A9]/60 px-4 py-2.5 font-['Chakra_Petch',sans-serif] text-sm font-semibold text-[#F4A9A9]\" data-kid=\"1-1-3-3-1-4-3\" data-name=\"trigger button\" type=\"button\">\n                            Write kill-switch sentinel\n                        </button>\n                        <p class=\"mt-2 text-center text-xs text-[#A79D79]\" data-kid=\"1-1-3-3-1-4-4\" data-name=\"control disclaimer\">\n                            No broker controls · no order functions\n                        </p>\n                    </div>\n                </aside>\n                <div class=\"rounded-md border border-[#554D34] bg-[#0D0A03] p-5 sm:p-6\" data-kid=\"1-1-3-3-2\" data-name=\"proposed limits form container\">\n                    <div class=\"flex flex-col gap-4 border-b border-[#554D34] pb-5 sm:flex-row sm:items-start sm:justify-between\" data-kid=\"1-1-3-3-2-1\" data-name=\"form header\">\n                        <div data-kid=\"1-1-3-3-2-1-1\" data-name=\"form title group\">\n                            <h2 class=\"font-['Chakra_Petch',sans-serif] text-2xl font-semibold\" data-kid=\"1-1-3-3-2-1-1-1\" data-name=\"form title\">\n                                Proposed limits\n                            </h2>\n                            <p class=\"mt-1 max-w-2xl text-sm leading-5 text-[#A79D79]\" data-kid=\"1-1-3-3-2-1-1-2\" data-name=\"form description\">\n                                Editable .env whitelist · validated against\n                                <code class=\"text-[#EDCC69]\" data-kid=\"1-1-3-3-2-1-1-2-1\" data-name=\"config file name\">\n                                    core/config.py\n                                </code>\n                                before any write. Empty fields mean no proposed change.\n                            </p>\n                        </div>\n                        <span class=\"shrink-0 rounded-full border border-[#EC8022]/50 px-3 py-1.5 text-sm text-[#EC8022]\" data-kid=\"1-1-3-3-2-1-2\" data-name=\"form status badge\">\n                            Draft · not validated\n                        </span>\n                    </div>\n                    <form aria-label=\"Proposed risk limits\" class=\"mt-5 [&_input]:rounded-md [&_input]:py-2 [&_select]:rounded-md [&_select]:py-2\" data-kid=\"1-1-3-3-2-2\" data-name=\"settings form\">\n                        <div class=\"grid gap-x-8 gap-y-6 lg:grid-cols-2\" data-kid=\"1-1-3-3-2-2-1\" data-name=\"fields grid\">\n                            <fieldset class=\"min-w-0\" data-kid=\"1-1-3-3-2-2-1-1\" data-name=\"loss fieldset\">\n                                <legend class=\"mb-3 font-['Chakra_Petch',sans-serif] text-base font-semibold\" data-kid=\"1-1-3-3-2-2-1-1-1\" data-name=\"fieldset legend\">\n                                    Loss & exposure\n                                </legend>\n                                <div class=\"grid gap-3 sm:grid-cols-2\" data-kid=\"1-1-3-3-2-2-1-1-2\" data-name=\"fieldset fields container\">\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-1-2-1\" data-name=\"daily loss input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-1-2-1-1\" data-name=\"field label\">\n                                            MAX_DAILY_LOSS\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-1-2-1-2\" data-name=\"field input\" id=\"MAX_DAILY_LOSS\" name=\"MAX_DAILY_LOSS\" step=\"any\" type=\"number\"/>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-1-2-2\" data-name=\"drawdown input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-1-2-2-1\" data-name=\"field label\">\n                                            MAX_DRAWDOWN\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-1-2-2-2\" data-name=\"field input\" id=\"MAX_DRAWDOWN\" name=\"MAX_DRAWDOWN\" step=\"any\" type=\"number\"/>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-1-2-3\" data-name=\"losses input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-1-2-3-1\" data-name=\"field label\">\n                                            MAX_CONSECUTIVE_LOSSES\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-1-2-3-2\" data-name=\"field input\" id=\"MAX_CONSECUTIVE_LOSSES\" name=\"MAX_CONSECUTIVE_LOSSES\" step=\"1\" type=\"number\"/>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-1-2-4\" data-name=\"risk per trade input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-1-2-4-1\" data-name=\"field label\">\n                                            MAX_RISK_PER_TRADE\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-1-2-4-2\" data-name=\"field input\" id=\"MAX_RISK_PER_TRADE\" name=\"MAX_RISK_PER_TRADE\" step=\"any\" type=\"number\"/>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-1-2-5\" data-name=\"position input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-1-2-5-1\" data-name=\"field label\">\n                                            MAX_POSITION\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-1-2-5-2\" data-name=\"field input\" id=\"MAX_POSITION\" name=\"MAX_POSITION\" step=\"any\" type=\"number\"/>\n                                    </label>\n                                </div>\n                            </fieldset>\n                            <fieldset class=\"min-w-0\" data-kid=\"1-1-3-3-2-2-1-2\" data-name=\"frequency fieldset\">\n                                <legend class=\"mb-3 font-['Chakra_Petch',sans-serif] text-base font-semibold\" data-kid=\"1-1-3-3-2-2-1-2-1\" data-name=\"fieldset legend\">\n                                    Trade frequency & market gates\n                                </legend>\n                                <div class=\"grid gap-3 sm:grid-cols-2\" data-kid=\"1-1-3-3-2-2-1-2-2\" data-name=\"fieldset fields container\">\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-2-2-1\" data-name=\"trades per day input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-2-2-1-1\" data-name=\"field label\">\n                                            MAX_TRADES_PER_DAY\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-2-2-1-2\" data-name=\"field input\" id=\"MAX_TRADES_PER_DAY\" name=\"MAX_TRADES_PER_DAY\" step=\"1\" type=\"number\"/>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-2-2-2\" data-name=\"interval input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-2-2-2-1\" data-name=\"field label\">\n                                            MIN_TRADE_INTERVAL_SEC\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-2-2-2-2\" data-name=\"field input\" id=\"MIN_TRADE_INTERVAL_SEC\" name=\"MIN_TRADE_INTERVAL_SEC\" step=\"1\" type=\"number\"/>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-2-2-3\" data-name=\"vol threshold input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-2-2-3-1\" data-name=\"field label\">\n                                            VOL_THRESHOLD\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-2-2-3-2\" data-name=\"field input\" id=\"VOL_THRESHOLD\" name=\"VOL_THRESHOLD\" step=\"any\" type=\"number\"/>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-2-2-4\" data-name=\"spread input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-2-2-4-1\" data-name=\"field label\">\n                                            MAX_SPREAD\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-2-2-4-2\" data-name=\"field input\" id=\"MAX_SPREAD\" name=\"MAX_SPREAD\" step=\"any\" type=\"number\"/>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-2-2-5\" data-name=\"market hours input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-2-2-5-1\" data-name=\"field label\">\n                                            MARKET_HOURS_ONLY\n                                        </span>\n                                        <select class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#A79D79] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-2-2-5-2\" data-name=\"field select\" id=\"MARKET_HOURS_ONLY\" name=\"MARKET_HOURS_ONLY\">\n                                            <option data-kid=\"1-1-3-3-2-2-1-2-2-5-2-1\" data-name=\"select option\" selected=\"\" value=\"\">\n                                            </option>\n                                            <option data-kid=\"1-1-3-3-2-2-1-2-2-5-2-2\" data-name=\"select option\" value=\"true\">\n                                                true\n                                            </option>\n                                            <option data-kid=\"1-1-3-3-2-2-1-2-2-5-2-3\" data-name=\"select option\" value=\"false\">\n                                                false\n                                            </option>\n                                        </select>\n                                    </label>\n                                </div>\n                            </fieldset>\n                            <fieldset class=\"min-w-0\" data-kid=\"1-1-3-3-2-2-1-3\" data-name=\"correlation fieldset\">\n                                <legend class=\"mb-3 font-['Chakra_Petch',sans-serif] text-base font-semibold\" data-kid=\"1-1-3-3-2-2-1-3-1\" data-name=\"fieldset legend\">\n                                    Correlation guard\n                                </legend>\n                                <div class=\"grid gap-3 sm:grid-cols-2\" data-kid=\"1-1-3-3-2-2-1-3-2\" data-name=\"fieldset fields container\">\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-3-2-1\" data-name=\"correlation enabled input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-3-2-1-1\" data-name=\"field label\">\n                                            CORRELATION_GUARD_ENABLED\n                                        </span>\n                                        <select class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#A79D79] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-3-2-1-2\" data-name=\"field select\" id=\"CORRELATION_GUARD_ENABLED\" name=\"CORRELATION_GUARD_ENABLED\">\n                                            <option data-kid=\"1-1-3-3-2-2-1-3-2-1-2-1\" data-name=\"select option\" selected=\"\" value=\"\">\n                                            </option>\n                                            <option data-kid=\"1-1-3-3-2-2-1-3-2-1-2-2\" data-name=\"select option\" value=\"true\">\n                                                true\n                                            </option>\n                                            <option data-kid=\"1-1-3-3-2-2-1-3-2-1-2-3\" data-name=\"select option\" value=\"false\">\n                                                false\n                                            </option>\n                                        </select>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-3-2-2\" data-name=\"correlation asset input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-3-2-2-1\" data-name=\"field label\">\n                                            CORRELATION_ASSET\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-3-2-2-2\" data-name=\"field input\" id=\"CORRELATION_ASSET\" name=\"CORRELATION_ASSET\" type=\"text\"/>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm sm:col-span-2\" data-kid=\"1-1-3-3-2-2-1-3-2-3\" data-name=\"correlation block input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-3-2-3-1\" data-name=\"field label\">\n                                            CORRELATION_BLOCK_LONG_ON_UP\n                                        </span>\n                                        <select class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#A79D79] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-3-2-3-2\" data-name=\"field select\" id=\"CORRELATION_BLOCK_LONG_ON_UP\" name=\"CORRELATION_BLOCK_LONG_ON_UP\">\n                                            <option data-kid=\"1-1-3-3-2-2-1-3-2-3-2-1\" data-name=\"select option\" selected=\"\" value=\"\">\n                                            </option>\n                                            <option data-kid=\"1-1-3-3-2-2-1-3-2-3-2-2\" data-name=\"select option\" value=\"true\">\n                                                true\n                                            </option>\n                                            <option data-kid=\"1-1-3-3-2-2-1-3-2-3-2-3\" data-name=\"select option\" value=\"false\">\n                                                false\n                                            </option>\n                                        </select>\n                                    </label>\n                                </div>\n                            </fieldset>\n                            <fieldset class=\"min-w-0\" data-kid=\"1-1-3-3-2-2-1-4\" data-name=\"signal fieldset\">\n                                <legend class=\"mb-3 font-['Chakra_Petch',sans-serif] text-base font-semibold\" data-kid=\"1-1-3-3-2-2-1-4-1\" data-name=\"fieldset legend\">\n                                    Signal & Kelly sizing\n                                </legend>\n                                <div class=\"grid gap-3 sm:grid-cols-2\" data-kid=\"1-1-3-3-2-2-1-4-2\" data-name=\"fieldset fields container\">\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-4-2-1\" data-name=\"confidence input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-4-2-1-1\" data-name=\"field label\">\n                                            MIN_CONFIDENCE\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-4-2-1-2\" data-name=\"field input\" id=\"MIN_CONFIDENCE\" name=\"MIN_CONFIDENCE\" step=\"any\" type=\"number\"/>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-4-2-2\" data-name=\"ensemble agreement input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-4-2-2-1\" data-name=\"field label\">\n                                            MIN_ENSEMBLE_AGREEMENT\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-4-2-2-2\" data-name=\"field input\" id=\"MIN_ENSEMBLE_AGREEMENT\" name=\"MIN_ENSEMBLE_AGREEMENT\" step=\"any\" type=\"number\"/>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-4-2-3\" data-name=\"use kelly input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-4-2-3-1\" data-name=\"field label\">\n                                            USE_KELLY\n                                        </span>\n                                        <select class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#A79D79] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-4-2-3-2\" data-name=\"field select\" id=\"USE_KELLY\" name=\"USE_KELLY\">\n                                            <option data-kid=\"1-1-3-3-2-2-1-4-2-3-2-1\" data-name=\"select option\" selected=\"\" value=\"\">\n                                            </option>\n                                            <option data-kid=\"1-1-3-3-2-2-1-4-2-3-2-2\" data-name=\"select option\" value=\"true\">\n                                                true\n                                            </option>\n                                            <option data-kid=\"1-1-3-3-2-2-1-4-2-3-2-3\" data-name=\"select option\" value=\"false\">\n                                                false\n                                            </option>\n                                        </select>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-4-2-4\" data-name=\"kelly fraction input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-4-2-4-1\" data-name=\"field label\">\n                                            KELLY_FRACTION\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-4-2-4-2\" data-name=\"field input\" id=\"KELLY_FRACTION\" name=\"KELLY_FRACTION\" step=\"any\" type=\"number\"/>\n                                    </label>\n                                    <label class=\"block min-w-0 text-sm\" data-kid=\"1-1-3-3-2-2-1-4-2-5\" data-name=\"kelly min trades input label\">\n                                        <span class=\"mb-1.5 block\" data-kid=\"1-1-3-3-2-2-1-4-2-5-1\" data-name=\"field label\">\n                                            KELLY_MIN_TRADES\n                                        </span>\n                                        <input autocomplete=\"off\" class=\"w-full rounded-xl border border-[#554D34] bg-black px-3 py-2.5 text-[#EDCC69] outline-hidden focus:border-[#EDCC69]\" data-kid=\"1-1-3-3-2-2-1-4-2-5-2\" data-name=\"field input\" id=\"KELLY_MIN_TRADES\" name=\"KELLY_MIN_TRADES\" step=\"1\" type=\"number\"/>\n                                    </label>\n                                </div>\n                            </fieldset>\n                        </div>\n                        <div class=\"mt-6 flex flex-col gap-4 border-t border-[#554D34] pt-5 lg:flex-row lg:items-center lg:justify-between\" data-kid=\"1-1-3-3-2-2-2\" data-name=\"form actions container\">\n                            <div data-kid=\"1-1-3-3-2-2-2-1\" data-name=\"form footer info\">\n                                <p class=\"font-['Chakra_Petch',sans-serif] text-base font-semibold\" data-kid=\"1-1-3-3-2-2-2-1-1\" data-name=\"footer title\">\n                                    Changes take effect on next process start\n                                </p>\n                                <p class=\"mt-1 text-sm text-[#A79D79]\" data-kid=\"1-1-3-3-2-2-2-1-2\" data-name=\"footer instruction\">\n                                    Review and validate the draft before saving. Invalid values are not written.\n                                </p>\n                            </div>\n                            <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-1-3-3-2-2-2-2\" data-name=\"form buttons container\">\n                                <button class=\"rounded-md bg-[#EDCC69] px-5 py-2.5 font-['Chakra_Petch',sans-serif] text-sm font-semibold text-black\" data-kid=\"1-1-3-3-2-2-2-2-1\" data-name=\"validate button\" type=\"button\">\n                                    Review & validate draft\n                                </button>\n                                <button class=\"cursor-not-allowed rounded-md border border-[#554D34] px-5 py-2.5 font-['Chakra_Petch',sans-serif] text-sm font-semibold text-[#A79D79]\" data-kid=\"1-1-3-3-2-2-2-2-2\" data-name=\"save button\" disabled=\"\" type=\"button\">\n                                    Save validated settings\n                                </button>\n                            </div>\n                        </div>\n                    </form>\n                </div>\n            </section>\n            <section aria-labelledby=\"reason-catalog-title\" class=\"mt-6 border-y border-[#554D34] py-5\" data-kid=\"1-1-3-4\" data-name=\"reasons catalog section\">\n                <div class=\"flex flex-col gap-2 border-b border-[#554D34] pb-4 sm:flex-row sm:items-baseline sm:justify-between\" data-kid=\"1-1-3-4-1\" data-name=\"catalog header\">\n                    <h2 class=\"font-['Chakra_Petch',sans-serif] text-xl font-semibold\" data-kid=\"1-1-3-4-1-1\" data-name=\"catalog title\" id=\"reason-catalog-title\">\n                        Supported reasons catalog\n                    </h2>\n                    <p class=\"text-sm text-[#A79D79]\" data-kid=\"1-1-3-4-1-2\" data-name=\"catalog instruction\">\n                        Catalog only · not currently active · live runtime status: Not loaded\n                    </p>\n                </div>\n                <ul class=\"mt-4 grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4\" data-kid=\"1-1-3-4-2\" data-name=\"catalog items list\">\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-1\" data-name=\"catalog item\">\n                        APPROVED\n                    </li>\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-2\" data-name=\"catalog item\">\n                        CIRCUIT_BREAKER\n                    </li>\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-3\" data-name=\"catalog item\">\n                        HALTED\n                    </li>\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-4\" data-name=\"catalog item\">\n                        MAX_DRAWDOWN\n                    </li>\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-5\" data-name=\"catalog item\">\n                        POSITION_TOO_LARGE\n                    </li>\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-6\" data-name=\"catalog item\">\n                        TOO_MANY_LOSSES\n                    </li>\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-7\" data-name=\"catalog item\">\n                        HIGH_VOLATILITY\n                    </li>\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-8\" data-name=\"catalog item\">\n                        CORRELATION_GUARD\n                    </li>\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-9\" data-name=\"catalog item\">\n                        EVENT_RISK\n                    </li>\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-10\" data-name=\"catalog item\">\n                        MAX_TRADES\n                    </li>\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-11\" data-name=\"catalog item\">\n                        COOLDOWN\n                    </li>\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-12\" data-name=\"catalog item\">\n                        SPREAD_TOO_WIDE\n                    </li>\n                    <li class=\"font-mono text-sm\" data-kid=\"1-1-3-4-2-13\" data-name=\"catalog item\">\n                        MARKET_CLOSED\n                    </li>\n                </ul>\n            </section>\n            <footer class=\"flex flex-col gap-1 border-t border-[#554D34] py-5 text-sm text-[#A79D79] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-3-5\" data-name=\"footer bar\">\n                <p data-kid=\"1-1-3-5-1\" data-name=\"footer copyright notice\">\n                    Risk settings are validated configuration changes, not trade instructions.\n                </p>\n                <p data-kid=\"1-1-3-5-2\" data-name=\"footer additional disclaimer\">\n                    Frontend does not call broker or order functions.\n                </p>\n            </footer>\n        </main>\n    </div>\n</div>\n",
