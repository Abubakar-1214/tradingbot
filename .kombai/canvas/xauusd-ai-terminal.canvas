      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500;6..96,600&family=Josefin+Slab:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css');\n</style>\n<main class=\"min-h-full bg-[#1E000E] px-7 py-6 text-[#D6E6CA] md:px-10\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Josefin Slab',serif\">\n    <header data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"flex flex-wrap items-center justify-between gap-5 border-b border-[#3F2A2B] pb-5\" data-kid=\"1-1-1\" data-name=\"header information row\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and title group\">\n                <div class=\"grid h-11 w-11 shrink-0 place-items-center border border-[#C05746] text-xl text-[#EBA294]\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon\" style=\"font-family:'Bodoni Moda',serif\">\n                    Au\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"brand identification text\">\n                    <div class=\"text-lg font-semibold tracking-wide\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name\">\n                        NEOMIND\n                        <span class=\"text-[#ADC698]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"symbol ticker text\">\n                            / XAUUSD\n                        </span>\n                    </div>\n                    <div class=\"mt-1 text-[12px] text-[#ADC698]\" data-kid=\"1-1-1-1-2-2\" data-name=\"plane type description text\" style=\"font-family:'Space Mono',monospace\">\n                        MODEL CONTROL PLANE\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3 border-l border-[#6A4D4B] pl-4\" data-kid=\"1-1-1-2\" data-name=\"production status indicator\">\n                <i class=\"bx bx-lock-alt text-2xl text-[#EBA294]\" data-kid=\"1-1-1-2-1\" data-name=\"lock icon\">\n                </i>\n                <div data-kid=\"1-1-1-2-2\" data-name=\"status label and description group\">\n                    <div class=\"text-sm text-[#ADC698]\" data-kid=\"1-1-1-2-2-1\" data-name=\"status field label\">\n                        Production slot\n                    </div>\n                    <div class=\"mt-0.5 text-base font-semibold\" data-kid=\"1-1-1-2-2-2\" data-name=\"status field value\">\n                        No production manifest\n                    </div>\n                </div>\n            </div>\n        </div>\n        <nav aria-label=\"Shared navigation\" class=\"flex flex-wrap gap-x-8 gap-y-3 border-b border-[#3F2A2B] py-4 text-base\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n            <span class=\"text-[#ADC698]\" data-kid=\"1-1-2-1\" data-name=\"navigation link 1\">\n                Operations\n            </span>\n            <span class=\"text-[#ADC698]\" data-kid=\"1-1-2-2\" data-name=\"navigation link 2\">\n                Training\n            </span>\n            <span class=\"text-[#ADC698]\" data-kid=\"1-1-2-3\" data-name=\"navigation link 3\">\n                Prepare Run\n            </span>\n            <span aria-current=\"page\" class=\"border-b-2 border-[#C05746] pb-1 text-[#D6E6CA]\" data-kid=\"1-1-2-4\" data-name=\"current navigation page link\">\n                Models / Evaluation\n            </span>\n            <span class=\"text-[#ADC698]\" data-kid=\"1-1-2-5\" data-name=\"navigation link 5\">\n                Risk / Settings\n            </span>\n        </nav>\n    </header>\n    <section class=\"flex flex-wrap items-end justify-between gap-x-10 gap-y-6 py-7\" data-kid=\"1-2\" data-name=\"hero section\">\n        <div class=\"max-w-4xl\" data-kid=\"1-2-1\" data-name=\"hero description container\">\n            <h1 class=\"text-4xl leading-tight md:text-5xl\" data-kid=\"1-2-1-1\" data-name=\"hero page title\" style=\"font-family:'Bodoni Moda',serif\">\n                Evaluation archive\n            </h1>\n            <p class=\"mt-3 text-lg leading-relaxed text-[#ADC698]\" data-kid=\"1-2-1-2\" data-name=\"hero description text\">\n                Three verified records. Every evaluation is\n                <span class=\"font-semibold text-[#EBA294]\" data-kid=\"1-2-1-2-1\" data-name=\"status warning text\">\n                    NOT PROMOTABLE\n                </span>\n                ; no model has passed the promotion gate.\n            </p>\n        </div>\n        <div class=\"flex items-center gap-3 border border-[#C05746] bg-[#2B171D] px-5 py-4\" data-kid=\"1-2-2\" data-name=\"live activation status warning box\">\n            <i class=\"bx bx-lock-alt text-2xl text-[#EBA294]\" data-kid=\"1-2-2-1\" data-name=\"lock icon\">\n            </i>\n            <div data-kid=\"1-2-2-2\" data-name=\"warning text group\">\n                <div class=\"text-base font-bold text-[#EBA294]\" data-kid=\"1-2-2-2-1\" data-name=\"warning title\">\n                    Live activation blocked\n                </div>\n                <div class=\"mt-1 text-sm text-[#D6E6CA]\" data-kid=\"1-2-2-2-2\" data-name=\"warning description\">\n                    No production manifest · no live model activation\n                </div>\n            </div>\n        </div>\n    </section>\n    <section aria-labelledby=\"gate-title\" class=\"mb-7 border border-[#6A4D4B] bg-[#26392E]\" data-kid=\"1-3\" data-name=\"promotion thresholds section\">\n        <div class=\"flex flex-wrap items-baseline justify-between gap-3 border-b border-[#6A4D4B] bg-[#3A5743] px-5 py-3\" data-kid=\"1-3-1\" data-name=\"threshold section header\">\n            <h2 class=\"text-xl font-semibold\" data-kid=\"1-3-1-1\" data-name=\"threshold section title\" id=\"gate-title\">\n                Promotion thresholds\n            </h2>\n            <p class=\"text-sm text-[#D6E6CA]\" data-kid=\"1-3-1-2\" data-name=\"threshold section instruction text\">\n                All four conditions must be met in the same evaluation.\n            </p>\n        </div>\n        <div class=\"grid grid-cols-2 md:grid-cols-4\" data-kid=\"1-3-2\" data-name=\"threshold conditions grid\">\n            <div class=\"border-b border-r border-[#6A4D4B] px-5 py-4 md:border-b-0\" data-kid=\"1-3-2-1\" data-name=\"threshold metric card 1\">\n                <div class=\"text-sm text-[#ADC698]\" data-kid=\"1-3-2-1-1\" data-name=\"metric card label\">\n                    Sharpe ratio\n                </div>\n                <div class=\"mt-1 text-lg font-semibold\" data-kid=\"1-3-2-1-2\" data-name=\"metric card value\">\n                    ≥ 0.5\n                </div>\n            </div>\n            <div class=\"border-b border-[#6A4D4B] px-5 py-4 md:border-b-0 md:border-r\" data-kid=\"1-3-2-2\" data-name=\"threshold metric card 2\">\n                <div class=\"text-sm text-[#ADC698]\" data-kid=\"1-3-2-2-1\" data-name=\"metric card label\">\n                    Maximum drawdown\n                </div>\n                <div class=\"mt-1 text-lg font-semibold\" data-kid=\"1-3-2-2-2\" data-name=\"metric card value\">\n                    ≤ 20%\n                </div>\n            </div>\n            <div class=\"border-r border-[#6A4D4B] px-5 py-4\" data-kid=\"1-3-2-3\" data-name=\"threshold metric card 3\">\n                <div class=\"text-sm text-[#ADC698]\" data-kid=\"1-3-2-3-1\" data-name=\"metric card label\">\n                    Recorded trades\n                </div>\n                <div class=\"mt-1 text-lg font-semibold\" data-kid=\"1-3-2-3-2\" data-name=\"metric card value\">\n                    ≥ 20\n                </div>\n            </div>\n            <div class=\"px-5 py-4\" data-kid=\"1-3-2-4\" data-name=\"threshold metric card 4\">\n                <div class=\"text-sm text-[#ADC698]\" data-kid=\"1-3-2-4-1\" data-name=\"metric card label\">\n                    Total return\n                </div>\n                <div class=\"mt-1 text-lg font-semibold\" data-kid=\"1-3-2-4-2\" data-name=\"metric card value\">\n                    > 0%\n                </div>\n            </div>\n        </div>\n    </section>\n    <section aria-labelledby=\"records-title\" data-kid=\"1-4\" data-name=\"evaluation records section\">\n        <div class=\"mb-3 flex flex-wrap items-baseline justify-between gap-3\" data-kid=\"1-4-1\" data-name=\"records section header\">\n            <h2 class=\"text-2xl font-semibold\" data-kid=\"1-4-1-1\" data-name=\"records section title\" id=\"records-title\">\n                Evaluation records\n            </h2>\n            <p class=\"text-sm text-[#ADC698]\" data-kid=\"1-4-1-2\" data-name=\"records section description text\">\n                Source values shown with their individual threshold checks.\n            </p>\n        </div>\n        <div class=\"overflow-x-auto border border-[#6A4D4B] bg-[#26392E]\" data-kid=\"1-4-2\" data-name=\"records table container\">\n            <div class=\"min-w-[1050px]\" data-kid=\"1-4-2-1\" data-name=\"records table grid\">\n                <div class=\"grid grid-cols-[2.45fr_0.85fr_0.9fr_0.85fr_1.2fr_1.45fr] border-b border-[#6A4D4B] bg-[#3A5743] px-5 py-3 text-sm font-semibold\" data-kid=\"1-4-2-1-1\" data-name=\"table header row\">\n                    <div data-kid=\"1-4-2-1-1-1\" data-name=\"header title 1\">\n                        Model artifact\n                    </div>\n                    <div data-kid=\"1-4-2-1-1-2\" data-name=\"header title 2\">\n                        Sharpe\n                    </div>\n                    <div data-kid=\"1-4-2-1-1-3\" data-name=\"header title 3\">\n                        Max DD\n                    </div>\n                    <div data-kid=\"1-4-2-1-1-4\" data-name=\"header title 4\">\n                        Trades\n                    </div>\n                    <div data-kid=\"1-4-2-1-1-5\" data-name=\"header title 5\">\n                        Total return\n                    </div>\n                    <div data-kid=\"1-4-2-1-1-6\" data-name=\"header title 6\">\n                        Evaluation result\n                    </div>\n                </div>\n                <article class=\"border-b border-[#6A4D4B]\" data-kid=\"1-4-2-1-2\" data-name=\"evaluation record row 1\">\n                    <div class=\"grid grid-cols-[2.45fr_0.85fr_0.9fr_0.85fr_1.2fr_1.45fr] items-start gap-y-3 px-5 py-5\" data-kid=\"1-4-2-1-2-1\" data-name=\"evaluation data summary section\">\n                        <div class=\"pr-5\" data-kid=\"1-4-2-1-2-1-1\" data-name=\"model name and status group\">\n                            <h3 class=\"break-all text-lg font-semibold\" data-kid=\"1-4-2-1-2-1-1-1\" data-name=\"model name title\">\n                                Dreamer_20261003T230304213562Z\n                            </h3>\n                            <p class=\"mt-1 text-sm text-[#ADC698]\" data-kid=\"1-4-2-1-2-1-1-2\" data-name=\"model passing status container\">\n                                Dreamer · passed:\n                                <span class=\"text-[#EBA294]\" data-kid=\"1-4-2-1-2-1-1-2-1\" data-name=\"passing status value\">\n                                    false\n                                </span>\n                            </p>\n                        </div>\n                        <div class=\"text-lg font-semibold\" data-kid=\"1-4-2-1-2-1-2\" data-name=\"metric value 1\" style=\"font-family:'Space Mono',monospace\">\n                            3.1047\n                            <div class=\"mt-1 font-normal text-[12px] text-[#ADC698]\" data-kid=\"1-4-2-1-2-1-2-1\" data-name=\"metric explanation 1\" style=\"font-family:'Josefin Slab',serif\">\n                                ≥ 0.5 · meets\n                            </div>\n                        </div>\n                        <div class=\"text-lg font-semibold\" data-kid=\"1-4-2-1-2-1-3\" data-name=\"metric value 2\" style=\"font-family:'Space Mono',monospace\">\n                            3.0393%\n                            <div class=\"mt-1 font-normal text-[12px] text-[#ADC698]\" data-kid=\"1-4-2-1-2-1-3-1\" data-name=\"metric explanation 2\" style=\"font-family:'Josefin Slab',serif\">\n                                ≤ 20% · meets\n                            </div>\n                        </div>\n                        <div class=\"text-lg font-semibold text-[#EBA294]\" data-kid=\"1-4-2-1-2-1-4\" data-name=\"metric value 3\" style=\"font-family:'Space Mono',monospace\">\n                            3\n                            <div class=\"mt-1 font-normal text-[12px] text-[#EBA294]\" data-kid=\"1-4-2-1-2-1-4-1\" data-name=\"metric explanation 3\" style=\"font-family:'Josefin Slab',serif\">\n                                of 20 · fails\n                            </div>\n                        </div>\n                        <div class=\"text-lg font-semibold\" data-kid=\"1-4-2-1-2-1-5\" data-name=\"metric value 4\" style=\"font-family:'Space Mono',monospace\">\n                            +6.0418%\n                            <div class=\"mt-1 font-normal text-[12px] text-[#ADC698]\" data-kid=\"1-4-2-1-2-1-5-1\" data-name=\"metric explanation 4\" style=\"font-family:'Josefin Slab',serif\">\n                                > 0% · meets\n                            </div>\n                            <div class=\"mt-2 text-sm font-normal text-[#ADC698]\" data-kid=\"1-4-2-1-2-1-5-2\" data-name=\"benchmark comparison text\" style=\"font-family:'Josefin Slab',serif\">\n                                Benchmark −5.4743%\n                            </div>\n                        </div>\n                        <div data-kid=\"1-4-2-1-2-1-6\" data-name=\"overall evaluation result container\">\n                            <div class=\"font-bold text-[#EBA294]\" data-kid=\"1-4-2-1-2-1-6-1\" data-name=\"result status headline\">\n                                NOT PROMOTABLE\n                            </div>\n                            <p class=\"mt-1 text-sm leading-snug\" data-kid=\"1-4-2-1-2-1-6-2\" data-name=\"failure reason description\">\n                                Fails trade count: 3 recorded; 20 required.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex min-w-0 flex-wrap gap-x-8 gap-y-4 border-t border-[#6A4D4B] bg-[#302427] px-5 py-4 text-sm\" data-kid=\"1-4-2-1-2-2\" data-name=\"evaluation metadata section\">\n                        <div class=\"min-w-[220px] flex-[2]\" data-kid=\"1-4-2-1-2-2-1\" data-name=\"metadata group 1\">\n                            <div class=\"text-[#ADC698]\" data-kid=\"1-4-2-1-2-2-1-1\" data-name=\"metadata label 1\">\n                                Source file\n                            </div>\n                            <div class=\"mt-1 break-all text-[12px] leading-relaxed\" data-kid=\"1-4-2-1-2-2-1-2\" data-name=\"metadata value 1\" style=\"font-family:'Space Mono',monospace\">\n                                artifacts/models/dreamer_20261003T230304213562Z/evaluation.json\n                            </div>\n                        </div>\n                        <div class=\"min-w-[230px] flex-[1.5]\" data-kid=\"1-4-2-1-2-2-2\" data-name=\"metadata group 2\">\n                            <div class=\"text-[#ADC698]\" data-kid=\"1-4-2-1-2-2-2-1\" data-name=\"metadata label 2\">\n                                Evaluated at (UTC)\n                            </div>\n                            <div class=\"mt-1 text-[12px] leading-relaxed\" data-kid=\"1-4-2-1-2-2-2-2\" data-name=\"metadata value 2\" style=\"font-family:'Space Mono',monospace\">\n                                2026-10-03T23:03:23.483202+00:00\n                            </div>\n                        </div>\n                        <div class=\"min-w-[350px] flex-[2.6]\" data-kid=\"1-4-2-1-2-2-3\" d