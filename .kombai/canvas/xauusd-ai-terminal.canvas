         PASS\n                                    </div>\n                                </td>\n                                <td class=\"border border-[#8f0000] bg-[#310400] px-3 py-3 align-top\" data-kid=\"1-2-2-3-2-1-3-1-4\" data-name=\"trades result cell\">\n                                    <div class=\"text-[#ff8585]\" data-kid=\"1-2-2-3-2-1-3-1-4-1\" data-name=\"trades value\">\n                                        3\n                                    </div>\n                                    <div class=\"mt-1 text-[10px] text-[#ff8585]\" data-kid=\"1-2-2-3-2-1-3-1-4-2\" data-name=\"trades status\">\n                                        FAIL · < 20\n                                    </div>\n                                </td>\n                                <td class=\"border border-[#30380b] px-3 py-3 align-top\" data-kid=\"1-2-2-3-2-1-3-1-5\" data-name=\"return result cell\">\n                                    <div class=\"text-[#deff00]\" data-kid=\"1-2-2-3-2-1-3-1-5-1\" data-name=\"return value\">\n                                        +6.0418%\n                                    </div>\n                                    <div class=\"mt-1 text-[10px] text-[#deff00]/75\" data-kid=\"1-2-2-3-2-1-3-1-5-2\" data-name=\"return status\">\n                                        PASS\n                                    </div>\n                                </td>\n                                <td class=\"border border-[#8f0000] bg-[#310400] px-3 py-3 align-top\" data-kid=\"1-2-2-3-2-1-3-1-6\" data-name=\"evaluation gate result cell\">\n                                    <div class=\"font-bold leading-5 text-[#ff8585]\" data-kid=\"1-2-2-3-2-1-3-1-6-1\" data-name=\"gate outcome text\">\n                                        NOT PROMOTABLE\n                                    </div>\n                                    <div class=\"mt-1 font-['Saira'] text-xs text-white/90\" data-kid=\"1-2-2-3-2-1-3-1-6-2\" data-name=\"failure rea