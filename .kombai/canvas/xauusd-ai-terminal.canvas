      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Cuprum:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n.cp{font-family:'Chakra Petch',sans-serif}.cu{font-family:'Cuprum',sans-serif}\n.chart-scroll::-webkit-scrollbar{height:5px}.chart-scroll::-webkit-scrollbar-thumb{background:#554d34}.chart-scroll::-webkit-scrollbar-track{background:#0d0a03}\n@media(max-width:900px){.shell-nav{flex-wrap:wrap}.workbench{grid-template-columns:minmax(0,1fr)}.status-items{flex-wrap:wrap}.readings{grid-template-columns:1fr 1fr}}\n@media(max-width:620px){.shell-nav{display:grid;grid-template-columns:1fr 1fr}.readings{grid-template-columns:1fr}.gate-grid{grid-template-columns:1fr 1fr}.chart-tools{min-width:700px}}\n</style>\n<div class=\"cp min-h-full bg-[#080806] text-[#eee5c7]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#554d34] bg-[#0d0a03]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-x-8 gap-y-2 px-5 py-3\" data-kid=\"1-1-1\" data-name=\"header layout wrapper\">\n            <a aria-label=\"XAUUSD AI terminal home\" class=\"flex items-center gap-3 no-underline\" data-kid=\"1-1-1-1\" data-name=\"logo and brand link\" href=\"#operations\">\n                <span class=\"flex h-9 w-9 items-center justify-center border border-[#edcc69] text-[13px] font-bold text-[#edcc69]\" data-kid=\"1-1-1-1-1\" data-name=\"brand initials box\">\n                    XA\n                </span>\n                <span class=\"text-[17px] font-semibold tracking-wide\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    XAUUSD\n                    <span class=\"text-[#8e8468]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand suffix text\">\n                        AI TERMINAL\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Application\" class=\"shell-nav flex items-center gap-1 text-[14px]\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n                <a aria-current=\"page\" class=\"border-b-2 border-[#edcc69] px-3 py-3 font-semibold text-[#edcc69]\" data-kid=\"1-1-1-2-1\" data-name=\"active operations nav link\" href=\"#operations\">\n                    Operations\n                </a>\n                <a class=\"px-3 py-3 text-[#b5aa89]\" data-kid=\"1-1-1-2-2\" data-name=\"training nav link\" href=\"#training\">\n                    Training\n                </a>\n                <a class=\"px-3 py-3 text-[#b5aa89]\" data-kid=\"1-1-1-2-3\" data-name=\"prepare run nav link\" href=\"#prepare-run\">\n                    Prepare Run\n                </a>\n                <a class=\"px-3 py-3 text-[#b5aa89]\" data-kid=\"1-1-1-2-4\" data-name=\"models evaluation nav link\" href=\"#models-evaluation\">\n                    Models / Evaluation\n                </a>\n                <a class=\"px-3 py-3 text-[#b5aa89]\" data-kid=\"1-1-1-2-5\" data-name=\"risk settings nav link\" href=\"#risk-settings\">\n                    Risk / Settings\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2 text-[13px] text-[#a49a7b]\" data-kid=\"1-1-1-3\" data-name=\"system status indicator\">\n                <i class=\"ph ph-desktop-tower text-[18px]\" data-kid=\"1-1-1-3-1\" data-name=\"desktop tower icon\">\n                </i>\n                <span data-kid=\"1-1-1-3-2\" data-name=\"system status text\">\n                    Local control plane\n                </span>\n            </div>\n        </div>\n    </header>\n    <section aria-label=\"Persistent system status\" class=\"status-items flex items-center gap-x-6 gap-y-2 border-b border-[#554d34] bg-[#171309] px-5 py-2.5 text-[13px]\" data-kid=\"1-2\" data-name=\"persistent status section\">\n        <div class=\"flex items-center gap-2\" data-kid=\"1-2-1\" data-name=\"trading mode indicator\">\n            <span class=\"border border-[#7b8a68] bg-[#7b8a68] px-2.5 py-1 font-bold text-[#080806]\" data-kid=\"1-2-1-1\" data-name=\"mode label tag\">\n                DEMO\n            </span>\n            <span class=\"text-[#b8ad8e]\" data-kid=\"1-2-1-2\" data-name=\"mode status text\">\n                TRADING_MODE default\n            </span>\n        </div>\n        <span class=\"flex items-center gap-2 text-[#f4a9a9]\" data-kid=\"1-2-2\" data-name=\"trading blocked status group\">\n            <i class=\"ph ph-prohibit text-[17px]\" data-kid=\"1-2-2-1\" data-name=\"prohibit icon\">\n            </i>\n            <strong data-kid=\"1-2-2-2\" data-name=\"status alert text\">\n                MODEL-DRIVEN TRADING BLOCKED\n            </strong>\n        </span>\n        <span class=\"text-[#b8ad8e]\" data-kid=\"1-2-3\" data-name=\"kill-switch file status\">\n            KILL-SWITCH FILE\n            <strong class=\"text-[#edcc69]\" data-kid=\"1-2-3-1\" data-name=\"kill-switch status value text\">\n                ABSENT · baseline\n            </strong>\n        </span>\n        <span class=\"ml-auto text-[#b8ad8e]\" data-kid=\"1-2-4\" data-name=\"supervisor status\">\n            SUPERVISOR\n            <strong class=\"text-[#eee5c7]\" data-kid=\"1-2-4-1\" data-name=\"supervisor status value\">\n                UNAVAILABLE\n            </strong>\n        </span>\n    </section>\n    <main class=\"mx-auto max-w-[1440px] space-y-4 px-5 py-5\" data-kid=\"1-3\" data-name=\"operations main content area\" id=\"operations\">\n        <section aria-labelledby=\"permission-title\" class=\"border border-[#7a5550] bg-[#120a0a] px-5 py-4\" data-kid=\"1-3-1\" data-name=\"permission alert section\">\n            <div class=\"flex flex-wrap items-start justify-between gap-4\" data-kid=\"1-3-1-1\" data-name=\"permission header container\">\n                <div class=\"flex min-w-[250px] flex-1 items-start gap-3\" data-kid=\"1-3-1-1-1\" data-name=\"alert message container\">\n                    <i class=\"ph ph-prohibit mt-1 text-[25px] text-[#f4a9a9]\" data-kid=\"1-3-1-1-1-1\" data-name=\"prohibit icon\">\n                    </i>\n                    <div data-kid=\"1-3-1-1-1-2\" data-name=\"alert text container\">\n                        <h1 class=\"text-[25px] font-semibold leading-tight text-[#f4a9a9]\" data-kid=\"1-3-1-1-1-2-1\" data-name=\"alert title\" id=\"permission-title\">\n                            Model-driven trading blocked\n                        </h1>\n                        <p class=\"mt-1 text-[14px] text-[#c2b79a]\" data-kid=\"1-3-1-1-1-2-2\" data-name=\"alert description text\">\n                            No production manifest is available. A model-driven live start is not permitted.\n                        </p>\n                    </div>\n                </div>\n                <button aria-disabled=\"true\" class=\"cursor-not-allowed rounded-full border border-[#514943] bg-[#171412] px-5 py-2.5 text-[14px] font-semibold text-[#706b63] opacity-70\" data-kid=\"1-3-1-1-2\" data-name=\"disabled start live button\" disabled=\"\" type=\"button\">\n                    Start live\n                    <i class=\"ph ph-lock-simple ml-1\" data-kid=\"1-3-1-1-2-1\" data-name=\"lock icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"gate-grid mt-4 grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] border-t border-[#47362f] pt-3\" data-kid=\"1-3-1-2\" data-name=\"permission gate grid\">\n                <div class=\"border-r border-[#47362f] pr-4\" data-kid=\"1-3-1-2-1\" data-name=\"trading mode gate item\">\n                    <div class=\"text-[12px] text-[#a49a7b]\" data-kid=\"1-3-1-2-1-1\" data-name=\"label text\">\n                        TRADING MODE\n                    </div>\n                    <div class=\"cu mt-1 text-[17px] font-bold text-[#7b8a68]\" data-kid=\"1-3-1-2-1-2\" data-name=\"value text\">\n                        DEMO\n                    </div>\n                </div>\n                <div class=\"border-r border-[#47362f] px-4\" data-kid=\"1-3-1-2-2\" data-name=\"require promoted model item\">\n                    <div class=\"text-[12px] text-[#a49a7b]\" data-kid=\"1-3-1-2-2-1\" data-name=\"label text\">\n                        REQUIRE_PROMOTED_MODEL\n                    </div>\n                    <div class=\"cu mt-1 text-[17px] font-bold\" data-kid=\"1-3-1-2-2-2\" data-name=\"value text\">\n                        true\n                    </div>\n                </div>\n                <div class=\"border-r border-[#47362f] px-4\" data-kid=\"1-3-1-2-3\" data-name=\"production manifest item\">\n                    <div class=\"text-[12px] text-[#a49a7b]\" data-kid=\"1-3-1-2-3-1\" data-name=\"label text\">\n                        PRODUCTION MANIFEST\n                    </div>\n                    <div class=\"mt-1 text-[14px] font-semibold text-[#f4a9a9]\" data-kid=\"1-3-1-2-3-2\" data-name=\"value text\">\n                        Not present\n                    </div>\n                </div>\n                <div class=\"pl-4\" data-kid=\"1-3-1-2-4\" data-name=\"passed evaluation item\">\n                    <div class=\"text-[12px] text-[#a49a7b]\" data-kid=\"1-3-1-2-4-1\" data-name=\"label text\">\n                        PASSED EVALUATION\n                    </div>\n                    <div class=\"mt-1 text-[14px] font-semibold text-[#f4a9a9]\" data-kid=\"1-3-1-2-4-2\" data-name=\"value text\">\n                        None\n                    </div>\n                </div>\n            </div>\n            <p class=\"mt-3 border-t border-[#47362f] pt-3 text-[13px] text-[#c2b79a]\" data-kid=\"1-3-1-3\" data-name=\"permission detail note\">\n                <span class=\"font-semibold text-[#f4a9a9]\" data-kid=\"1-3-1-3-1\" data-name=\"note label text\">\n                    Live start disabled:\n                </span>\n                missing\n                <code class=\"cu text-[#eee5c7]\" data-kid=\"1-3-1-3-2\" data-name=\"code snippet text\">\n                    artifacts/models/production/manifest.json\n                </code>\n                . No inspected model evaluation has passed the promotion gate.\n            </p>\n        </section>\n        <section aria-label=\"Historical chart workbench and evidence\" class=\"workbench grid grid-cols-[minmax(0,1fr)_320px] items-start gap-4\" data-kid=\"1-3-2\" data-name=\"workbench section\">\n            <div class=\"min-w-0 overflow-hidden border border-[#554d34] bg-[#0d0a03]\" data-kid=\"1-3-2-1\" data-name=\"chart workbench container\">\n                <div class=\"flex flex-wrap items-center justify-between gap-2 border-b border-[#554d34] px-3 py-2\" data-kid=\"1-3-2-1-1\" data-name=\"chart toolbar container\">\n                    <div class=\"chart-scroll flex max-w-full items-center gap-1 overflow-x-auto whitespace-nowrap text-[13px]\" data-kid=\"1-3-2-1-1-1\" data-name=\"chart settings group\">\n                        <button class=\"rounded-full border border-[#7a6b42] bg-[#1c170a] px-3 py-1.5 font-semibold text-[#edcc69]\" data-kid=\"1-3-2-1-1-1-1\" data-name=\"ticker dropdown button\" type=\"button\">\n                            XAUUSD\n                            <i class=\"ph ph-caret-down\" data-kid=\"1-3-2-1-1-1-1-1\" data-name=\"caret down icon\">\n                            </i>\n                        </button>\n                        <button class=\"rounded-full border border-[#554d34] px-3 py-1.5 text-[#eee5c7]\" data-kid=\"1-3-2-1-1-1-2\" data-name=\"timeframe button\" type=\"button\">\n                            H1\n                            <i class=\"ph ph-caret-down\" data-kid=\"1-3-2-1-1-1-2-1\" data-name=\"caret down icon\">\n                            </i>\n                        </button>\n                        <span class=\"mx-1 h-5 border-l border-[#554d34]\" data-kid=\"1-3-2-1-1-1-3\" data-name=\"separator line\">\n                        </span>\n                        <button class=\"rounded-full px-2.5 py-1.5 text-[#eee5c7]\" data-kid=\"1-3-2-1-1-1-4\" data-name=\"candle display button\" type=\"button\">\n                            Candles\n                            <i class=\"ph ph-caret-down\" data-kid=\"1-3-2-1-1-1-4-1\" data-name=\"caret down icon\">\n                            </i>\n                        </button>\n                        <button class=\"rounded-full px-2.5 py-1.5 text-[#b8ad8e]\" data-kid=\"1-3-2-1-1-1-5\" data-name=\"indicators button\" type=\"button\">\n                            Indicators\n                            <i class=\"ph ph-plus\" data-kid=\"1-3-2-1-1-1-5-1\" data-name=\"plus icon\">\n                            </i>\n                        </button>\n                        <button class=\"rounded-full px-2.5 py-1.5 text-[#b8ad8e]\" data-kid=\"1-3-2-1-1-1-6\" data-name=\"layout button\" type=\"button\">\n                            Layout\n                            <i class=\"ph ph-squares-four\" data-kid=\"1-3-2-1-1-1-6-1\" data-name=\"squares four icon\">\n                            </i>\n                        </button>\n                        <span class=\"mx-1 h-5 border-l border-[#554d34]\" data-kid=\"1-3-2-1-1-1-7\" data-name=\"separator line\">\n                        </span>\n                        <button aria-label=\"Undo\" class=\"px-2 py-1.5 text-[#b8ad8e]\" data-kid=\"1-3-2-1-1-1-8\" data-name=\"undo button\" type=\"button\">\n                            <i class=\"ph ph-arrow-u-up-left text-[17px]\" data-kid=\"1-3-2-1-1-1-8-1\" data-name=\"undo icon\">\n                            </i>\n                        </button>\n                        <button aria-label=\"Redo\" class=\"px-2 py-1.5 text-[#6f674f]\" data-kid=\"1-3-2-1-1-1-9\" data-name=\"redo button\" type=\"button\">\n                            <i class=\"ph ph-arrow-u-up-right text-[17px]\" data-kid=\"1-3-2-1-1-1-9-1\" data-name=\"redo icon\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"flex items-center gap-1 text-[12px]\" data-kid=\"1-3-2-1-1-2\" data-name=\"view settings button group\">\n                        <button class=\"border border-[#554d34] px-2.5 py-1.5 text-[#b8ad8e]\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"object tree button\" type=\"button\">\n                            <i class=\"ph ph-list-bullets mr-1\" data-kid=\"1-3-2-1-1-2-1-1\" data-name=\"list bullets icon\">\n                            </i>\n                            Object tree\n                        </button>\n                        <button class=\"border border-[#edcc69] bg-[#1c170a] px-2.5 py-1.5 text-[#edcc69]\" data-kid=\"1-3-2-1-1-2-2\" data-name=\"data window button\" type=\"button\">\n                            <i class=\"ph ph-chart-line-up mr-1\" data-kid=\"1-3-2-1-1-2-2-1\" data-name=\"chart line icon\">\n                            </i>\n                            Data window\n                        </button>\n                        <button aria-label=\"Chart settings\" class=\"border border-[#554d34] px-2.5 py-1.5 text-[#b8ad8e]\" data-kid=\"1-3-2-1-1-2-3\" data-name=\"chart settings button\" type=\"button\">\n                            <i class=\"ph ph-gear-six text-[16px]\" data-kid=\"1-3-2-1-1-2-3-1\" data-name=\"gear icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"chart-scroll flex overflow-x-auto\" data-kid=\"1-3-2-1-2\" data-name=\"chart view container\">\n                    <aside aria-label=\"Drawing tools\" class=\"shrink-0 border-r border-[#302a1b] bg-[#0b0905] px-1.5 py-2\" data-kid=\"1-3-2-1-2-1\" data-name=\"drawing tools panel\">\n                        <div class=\"flex flex-col items-center gap-1 text-[19px] text-[#a79b78]\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"drawing tools button list\">\n                            <button class=\"flex h-8 w-8 items-center justify-center bg-[#282112] text-[#edcc69]\" data-kid=\"1-3-2-1-2-1-1-1\" data-name=\"cursor tool button\" title=\"Cursor\">\n                                <i class=\"ph ph-cursor\" data-kid=\"1-3-2-1-2-1-1-1-1\" data-name=\"cursor icon\">\n                                </i>\n                            </button>\n                            <button class=\"h-8 w-8\" data-kid=\"1-3-2-1-2-1-1-2\" data-name=\"trend line button\" title=\"Trend line\">\n                                <i class=\"ph ph-pencil-line\" data-kid=\"1-3-2-1-2-1-1-2-1\" data-name=\"pencil line icon\">\n                                </i>\n                            </button>\n                            <button class=\"h-8 w-8\" data-kid=\"1-3-2-1-2-1-1-3\" data-name=\"horizontal line button\" title=\"Horizontal line\">\n                                <i class=\"ph ph-minus\" data-kid=\"1-3-2-1-2-1-1-3-1\" data-name=\"minus icon\">\n                                </i>\n                            </button>\n                            <button class=\"h-8 w-8\" data-kid=\"1-3-2-1-2-1-1-4\" data-name=\"vertical line button\" title=\"Vertical line\">\n                                <i class=\"ph ph-line-vertical\" data-kid=\"1-3-2-1-2-1-1-4-1\" data-name=\"line vertical icon\">\n                                </i>\n                            </button>\n                            <button class=\"h-8 w-8\" data-kid=\"1-3-2-1-2-1-1-5\" data-name=\"ray button\" title=\"Ray\">\n                                <i class=\"ph ph-arrow-up-right\" data-kid=\"1-3-2-1-2-1-1-5-1\" data-name=\"arrow up right icon\">\n                                </i>\n                            </button>\n                            <button class=\"h-8 w-8\" data-kid=\"1-3-2-1-2-1-1-6\" data-name=\"rectangle button\" title=\"Rectangle\">\n                                <i class=\"ph ph-square\" data-kid=\"1-3-2-1-2-1-1-6-1\" data-name=\"square icon\">\n                                </i>\n                            </button>\n                            <button class=\"h-8 w-8\" data-kid=\"1-3-2-1-2-1-1-7\" data-name=\"measure button\" title=\"Measure\">\n                                <i class=\"ph ph-arrows-out-line-horizontal\" data-kid=\"1-3-2-1-2-1-1-7-1\" data-name=\"arrows out icon\">\n                                </i>\n                            </button>\n                            <button class=\"h-8 w-8\" data-kid=\"1-3-2-1-2-1-1-8\" data-name=\"text button\" title=\"Text\">\n                                <i class=\"ph ph-text-t\" data-kid=\"1-3-2-1-2-1-1-8-1\" data-name=\"text T icon\">\n                                </i>\n                            </button>\n                            <button class=\"h-8 w-8\" data-kid=\"1-3-2-1-2-1-1-9\" data-name=\"magnet button\" title=\"Magnet mode\">\n                                <i class=\"ph ph-magnet\" data-kid=\"1-3-2-1-2-1-1-9-1\" data-name=\"magnet icon\">\n                                </i>\n                            </button>\n                            <button class=\"h-8 w-8\" data-kid=\"1-3-2-1-2-1-1-10\" data-name=\"pin button\" title=\"Stay in drawing mode\">\n                                <i class=\"ph ph-push-pin\" data-kid=\"1-3-2-1-2-1-1-10-1\" data-name=\"pin icon\">\n                                </i>\n                            </button>\n                            <button class=\"h-8 w-8\" data-kid=\"1-3-2-1-2-1-1-11\" data-name=\"eraser button\" title=\"Remove drawings\">\n                                <i class=\"ph ph-eraser\" data-kid=\"1-3-2-1-2-1-1-11-1\" data-name=\"eraser icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </aside>\n                    <div class=\"min-w-[680px] flex-1\" data-kid=\"1-3-2-1-2-2\" data-name=\"chart drawing area\">\n                        <div class=\"flex min-h-10 flex-wrap items-center gap-x-3 gap-y-1 border-b border-[#302a1b] px-3 py-2 text-[12px]\" data-kid=\"1-3-2-1-2-2-1\" data-name=\"chart status bar\">\n                            <span class=\"font-semibold text-[#eee5c7]\" data-kid=\"1-3-2-1-2-2-1-1\" data-name=\"chart info label\">\n                                XAUUSD · H1\n                            </span>\n                            <span class=\"text-[#9a906f]\" data-kid=\"1-3-2-1-2-2-1-2\" data-name=\"data mode status\">\n                                HISTORICAL\n                            </span>\n                            <span class=\"cu text-[13px] text-[#c5bb9b]\" data-kid=\"1-3-2-1-2-2-1-3\" data-name=\"ohlc info text\">\n                                O 4,313.305　H 4,318.719　L 4,306.835　C\n                                <strong class=\"text-[#edcc69]\" data-kid=\"1-3-2-1-2-2-1-3-1\" data-name=\"close price value\">\n                                    4,318.679\n                                </strong>\n                            </span>\n                            <span class=\"ml-auto text-[#8e8468]\" data-kid=\"1-3-2-1-2-2-1-4\" data-name=\"indicators info text\">\n                                No indicator overlays\n                            </span>\n                        </div>\n                        <div class=\"relative bg-[#090907]\" data-kid=\"1-3-2-1-2-2-2\" data-name=\"chart graphic container\">\n                            <svg aria-label=\"Twelve historical XAUUSD H1 candles from December 31, 2025, with volume pane and price and time axes\" class=\"block h-[370px] w-full\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-2-2-1\" data-name=\"gold chart svg\" data-reason=\"chart elements generated by script\" id=\"gold-chart\" preserveaspectratio=\"none\" role=\"img\" viewbox=\"0 0 1000 410\">\n                            </svg>\n                        </div>\n                        <div class=\"flex flex-wrap items-center justify-between gap-2 border-t border-[#302a1b] px-3 py-2 text-[12px]\" data-kid=\"1-3-2-1-2-2-3\" data-name=\"chart controls bar\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-1-2-2-3-1\" data-name=\"volume label group\">\n                                <span class=\"font-semibold text-[#cfc39e]\" data-kid=\"1-3-2-1-2-2-3-1-1\" data-name=\"volume text\">\n                                    Volume\n                                </span>\n                                <span class=\"text-[#7b8a68]\" data-kid=\"1-3-2-1-2-2-3-1-2\" data-name=\"volume info text\">\n                                    H1 · historical bars\n                                </span>\n                            </div>\n                            <div class=\"flex items-center gap-2 text-[#a79b78]\" data-kid=\"1-3-2-1-2-2-3-2\" data-name=\"playback control group\">\n                                <button class=\"border border-[#554d34] px-2 py-1\" data-kid=\"1-3-2-1-2-2-3-2-1\" data-name=\"skip back button\" type=\"button\">\n                                    <i class=\"ph ph-skip-back\" data-kid=\"1-3-2-1-2-2-3-2-1-1\" data-name=\"skip back icon\">\n                                    </i>\n                                </button>\n                                <button class=\"border border-[#554d34] px-2 py-1\" data-kid=\"1-3-2-1-2-2-3-2-2\" data-name=\"play button\" type=\"button\">\n                                    <i class=\"ph ph-play\" data-kid=\"1-3-2-1-2-2-3-2-2-1\" data-name=\"play icon\">\n                                    </i>\n                                </button>\n                                <button class=\"border border-[#554d34] px-2 py-1\" data-kid=\"1-3-2-1-2-2-3-2-3\" data-name=\"skip forward button\" type=\"button\">\n                                    <i class=\"ph ph-skip-forward\" data-kid=\"1-3-2-1-2-2-3-2-3-1\" data-name=\"skip forward icon\">\n                                    </i>\n                                </button>\n                                <span class=\"ml-1\" data-kid=\"1-3-2-1-2-2-3-2-4\" data-name=\"label text\">\n                                    Replay\n                                </span>\n                            </div>\n                            <div class=\"flex items-center gap-1 text-[#a79b78]\" data-kid=\"1-3-2-1-2-2-3-3\" data-name=\"time range control group\">\n                                <button class=\"px-1.5 py-1\" data-kid=\"1-3-2-1-2-2-3-3-1\" data-name=\"1d button\">\n                                    1D\n                                </button>\n                                <button class=\"px-1.5 py-1\" data-kid=\"1-3-2-1-2-2-3-3-2\" data-name=\"7d button\">\n                                    7D\n                                </button>\n                                <button class=\"px-1.5 py-1\" data-kid=\"1-3-2-1-2-2-3-3-3\" data-name=\"1m button\">\n                                    1M\n                                </button>\n                                <button class=\"px-1.5 py-1\" data-kid=\"1-3-2-1-2-2-3-3-4\" data-name=\"3m button\">\n                                    3M\n                                </button>\n                                <button class=\"px-1.5 py-1\" data-kid=\"1-3-2-1-2-2-3-3-5\" data-name=\"all button\">\n                                    ALL\n                                </button>\n                                <button aria-label=\"Timezone\" class=\"ml-1 border-l border-[#554d34] pl-2\" data-kid=\"1-3-2-1-2-2-3-3-6\" data-name=\"timezone button\">\n                                    UTC\n                                    <i class=\"ph ph-caret-down\" data-kid=\"1-3-2-1-2-2-3-3-6-1\" data-name=\"caret down icon\">\n                                    </i>\n                                </button>\n                            </div>\n                        </div>\n                        <footer class=\"flex flex-wrap items-center justify-between gap-2 border-t border-[#554d34] px-3 py-2 text-[12px] text-[#a79b78]\" data-kid=\"1-3-2-1-2-2-4\" data-name=\"chart footer\">\n                            <span class=\"text-[13px] text-[#b5aa88]\" data-kid=\"1-3-2-1-2-2-4-1\" data-name=\"file info text\">\n                                Historical ·\n                                <code class=\"cu text-[#d0c5a3]\" data-kid=\"1-3-2-1-2-2-4-1-1\" data-name=\"file path code\">\n                                    data/xauusd_h1.csv\n                                </code>\n                                · H1 · last file row 2025-12-31 21:00 · not live\n                            </span>\n                            <a class=\"font-semibold text-[#edcc69] underline decoration-[#554d34] underline-offset-4\" data-kid=\"1-3-2-1-2-2-4-2\" data-name=\"vela link\" href=\"https://velacharts.dev\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                Vela™\n                            </a>\n                        </footer>\n                    </div>\n                </div>\n            </div>\n            <aside aria-label=\"Data window and source ledger\" class=\"flex min-w-0 flex-col border border-[#554d34] bg-[#0d0a03]\" data-kid=\"1-3-2-2\" data-name=\"data window panel\">\n                <div class=\"flex items-center justify-between border-b border-[#554d34] px-3 py-3\" data-kid=\"1-3-2-2-1\" data-name=\"panel header\">\n                    <h2 class=\"text-[15px] font-semibold\" data-kid=\"1-3-2-2-1-1\" data-name=\"panel title\">\n                        Data window\n                    </h2>\n                    <button aria-label=\"Close data window\" class=\"text-[17px] text-[#9d9270]\" data-kid=\"1-3-2-2-1-2\" data-name=\"close button\" type=\"button\">\n                        <i class=\"ph ph-x\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"x icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"border-b border-[#302a1b] px-3 py-3\" data-kid=\"1-3-2-2-2\" data-name=\"bar time info section\">\n                    <div class=\"text-[12px] text-[#9b906f]\" data-kid=\"1-3-2-2-2-1\" data-name=\"label text\">\n                        BAR TIME · UTC\n                    </div>\n                    <div class=\"cu mt-1 text-[14px] text-[#eee5c7]\" data-kid=\"1-3-2-2-2-2\" data-name=\"timestamp text\">\n                        2025-12-31 21:00\n                    </div>\n                    <dl class=\"mt-3 grid grid-cols-2 gap-x-3 gap-y-2 text-[13px]\" data-kid=\"1-3-2-2-2-3\" data-name=\"ohlc values list\">\n                        <dt class=\"text-[#9b906f]\" data-kid=\"1-3-2-2-2-3-1\" data-name=\"open label\">\n                            Open\n                        </dt>\n                        <dd class=\"cu text-right\" data-kid=\"1-3-2-2-2-3-2\" data-name=\"open value\">\n                            4,313.305\n                        </dd>\n                        <dt class=\"text-[#9b906f]\" data-kid=\"1-3-2-2-2-3-3\" data-name=\"high label\">\n                            High\n                        </dt>\n                        <dd class=\"cu text-right\" data-kid=\"1-3-2-2-2-3-4\" data-name=\"high value\">\n                            4,318.719\n                        </dd>\n                        <dt class=\"text-[#9b906f]\" data-kid=\"1-3-2-2-2-3-5\" data-name=\"low label\">\n                            Low\n                        </dt>\n                        <dd class=\"cu text-right\" data-kid=\"1-3-2-2-2-3-6\" data-name=\"low value\">\n                            4,306.835\n                        </dd>\n                        <dt class=\"text-[#9b906f]\" data-kid=\"1-3-2-2-2-3-7\" data-name=\"close label\">\n                            Close\n                        </dt>\n                        <dd class=\"cu text-right text-[#edcc69]\" data-kid=\"1-3-2-2-2-3-8\" data-name=\"close value\">\n                            4,318.679\n                        </dd>\n                        <dt class=\"text-[#9b906f]\" data-kid=\"1-3-2-2-2-3-9\" data-name=\"volume label\">\n                            Volume\n                        </dt>\n                        <dd class=\"cu text-right\" data-kid=\"1-3-2-2-2-3-10\" data-name=\"volume value\">\n                            0.98619\n                        </dd>\n                    </dl>\n                </div>\n                <div class=\"border-b border-[#302a1b] px-3 py-3\" data-kid=\"1-3-2-2-3\" data-name=\"object tree section\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-3-2-2-3-1\" data-name=\"header container\">\n                        <h3 class=\"text-[14px] font-semibold\" data-kid=\"1-3-2-2-3-1-1\" data-name=\"title text\">\n                            Object tree\n                        </h3>\n                        <i class=\"ph ph-stack text-[17px] text-[#9b906f]\" data-kid=\"1-3-2-2-3-1-2\" data-name=\"stack icon\">\n                        </i>\n                    </div>\n                    <div class=\"mt-2 flex items-center gap-2 text-[13px] text-[#c3b895]\" data-kid=\"1-3-2-2-3-2\" data-name=\"price series item\">\n                        <i class=\"ph ph-eye text-[#7b8a68]\" data-kid=\"1-3-2-2-3-2-1\" data-name=\"eye icon\">\n                        </i>\n                        Price series\n                        <span class=\"ml-auto text-[11px] text-[#81785f]\" data-kid=\"1-3-2-2-3-2-2\" data-name=\"status text\">\n                            visible\n                        </span>\n                    </div>\n                    <div class=\"mt-2 flex items-center gap-2 text-[13px] text-[#8d846b]\" data-kid=\"1-3-2-2-3-3\" data-name=\"indicators empty state\">\n                        <i class=\"ph ph-chart-line text-[#655d49]\" data-kid=\"1-3-2-2-3-3-1\" data-name=\"chart line icon\">\n                        </i>\n                        No indicators added\n                    </div>\n                    <div class=\"mt-2 flex items-center gap-2 text-[13px] text-[#8d846b]\" data-kid=\"1-3-2-2-3-4\" data-name=\"drawings empty state\">\n                        <i class=\"ph ph-pencil-simple text-[#655d49]\" data-kid=\"1-3-2-2-3-4-1\" data-name=\"pencil icon\">\n                        </i>\n                        No drawings\n                    </div>\n                </div>\n                <div class=\"flex-1 px-3 py-3\" data-kid=\"1-3-2-2-4\" data-name=\"source ledger panel\">\n                    <h3 class=\"text-[14px] font-semibold\" data-kid=\"1-3-2-2-4-1\" data-name=\"title\">\n                        Source ledger\n                    </h3>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#a79b78]\" data-kid=\"1-3-2-2-4-2\" data-name=\"description text\">\n                        Chart reads only the supplied historical CSV rows. No broker feed or live candle is connected.\n                    </p>\n                    <div class=\"mt-3 space-y-2 border-t border-[#302a1b] pt-3 text-[12px] leading-[1.55]\" data-kid=\"1-3-2-2-4-3\" data-name=\"ledger details\">\n                        <p data-kid=\"1-3-2-2-4-3-1\" data-name=\"bars data entry\">\n                            <span class=\"text-[#edcc69]\" data-kid=\"1-3-2-2-4-3-1-1\" data-name=\"label\">\n                                Bars\n                            </span>\n                            <br data-kid=\"1-3-2-2-4-3-1-2\"/>\n                            <code class=\"cu text-[#c3b895]\" data-kid=\"1-3-2-2-4-3-1-3\" data-name=\"file path code\">\n                                data/xauusd_h1.csv\n                            </code>\n                            · exact final 12 rows\n                        </p>\n                        <p data-kid=\"1-3-2-2-4-3-2\" data-name=\"production data entry\">\n                            <span class=\"text-[#f4a9a9]\" data-kid=\"1-3-2-2-4-3-2-1\" data-name=\"label\">\n                                Production\n                            </span>\n                            <br data-kid=\"1-3-2-2-4-3-2-2\"/>\n                            <code class=\"cu text-[#c3b895]\" data-kid=\"1-3-2-2-4-3-2-3\" data-name=\"file path code\">\n                                artifacts/models/production/manifest.json\n                            </code>\n                            · absent\n                        </p>\n                        <p data-kid=\"1-3-2-2-4-3-3\" data-name=\"evaluation data entry\">\n                            <span class=\"text-[#b8ad8e]\" data-kid=\"1-3-2-2-4-3-3-1\" data-name=\"label\">\n                                Evaluation\n                            </span>\n                            <br data-kid=\"1-3-2-2-4-3-3-2\"/>\n                            No passed evaluation; promotion unavailable.\n                        </p>\n                        <p data-kid=\"1-3-2-2-4-3-4\" data-name=\"runtime data entry\">\n                            <span class=\"text-[#b8ad8e]\" data-kid=\"1-3-2-2-4-3-4-1\" data-name=\"label\">\n                                Runtime state\n                            </span>\n                            <br data-kid=\"1-3-2-2-4-3-4-2\"/>\n                            Account, risk, decisions and reconciliation have no UI/backend reader.\n                        </p>\n                        <p class=\"text-[#8e8468]\" data-kid=\"1-3-2-2-4-3-5\" data-name=\"fixture disclaimer\">\n                            Smoke fixture values are not used as account truth.\n                        </p>\n                    </div>\n                </div>\n            </aside>\n        </section>\n        <section aria-label=\"Operations readings\" class=\"readings grid grid-cols-4 border-y border-[#554d34] bg-[#0d0a03]\" data-kid=\"1-3-3\" data-name=\"readings section\">\n            <article class=\"px-4 py-3\" data-kid=\"1-3-3-1\" data-name=\"latest decision card\">\n                <h2 class=\"text-[15px] font-semibold\" data-kid=\"1-3-3-1-1\" data-name=\"title\">\n                    Latest decision\n                </h2>\n                <p class=\"mt-1 text-[13px] text-[#b8ad8e]\" data-kid=\"1-3-3-1-2\" data-name=\"value text\">\n                    Unavailable\n                </p>\n                <p class=\"mt-1 text-[12px] leading-5 text-[#82795f]\" data-kid=\"1-3-3-1-3\" data-name=\"description text\">\n                    Decision feed is not available; no signal or order data is shown.\n                </p>\n            </article>\n            <article class=\"border-l border-[#554d34] px-4 py-3\" data-kid=\"1-3-3-2\" data-name=\"active positions card\">\n                <h2 class=\"text-[15px] font-semibold\" data-kid=\"1-3-3-2-1\" data-name=\"title\">\n                    Active positions\n                </h2>\n                <p class=\"mt-1 text-[13px] text-[#b8ad8e]\" data-kid=\"1-3-3-2-2\" data-name=\"value text\">\n                    Position feed unavailable\n                </p>\n                <p class=\"mt-1 text-[12px] leading-5 text-[#82795f]\" data-kid=\"1-3-3-2-3\" data-name=\"description text\">\n                    No position rows can be verified. No entry, SL or TP overlays.\n                </p>\n            </article>\n            <article class=\"border-l border-[#554d34] px-4 py-3\" data-kid=\"1-3-3-3\" data-name=\"account risk card\">\n                <h2 class=\"text-[15px] font-semibold\" data-kid=\"1-3-3-3-1\" data-name=\"title\">\n                    Account & risk\n                </h2>\n                <p class=\"mt-1 text-[13px] text-[#b8ad8e]\" data-kid=\"1-3-3-3-2\" data-name=\"value text\">\n                    Unavailable\n                </p>\n                <p class=\"mt-1 text-[12px] leading-5 text-[#82795f]\" data-kid=\"1-3-3-3-3\" data-name=\"description text\">\n                    Supervisor / risk-state reader not implemented. No account totals.\n                </p>\n            </article>\n            <article class=\"border-l border-[#554d34] px-4 py-3\" data-kid=\"1-3-3-4\" data-name=\"reconciliation card\">\n                <h2 class=\"text-[15px] font-semibold\" data-kid=\"1-3-3-4-1\" data-name=\"title\">\n                    Reconciliation\n                </h2>\n                <p class=\"mt-1 text-[13px] text-[#b8ad8e]\" data-kid=\"1-3-3-4-2\" data-name=\"value text\">\n                    Unavailable\n                </p>\n                <p class=\"mt-1 text-[12px] leading-5 text-[#82795f]\" data-kid=\"1-3-3-4-3\" data-name=\"description text\">\n                    No supervisor reconciliation result or timestamp is available.\n                </p>\n            </article>\n        </section>\n        <p class=\"text-[12px] leading-5 text-[#8e8468]\" data-kid=\"1-3-4\" data-name=\"footer disclaimer text\">\n            Host controls are a separate control surface. This screen cannot call a broker or place orders. Kill-switch file state shown above reflects the documented baseline: absent.\n        </p>\n    </main>\n</div>\n<script>\n    (() => {\n  const bars = [\n    {time:'2025-12-31 10:00',open:4325.448,high:4331.035,low:4303.015,close:4306.325,volume:2.1703},\n    {time:'2025-12-31 11:00',open:4306.155,high:4316.165,low:4303.858,close:4310.725,volume:1.43733},\n    {time:'2025-12-31 12:00',open:4310.775,high:4317.925,low:4302.598,close:4313.515,volume:1.50222},\n    {time:'2025-12-31 13:00',open:4313.485,high:4347.915,low:4307.745,close:4345.395,volume:2.40632},\n    {time:'2025-12-31 14:00',open:4345.465,high:4353.048,low:4332.315,close:4345.548,volume:4.15752},\n    {time:'2025-12-31 15:00',open:4345.548,high:4345.685,low:4326.418,close:4337.145,volume:4.47195},\n    {time:'2025-12-31 16:00',open:4337.175,high:4339.505,low:4316.685,close:4322.618,volume:2.63816},\n    {time:'2025-12-31 17:00',open:4322.618,high:4329.158,low:4317.885,close:4321.395,volume:2.39291},\n    {time:'2025-12-31 18:00',open:4321.555,high:4331.275,low:4315.365,close:4319.255,volume:2.53997},\n    {time:'2025-12-31 19:00',open:4319.545,high:4322.525,low:4307.585,close:4311.115,volume:2.10008},\n    {time:'2025-12-31 20:00',open:4311.125,high:4324.285,low:4304.195,close:4313.045,volume:2.71129},\n    {time:'2025-12-31 21:00',open:4313.305,high:4318.719,low:4306.835,close:4318.679,volume:0.98619}\n  ];\n  const svg=document.getElementById('gold-chart');\n  if(!svg)return;\n  const ns='http://www.w3.org/2000/svg';\n  const make=(tag,attrs={},text='')=>{const n=document.createElementNS(ns,tag);for(const [k,v] of Object.entries(attrs))n.setAttribute(k,v);if(text)n.textContent=text;svg.appendChild(n);return n;};\n  const low=Math.floor(Math.min(...bars.map(b=>b.low))/10)*10-5;\n  const high=Math.ceil(Math.max(...bars.map(b=>b.high))/10)*10+5;\n  const top=22,bottom=286,volTop=316,volBottom=374,left=34,right=858;\n  const py=v=>bottom-(v-low)/(high-low)*(bottom-top);\n  const x=i=>left+(right-left)*i/(bars.length-1);\n  const fmt=v=>Number(v).toLocaleString('en-US',{minimumFractionDigits:3,maximumFractionDigits:3});\n  make('rect',{x:0,y:0,width:1000,height:410,fill:'#090907'});\n  for(let value=Math.ceil(low/10)*10;value<=high;value+=10){const y=py(value);make('line',{x1:left,y1:y,x2:875,y2:y,stroke:'#282316','stroke-width':'1'});make('text',{x:888,y:y+4,fill:'#93896a','font-size':'12','font-family':'Cuprum, sans-serif'},fmt(value));}\n  [0,3,6,9,11].forEach(i=>{const xx=x(i);make('line',{x1:xx,y1:top,x2:xx,y2:volBottom,stroke:'#201c12','stroke-width':'1'});make('text',{x:xx,y:402,fill:'#93896a','font-size':'12','text-anchor':i===0?'start':i===11?'end':'middle','font-family':'Cuprum, sans-serif'},bars[i].time.slice(-5));});\n  make('line',{x1:left,y1:302,x2:875,y2:302,stroke:'#403923','stroke-width':'1'});\n  make('text',{x:left,y:314,fill:'#a99d79','font-size':'11','font-family':'Chakra Petch, sans-serif'},'VOLUME');\n  const maxVol=Math.max(...bars.map(b=>b.volume));\n  const step=(right-left)/(bars.length-1),cw=Math.min(28,step*.43);\n  bars.forEach((b,i)=>{\n    const xx=x(i), up=b.close>=b.open, color=up?'#7b8a68':'#c77f75';\n    make('line',{x1:xx,y1:py(b.high),x2:xx,y2:py(b.low),stroke:color,'stroke-width':'1.5'});\n    const y1=py(Math.max(b.open,b.close)), y2=py(Math.min(b.open,b.close));\n    make('rect',{x:xx-cw/2,y:y1,width:cw,height:Math.max(y2-y1,1.5),fill:color,stroke:color,'stroke-width':'1'});\n    const vh=(b.volume/maxVol)*(volBottom-volTop-3);\n    make('rect',{x:xx-cw/2,y:volBottom-vh,width:cw,height:vh,fill:color,opacity:'.72'});\n  });\n  const lastClose=bars[bars.length-1].close, closeY=py(lastClose);\n  make('line',{x1:left,y1:closeY,x2:875,y2:closeY,stroke:'#edcc69','stroke-width':'1','stroke-dasharray':'3 5',opacity:'.62'});\n  make('rect',{x:878,y:closeY-9,width:93,height:18,fill:'#211b0c',stroke:'#8c7840','stroke-width':'1'});\n  make('text',{x:924.5,y:closeY+4,fill:'#edcc69','font-size':'12','text-anchor':'middle','font-family':'Cuprum, sans-serif'},fmt(lastClose));\n  make('line',{x1:left,y1:volBottom,x2:875,y2:volBottom,stroke:'#403923','stroke-width':'1'});\n  make('line',{x1:875,y1:top,x2:875,y2:volBottom,stroke:'#403923','stroke-width':'1'});\n})();\n</script>\n",
