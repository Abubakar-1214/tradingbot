698]/15 bg-[#2B111B] px-2.5 py-2 font-mono text-[14px] text-[#D6E6CA] outline-hidden\" data-kid=\"1-2-3-1-2-2-2-4-2\" data-name=\"train every input\" value=\"4\"/>\n                            </label>\n                            <label class=\"border-r border-b border-[#ADC698]/15 p-3\" data-kid=\"1-2-3-1-2-2-2-5\" data-name=\"sequence length input field group\">\n                                <span class=\"block text-[14px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-2-5-1\" data-name=\"sequence length label\">\n                                    Sequence length\n                                </span>\n                                <input aria-label=\"Sequence length\" class=\"mt-2 w-full rounded-md border border-[#ADC698]/15 bg-[#2B111B] px-2.5 py-2 font-mono text-[14px] text-[#D6E6CA] outline-hidden\" data-kid=\"1-2-3-1-2-2-2-5-2\" data-name=\"sequence length input\" value=\"64\"/>\n                            </label>\n                            <label class=\"border-r border-b border-[#ADC698]/15 p-3\" data-kid=\"1-2-3-1-2-2-2-6\" data-name=\"window input field group\">\n                                <span class=\"block text-[14px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-2-6-1\" data-name=\"window label\">\n                                    Window\n                                </span>\n                                <input aria-label=\"Window\" class=\"mt-2 w-full rounded-md border border-[#ADC698]/15 bg-[#2B111B] px-2.5 py-2 font-mono text-[14px] text-[#D6E6CA] outline-hidden\" data-kid=\"1-2-3-1-2-2-2-6-2\" data-name=\"window input\" value=\"64\"/>\n                            </label>\n                            <label class=\"border-r border-b border-[#ADC698]/15 p-3\" data-kid=\"1-2-3-1-2-2-2-7\" data-name=\"embed dim input field group\">\n                                <span class=\"block text-[14px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-2-7-1\" data-name=\"embed dim label\">\n                                    Embed dim\n                                </span>\n                                <input aria-label=\"Embed dimension\" class=\"mt-2 w-full rounded-md border border-[#ADC698]/15 bg-[#2B111B] px-2.5 py-2 font-mono text-[14px] text-[#D6E6CA] outline-hidden\" data-kid=\"1-2-3-1-2-2-2-7-2\" data-name=\"embed dim input\" value=\"256\"/>\n                            </label>\n                            <label class=\"border-b border-[#ADC698]/15 p-3\" data-kid=\"1-2-3-1-2-2-2-8\" data-name=\"hidden dim input field group\">\n                                <span class=\"block text-[14px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-2-8-1\" data-name=\"hidden dim label\">\n                                    Hidden dim\n                                </span>\n                                <input aria-label=\"Hidden dimension\" class=\"mt-2 w-full rounded-md border border-[#ADC698]/15 bg-[#2B111B] px-2.5 py-2 font-mono text-[14px] text-[#D6E6CA] outline-hidden\" data-kid=\"1-2-3-1-2-2-2-8-2\" data-name=\"hidden dim input\" value=\"512\"/>\n                            </label>\n                            <label class=\"border-r border-[#ADC698]/15 p-3\" data-kid=\"1-2-3-1-2-2-2-9\" data-name=\"stoch dim input field group\">\n                                <span class=\"block text-[14px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-2-9-1\" data-name=\"stoch dim label\">\n                                    Stoch dim\n                                </span>\n                                <input aria-label=\"Stochastic dimension\" class=\"mt-2 w-full rounded-md border border-[#ADC698]/15 bg-[#2B111B] px-2.5 py-2 font-mono text-[14px] text-[#D6E6CA] outline-hidden\" data-kid=\"1-2-3-1-2-2-2-9-2\" data-name=\"stoch dim input\" value=\"32\"/>\n                            </label>\n                            <label class=\"border-r border-[#ADC698]/15 p-3\" data-kid=\"1-2-3-1-2-2-2-10\" data-name=\"categories input field group\">\n                                <span class=\"block text-[14px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-2-10-1\" data-name=\"categories label\">\n                                    Categories\n                                </span>\n                                <input aria-label=\"Number of categories\" class=\"mt-2 w-full rounded-md border border-[#ADC698]/15 bg-[#2B111B] px-2.5 py-2 font-mono text-[14px] text-[#D6E6CA] outline-hidden\" data-kid=\"1-2-3-1-2-2-2-10-2\" data-name=\"categories input\" value=\"32\"/>\n                            </label>\n                            <label class=\"border-r border-[#ADC698]/15 p-3\" data-kid=\"1-2-3-1-2-2-2-11\" data-name=\"horizon input field group\">\n                                <span class=\"block text-[14px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-2-11-1\" data-name=\"horizon label\">\n                                    Horizon\n                                </span>\n                                <input aria-label=\"Horizon\" class=\"mt-2 w-full rounded-md border border-[#ADC698]/15 bg-[#2B111B] px-2.5 py-2 font-mono text-[14px] text-[#D6E6CA] outline-hidden\" data-kid=\"1-2-3-1-2-2-2-11-2\" data-name=\"horizon input\" value=\"15\"/>\n                            </label>\n                            <label class=\"p-3\" data-kid=\"1-2-3-1-2-2-2-12\" data-name=\"device input field group\">\n                                <span class=\"block text-[14px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-2-12-1\" data-name=\"device label\">\n                                    Device\n                                </span>\n                                <div class=\"mt-2 font-mono text-[14px] text-[#D6E6CA]\" data-kid=\"1-2-3-1-2-2-2-12-2\" data-name=\"device value text\">\n                                    auto → CPU\n                                </div>\n                            </label>\n                        </div>\n                        <div class=\"mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"data source file and date inputs\">\n                            <label class=\"block\" data-kid=\"1-2-3-1-2-2-3-1\" data-name=\"data file input group\">\n                                <span class=\"block text-[14px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-3-1-1\" data-name=\"data file label\">\n                                    Data file\n                                    <span class=\"font-mono text-[11px]\" data-kid=\"1-2-3-1-2-2-3-1-1-1\" data-name=\"data file flag text\">\n                                        --data\n                                    </span>\n                                </span>\n                                <input aria-label=\"Data file\" class=\"mt-2 w-full rounded-lg border border-[#ADC698]/20 bg-[#2B111B] px-3 py-2.5 font-mono text-[13px] text-[#D6E6CA] outline-hidden\" data-kid=\"1-2-3-1-2-2-3-1-2\" data-name=\"data file input\" value=\"data/xauusd_h1.csv\"/>\n                            </label>\n                            <label class=\"block\" data-kid=\"1-2-3-1-2-2-3-2\" data-name=\"train end input group\">\n                                <span class=\"block text-[14px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-3-2-1\" data-name=\"train end label\">\n                                    Train end\n                                    <span class=\"font-mono text-[11px]\" data-kid=\"1-2-3-1-2-2-3-2-1-1\" data-name=\"train end flag text\">\n                                        --train-end\n                                    </span>\n                                </span>\n                                <input aria-label=\"Train end\" class=\"mt-2 w-full rounded-lg border border-[#ADC698]/20 bg-[#2B111B] px-3 py-2.5 font-mono text-[13px] text-[#D6E6CA] outline-hidden\" data-kid=\"1-2-3-1-2-2-3-2-2\" data-name=\"train end input\" value=\"2022-01-01\"/>\n                            </label>\n                        </div>\n                        <div class=\"mt-5 border-t border-[#ADC698]/20 pt-4\" data-kid=\"1-2-3-1-2-2-4\" data-name=\"action settings group\">\n                            <div class=\"flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-2-3-1-2-2-4-1\" data-name=\"action header row\">\n                                <div data-kid=\"1-2-3-1-2-2-4-1-1\" data-name=\"action header text block\">\n                                    <h4 class=\"text-[17px] font-semibold\" data-kid=\"1-2-3-1-2-2-4-1-1-1\" data-name=\"action title\">\n                                        Stop-loss / take-profit action\n                                    </h4>\n                                    <p class=\"mt-1 text-[14px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-4-1-1-2\" data-name=\"action description\">\n                                        Default uses existing ATR rules. Model-decided buckets are optional.\n                                    </p>\n                                </div>\n                                <div class=\"flex items-center gap-3 font-mono text-[12px]\" data-kid=\"1-2-3-1-2-2-4-1-2\" data-name=\"action badge group\">\n                                    <span class=\"border border-[#C05746]/70 bg-[#3F2A2B] px-3 py-2 text-[#EBA294]\" data-kid=\"1-2-3-1-2-2-4-1-2-1\" data-name=\"action status badge\">\n                                        RULES · DEFAULT\n                                    </span>\n                                    <label class=\"flex items-center gap-2 text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-4-1-2-2\" data-name=\"model action toggle group\">\n                                        <input class=\"accent-[#C05746]\" data-kid=\"1-2-3-1-2-2-4-1-2-2-1\" data-name=\"model action checkbox\" type=\"checkbox\"/>\n                                        Model action\n                                    </label>\n                                </div>\n                            </div>\n                            <div class=\"mt-4 grid grid-cols-1 gap-3 sm:grid-cols-[110px_1fr]\" data-kid=\"1-2-3-1-2-2-4-2\" data-name=\"bucket values row\">\n                                <div class=\"text-[14px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-4-2-1\" data-name=\"bucket label\">\n                                    SL & TP buckets\n                                </div>\n                                <div class=\"flex flex-wrap gap-x-5 gap-y-2 font-mono text-[13px] text-[#D6E6CA]\" data-kid=\"1-2-3-1-2-2-4-2-2\" data-name=\"bucket values list\">\n                                    <span data-kid=\"1-2-3-1-2-2-4-2-2-1\" data-name=\"bucket value 1\">\n                                        0.005\n                                    </span>\n                                    <span data-kid=\"1-2-3-1-2-2-4-2-2-2\" data-name=\"bucket value 2\">\n                                        0.01\n                                    </span>\n                                    <span data-kid=\"1-2-3-1-2-2-4-2-2-3\" data-name=\"bucket value 3\">\n                                        0.02\n                                    </span>\n                                    <span data-kid=\"1-2-3-1-2-2-4-2-2-4\" data-name=\"bucket value 4\">\n                                        0.03\n                                    </span>\n                                    <span data-kid=\"1-2-3-1-2-2-4-2-2-5\" data-name=\"bucket value 5\">\n                                        0.05\n                                    </span>\n                                    <span class=\"font-sans text-[13px] text-[#ADC698]\" data-kid=\"1-2-3-1-2-2-4-2-2-6\" data-name=\"bucket description\">\n                                        Price fractions · same five values for both\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <aside class=\"border-t border-[#C05746]/55 pt-5 xl:border-t-0 xl:border-l xl:pl-6\" data-kid=\"1-2-3-2\" data-name=\"preflight sidebar\">\n                <h2 class=\"text-[23px] font-semibold\" data-kid=\"1-2-3-2-1\" data-name=\"preflight heading\">\n                    Preflight review\n                </h2>\n                <p class=\"mt-2 text-[14px] leading-5 text-[#ADC698]\" data-kid=\"1-2-3-2-2\" data-name=\"preflight description text\">\n                    The supervisor is not present. Every backend check below is\n                    <span class=\"font-mono text-[#EBA294]\" data-kid=\"1-2-3-2-2-1\" data-name=\"preflight warning emphasis\">\n                        Not checked\n                    </span>\n                    ; the visible local existence facts are not backend verification.\n                </p>\n                <div class=\"mt-5 space-y-0 border-y border-[#ADC698]/20\" data-kid=\"1-2-3-2-3\" data-name=\"preflight checks list\">\n                    <div class=\"flex justify-between gap-3 border-b border-[#ADC698]/15 py-4\" data-kid=\"1-2-3-2-3-1\" data-name=\"preflight check item 1\">\n                        <span class=\"text-[14px]\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"preflight label 1\">\n                            CSV non-empty & split range\n                        </span>\n                        <span class=\"shrink-0 font-mono text-[11px] text-[#EBA294]\" data-kid=\"1-2-3-2-3-1-2\" data-name=\"preflight status 1\">\n                            Not checked\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between gap-3 border-b border-[#ADC698]/15 py-4\" data-kid=\"1-2-3-2-3-2\" data-name=\"preflight check item 2\">\n                        <span class=\"text-[14px]\" data-kid=\"1-2-3-2-3-2-1\" data-name=\"preflight label 2\">\n                            Contract & hash\n                        </span>\n                        <span class=\"shrink-0 font-mono text-[11px] text-[#EBA294]\" data-kid=\"1-2-3-2-3-2-2\" data-name=\"preflight status 2\">\n                            Not checked\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between gap-3 border-b border-[#ADC698]/15 py-4\" data-kid=\"1-2-3-2-3-3\" data-name=\"preflight check item 3\">\n                        <span class=\"text-[14px]\" data-kid=\"1-2-3-2-3-3-1\" data-name=\"preflight label 3\">\n                            Flag validation\n                        </span>\n                        <span class=\"shrink-0 font-mono text-[11px] text-[#EBA294]\" data-kid=\"1-2-3-2-3-3-2\" data-name=\"preflight status 3\">\n                            Not checked\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between gap-3 border-b border-[#ADC698]/15 py-4\" data-kid=\"1-2-3-2-3-4\" data-name=\"preflight check item 4\">\n                        <span class=\"text-[14px]\" data-kid=\"1-2-3-2-3-4-1\" data-name=\"preflight label 4\">\n                            Base manifest, if staged\n                        </span>\n                        <span class=\"shrink-0 font-mono text-[11px] text-[#EBA294]\" data-kid=\"1-2-3-2-3-4-2\" data-name=\"preflight status 4\">\n                            Not checked\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between gap-3 border-b border-[#ADC698]/15 py-4\" data-kid=\"1-2-3-2-3-5\" data-name=\"preflight check item 5\">\n                        <span class=\"text-[14px]\" data-kid=\"1-2-3-2-3-5-1\" data-name=\"preflight label 5\">\n                            Disk space\n                        </span>\n                        <span class=\"shrink-0 font-mono text-[11px] text-[#EBA294]\" data-kid=\"1-2-3-2-3-5-2\" data-name=\"preflight status 5\">\n                            Not checked\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between gap-3 border-b border-[#ADC698]/15 py-4\" data-kid=\"1-2-3-2-3-6\" data-name=\"preflight check item 6\">\n                        <span class=\"text-[14px]\" data-kid=\"1-2-3-2-3-6-1\" data-name=\"preflight label 6\">\n                            Venv interpreter resolves\n                        </span>\n                        <span class=\"shrink-0 font-mono text-[11px] text-[#EBA294]\" data-kid=\"1-2-3-2-3-6-2\" data-name=\"preflight status 6\">\n                            Not checked\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between gap-3 py-4\" data-kid=\"1-2-3-2-3-7\" data-name=\"preflight check item 7\">\n                        <span class=\"text-[14px]\" data-kid=\"1-2-3-2-3-7-1\" data-name=\"preflight label 7\">\n                            Concurrency & run-name availability\n                        </span>\n                        <span class=\"shrink-0 font-mono text-[11px] text-[#EBA294]\" data-kid=\"1-2-3-2-3-7-2\" data-name=\"preflight status 7\">\n                            Not checked\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-5 rounded-lg bg-[#3F2A2B]/55 p-4\" data-kid=\"1-2-3-2-4\" data-name=\"local existence facts box\">\n                    <div class=\"text-[15px] font-semibold\" data-kid=\"1-2-3-2-4-1\" data-name=\"facts heading\">\n                        Local existence facts\n                    </div>\n                    <div class=\"mt-3 flex items-start justify-between gap-3 text-[13px]\" data-kid=\"1-2-3-2-4-2\" data-name=\"fact row 1\">\n                        <span class=\"font-mono text-[#ADC698]\" data-kid=\"1-2-3-2-4-2-1\" data-name=\"fact label 1\">\n                            data/xauusd_h1.csv\n                        </span>\n                        <span class=\"shrink-0 text-[#D6E6CA]\" data-kid=\"1-2-3-2-4-2-2\" data-name=\"fact status 1\">\n                            Confirmed\n                        </span>\n                    </div>\n                    <div class=\"mt-2 flex items-start justify-between gap-3 text-[13px]\" data-kid=\"1-2-3-2-4-3\" data-name=\"fact row 2\">\n                        <span class=\"font-mono text-[#ADC698]\" data-kid=\"1-2-3-2-4-3-1\" data-name=\"fact label 2\">\n                            .venv\\Scripts\\python.exe\n                        </span>\n                        <span class=\"shrink-0 text-[#D6E6CA]\" data-kid=\"1-2-3-2-4-3-2\" data-name=\"fact status 2\">\n                            Confirmed\n                        </span>\n                    </div>\n                </div>\n                <button aria-disabled=\"true\" class=\"mt-5 w-full cursor-not-allowed border border-[#C05746]/40 bg-[#3F2A2B] px-4 py-3 text-[16px] font-semibold text-[#ADC698]/75\" data-kid=\"1-2-3-2-5\" data-name=\"disabled launch button\" disabled=\"\">\n                    Launch disabled\n                </button>\n                <p class=\"mt-3 text-[13px] leading-5 text-[#ADC698]/80\" data-kid=\"1-2-3-2-6\" data-name=\"sidebar helper text\">\n                    No run name or job state has been created. Launch requires the supervisor API and successful backend checks.\n                </p>\n            </aside>\n        </section>\n        <footer class=\"mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-[#ADC698]/20 pt-4 text-[13px] text-[#ADC698]/80\" data-kid=\"1-2-4\" data-name=\"footer section\">\n            <span data-kid=\"1-2-4-1\" data-name=\"footer disclaimer\">\n                Preparation is review-only until a supervisor can validate and launch the job.\n            </span>\n            <span class=\"font-mono\" data-kid=\"1-2-4-2\" data-name=\"footer technical status\">\n                No contract · no computed dimension · no backend preflight result\n            </span>\n        </footer>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-04T12:15:48.848900+00:00",
      "modified": "2026-10-04T12:15:48.848900+00:00",
      "id": "var_1649f0e317c8"
    },
    "var_589c4d2550bf": {
      "type": "variant",
      "label": "V2 · Prepare Run · Validation board",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 10780,
        "y": 0,
        "w": 1440,
        "h": 2374
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Saira:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"bg-[#000000] font-[Saira] text-[#eaff9a]\">\n  <header class=\"flex items-center justify-between border-b border-[#262d05] px-7 py-4\">\n    <div class=\"flex items-center gap-3\">\n      <div class=\"flex h-10 w-10 items-center justify-center bg-[#deff00] text-sm font-extrabold text-black\">AU</div>\n      <div>\n        <div class=\"text-lg font-bold leading-5 text-white\">XAUUSD <span class=\"font-mono text-xs font-normal text-[#deff00]\">AI TERMINAL</span></div>\n        <div class=\"mt-1 font-mono text-[11px] text-[#929878]\">LOCAL CONTROL PLANE</div>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-7 font-mono text-xs\">\n      <div><span class=\"text-[#777d5d]\">MODE</span> <span class=\"ml-2 text-[#deff00]\">DEMO</span></div>\n      <div><span class=\"text-[#777d5d]\">PRODUCTION</span> <span class=\"ml-2 text-[#ff6262]\">NONE</span></div>\n      <div><span class=\"text-[#777d5d]\">MODEL GATE</span> <span class=\"ml-2 text-[#ff6262]\">BLOCKED</span></div>\n    </div>\n  </header>\n  <div class=\"grid grid-cols-[214px_minmax(0,1fr)]\">\n    <aside class=\"border-r border-[#262d05] px-4 py-5\">\n      <div class=\"mb-4 px-3 font-mono text-[11px] text-[#777d5d]\">WORKSPACE</div>\n      <nav aria-label=\"Workspace\" class=\"space-y-1 text-sm\">\n        <div class=\"flex items-center gap-3 px-3 py-3 text-[#a8ad83]\"><i class=\"ti ti-chart-candle text-lg\"></i>Operations</div>\n        <div class=\"flex items-center gap-3 px-3 py-3 text-[#a8ad83]\"><i class=\"ti ti-activity text-lg\"></i>Training</div>\n        <div aria-current=\"page\" class=\"flex items-center gap-3 border border-[#deff00] bg-[#deff00] px-3 py-3 font-bold text-black\"><i class=\"ti ti-adjustments-horizontal text-lg\"></i>Prepare Run</div>\n        <div class=\"flex items-center gap-3 px-3 py-3 text-[#a8ad83]\"><i class=\"ti ti-files text-lg\"></i>Models / Evaluation</div>\n        <div class=\"flex items-center gap-3 px-3 py-3 text-[#a8ad83]\"><i class=\"ti ti-settings text-lg\"></i>Risk / Settings</div>\n      </nav>\n      <div class=\"mt-9 border-t border-[#262d05] px-3 pt-4\">\n        <div class=\"font-mono text-[11px] text-[#777d5d]\">PROCESS SUPERVISION</div>\n        <div class=\"mt-2 text-sm text-white\">Supervisor API</div>\n        <div class=\"mt-1 font-mono text-xs text-[#a8ad83]\">Unavailable</div>\n      </div>\n      <div class=\"mt-6 border-t border-[#262d05] px-3 pt-4 text-xs leading-5 text-[#a8ad83]\">The interface prepares a job specification. A supervisor must validate and spawn it.</div>\n    </aside>\n\n    <main class=\"min-w-0 px-7 py-6\">\n      <div class=\"flex flex-wrap items-end justify-between gap-4\">\n        <div>\n          <h1 class=\"text-4xl font-bold leading-none text-white\">Prepare run</h1>\n          <p class=\"mt-2 max-w-2xl text-sm text-[#b7bc97]\">Set the data, verify its feature contract, choose a training preset, then review preflight before launch.</p>\n        </div>\n        <label class=\"w-80 text-xs text-[#a8ad83]\">Run name <span class=\"font-mono text-[#777d5d]\">· required</span>\n          <input aria-label=\"Run name\" class=\"mt-2 block w-full border border-[#414627] bg-black px-3 py-3 font-mono text-sm text-white placeholder:text-[#777d5d] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"Enter run identifier\" value=\"\" />\n        </label>\n      </div>\n\n      <div class=\"mt-6 grid grid-cols-5 border-y border-[#262d05] py-3 font-mono text-xs\">\n        <div class=\"border-r border-[#262d05] px-3 text-[#a8ad83]\">01 &nbsp; Data</div>\n        <div class=\"border-r border-[#262d05] px-3 text-[#a8ad83]\">02 &nbsp; Contract</div>\n        <div class=\"border-r-2 border-b-2 border-[#deff00] px-3 pb-3 text-[#deff00]\">03 &nbsp; Preset</div>\n        <div class=\"border-r border-[#262d05] px-3 text-[#a8ad83]\">04 &nbsp; Preflight</div>\n        <div class=\"px-3 text-[#a8ad83]\">05 &nbsp; Launch</div>\n      </div>\n\n      <section aria-labelledby=\"data-title\" class=\"mt-5 border border-[#262d05]\">\n        <div class=\"flex items-center justify-between border-b border-[#262d05] px-5 py-3\">\n          <h2 id=\"data-title\" class=\"text-xl font-semibold text-white\">Data source</h2>\n          <span class=\"font-mono text-xs text-[#deff00]\">FILE EXISTS</span>\n        </div>\n        <div class=\"grid grid-cols-[minmax(0,1fr)_minmax(230px,0.72fr)]\">\n          <div class=\"border-r border-[#262d05] p-5\">\n            <label class=\"block text-sm text-[#b7bc97]\">CSV dataset <span class=\"font-mono text-xs text-[#777d5d]\">--data</span>\n              <div class=\"mt-2 flex items-center justify-between border border-[#414627] bg-black px-3 py-3 font-mono text-sm text-white\"><span>data/xauusd_h1.csv</span><i class=\"ti ti-chevron-down text-[#deff00]\"></i></div>\n            </label>\n            <div class=\"mt-4 grid grid-cols-2 gap-4\">\n              <label class=\"text-sm text-[#b7bc97]\">Train end <span class=\"font-mono text-xs text-[#777d5d]\">--train-end</span><div class=\"mt-2 border border-[#414627] bg-black px-3 py-3 font-mono text-sm text-white\">2022-01-01</div></label>\n              <label class=\"text-sm text-[#b7bc97]\">Window <span class=\"font-mono text-xs text-[#777d5d]\">--window</span><div class=\"mt-2 border border-[#414627] bg-black px-3 py-3 font-mono text-sm text-white\">64</div></label>\n            </div>\n          </div>\n          <div class=\"bg-[#101400] p-5\">\n            <div class=\"font-mono text-xs text-[#deff00]\">LEAK-FREE SPLIT</div>\n            <p class=\"mt-2 text-sm leading-6 text-[#e5e9cf]\">Fit the feature pipeline on the train window only. Validation bars are transformed after fit; validation rows do not enter fit.</p>\n            <div class=\"mt-3 border-t border-[#262d05] pt-3 text-xs leading-5 text-[#a8ad83]\">Warm-up bars dropped: 200. Train/validation range and bar counts require server validation.</div>\n          </div>\n        </div>\n      </section>\n\n      <section aria-labelledby=\"contract-title\" class=\"mt-5 border-y border-[#262d05] py-4\">\n        <div class=\"flex flex-wrap items-center justify-between gap-3\">\n          <div><h2 id=\"contract-title\" class=\"text-xl font-semibold text-white\">Feature contract</h2><p class=\"mt-1 text-sm text-[#a8ad83]\">Build or select the contract associated with this dataset and window.</p></div>\n          <span class=\"border border-[#414627] px-3 py-2 font-mono text-xs text-[#a8ad83]\">CONTRACT STATE · NOT CHECKED</span>\n        </div>\n        <div class=\"mt-4 grid grid-cols-3 border border-[#262d05]\">\n          <div class=\"border-r border-[#262d05] p-4\">\n            <div class=\"font-mono text-[11px] text-[#777d5d]\">CONTRACT FILE</div>\n            <div class=\"mt-2 font-mono text-sm text-white\">feature_contract.json</div>\n            <div class=\"mt-2 text-sm text-[#a8ad83]\">Presence and compatibility: Not checked</div>\n          </div>\n          <div class=\"border-r border-[#262d05] p-4\">\n            <div class=\"font-mono text-[11px] text-[#777d5d]\">OBSERVATION DIMENSION</div>\n            <div class=\"mt-2 font-mono text-sm text-[#deff00]\">obs_dim = window × n_features + 5</div>\n            <div class=\"mt-2 text-sm leading-5 text-[#a8ad83]\">n_features comes from the feature contract; it is not hard-coded.</div>\n          </div>\n          <div class=\"p-4\">\n            <div class=\"font-mono text-[11px] text-[#777d5d]\">HASH / FEATURE NAMES</div>\n            <div class=\"mt-2 text-sm text-white\">Not checked</div>\n            <div class=\"mt-2 text-sm leading-5 text-[#a8ad83]\">Validate contract hash, feature names and normalization before reusing an artifact.</div>\n          </div>\n        </div>\n      </section>\n\n      <section aria-labelledby=\"preset-title\" class=\"mt-6\">\n        <div class=\"flex flex-wrap items-end justify-between gap-3 border-b border-[#262d05] pb-3\">\n          <div><h2 id=\"preset-title\" class=\"text-2xl font-bold text-white\">Training preset</h2><p class=\"mt-1 text-sm text-[#a8ad83]\">Choose a verified script. Preset names and script targets match the project inventory.</p></div>\n          <span class=\"font-mono text-xs text-[#deff00]\">8 AVAILABLE PRESETS</span>\n        </div>\n        <div class=\"mt-3 grid grid-cols-4 gap-px border border-[#262d05] bg-[#262d05]\">\n          <div aria-current=\"true\" class=\"bg-[#deff00] px-4 py-3 text-black\"><div class=\"font-bold\">dreamer <span class=\"ml-1 font-mono text-[10px]\">SELECTED</span></div><div class=\"mt-1 font-mono text-[11px]\">train/train_dreamer.py</div></div>\n          <div class=\"bg-black px-4 py-3\"><div class=\"font-semibold text-white\">transformer</div><div class=\"mt-1 font-mono text-[11px] text-[#a8ad83]\">train/train_transformer.py</div></div>\n          <div class=\"bg-black px-4 py-3\"><div class=\"font-semibold text-white\">ppo</div><div class=\"mt-1 font-mono text-[11px] text-[#a8ad83]\">train/train_ppo.py</div></div>\n          <div class=\"bg-black px-4 py-3\"><div class=\"font-semibold text-white\">ensemble</div><div class=\"mt-1 font-mono text-[11px] text-[#a8ad83]\">train/train_ensemble.py</div></div>\n          <div class=\"bg-black px-4 py-3\"><div class=\"font-semibold text-white\">god-mode</div><div class=\"mt-1 font-mono text-[11px] text-[#a8ad83]\">train/train_god_mode.py</div></div>\n          <div class=\"bg-black px-4 py-3\"><div class=\"font-semibold text-white\">ultimate-150</div><div class=\"mt-1 font-mono text-[11px] text-[#a8ad83]\">train/train_ultimate_150.py</div></div>\n          <div class=\"bg-black px-4 py-3\"><div class=\"font-semibold text-white\">adversarial</div><div class=\"mt-1 font-mono text-[11px] text-[#a8ad83]\">train/train_adversarial.py</div></div>\n          <div class=\"bg-black px-4 py-3\"><div class=\"font-semibold text-white\">meta-train</div><div class=\"mt-1 font-mono text-[11px] text-[#a8ad83]\">train/meta_train_dreamer.py</div></div>\n        </div>\n\n        <div class=\"mt-4 border border-[#262d05]\">\n          <div class=\"flex flex-wrap items-center justify-between gap-3 border-b border-[#262d05] px-5 py-3\">\n            <div><h3 class=\"text-lg font-semibold text-white\">Dreamer · resolved defaults</h3><div class=\"mt-1 font-mono text-xs text-[#a8ad83]\">train/train_dreamer.py</div></div>\n            <div class=\"border border-[#414627] px-3 py-2 font-mono text-xs text-[#deff00]\">--device auto → CPU</div>\n          </div>\n          <div class=\"grid grid-cols-6 gap-x-5 gap-y-0 px-5 py-3\">\n            <div class=\"border-b border-[#262d05] py-2\"><div class=\"font-mono text-[11px] text-[#929878]\">--steps</div><div class=\"font-mono text-sm text-white\">100000</div></div>\n            <div class=\"border-b border-[#262d05] py-2\"><div class=\"font-mono text-[11px] text-[#929878]\">--prefill</div><div class=\"font-mono text-sm text-white\">5000</div></div>\n            <div class=\"border-b border-[#262d05] py-2\"><div class=\"font-mono text-[11px] text-[#929878]\">--batch-size</div><div class=\"font-mono text-sm text-white\">16</div></div>\n            <div class=\"border-b border-[#262d05] py-2\"><div class=\"font-mono text-[11px] text-[#929878]\">--train-every</div><div class=\"font-mono text-sm text-white\">4</div></div>\n            <div class=\"border-b border-[#262d05] py-2\"><div class=\"font-mono text-[11px] text-[#929878]\">--seq-len</div><div class=\"font-mono text-sm text-white\">64</div></div>\n            <div class=\"border-b border-[#262d05] py-2\"><div class=\"font-mono text-[11px] text-[#929878]\">--window</div><div class=\"font-mono text-sm text-white\">64</div></div>\n            <div class=\"border-b border-[#262d05] py-2\"><div class=\"font-mono text-[11px] text-[#929878]\">--embed-dim</div><div class=\"font-mono text-sm text-white\">256</div></div>\n            <div class=\"border-b border-[#262d05] py-2\"><div class=\"font-mono text-[11px] text-[#929878]\">--hidden-dim</div><div class=\"font-mono text-sm text-white\">512</div></div>\n            <div class=\"py-2\"><div class=\"font-mono text-[11px] text-[#929878]\">--stoch-dim</div><div class=\"font-mono text-sm text-white\">32</div></div>\n            <div class=\"py-2\"><div class=\"font-mono text-[11px] text-[#929878]\">--num-categories</div><div class=\"font-mono text-sm text-white\">32</div></div>\n            <div class=\"py-2\"><div class=\"font-mono text-[11px] text-[#929878]\">--horizon</div><div class=\"font-mono text-sm text-white\">15</div></div>\n            <div class=\"py-2\"><div class=\"font-mono text-[11px] text-[#929878]\">--train-end</div><div class=\"font-mono text-sm text-white\">2022-01-01</div></div>\n          </div>\n          <div class=\"grid grid-cols-[1fr_1fr] border-t border-[#262d05]\">\n            <div class=\"p-4\">\n              <div class=\"font-semibold text-white\">SL/TP action mode</div>\n              <div class=\"mt-1 text-sm text-[#a8ad83]\">Rules / off · legacy 3-action environment; ATR rules determine SL/TP.</div>\n              <div class=\"mt-3 font-mono text-xs text-[#deff00]\">--sl-tp-model · OFF</div>\n            </div>\n            <div class=\"border-l border-[#262d05] bg-[#101400] p-4\">\n              <div class=\"font-semibold text-white\">Optional model mode · 75 actions</div>\n              <div class=\"mt-1 text-sm leading-5 text-[#c4c99f]\">Composite actions: direction 3 × SL bucket 5 × TP bucket 5.</div>\n              <div class=\"mt-2 font-mono text-xs leading-5 text-[#deff00]\">SL / TP fractions: 0.005 · 0.01 · 0.02 · 0.03 · 0.05</div>\n              <div class=\"mt-1 font-mono text-[11px] text-[#a8ad83]\">idx = dir × 25 + sl_idx × 5 + tp_idx</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"mt-6 border-t border-[#262d05] pt-4\">\n          <div class=\"mb-3 flex flex-wrap items-end justify-between gap-2\">\n            <h3 class=\"text-lg font-semibold text-white\">Base manifest for staged runs</h3>\n            <span class=\"font-mono text-xs text-[#a8ad83]\">REQUIRED FOR ADVERSARIAL / META-TRAIN</span>\n          </div>\n          <div class=\"grid grid-cols-[0.9fr_1.1fr] border border-[#262d05]\">\n          <div class=\"border-r border-[#262d05] p-4\">\n            <h3 class=\"font-semibold text-white\">Base-manifest selector</h3>\n            <p class=\"mt-2 text-sm leading-5 text-[#a8ad83]\">adversarial and meta-train require a compatible base manifest before they can run.</p>\n            <div class=\"mt-3 font-mono text-xs text-[#777d5d]\">BASE MANIFEST · NOT SELECTED</div>\n            <div class=\"mt-2 border border-[#414627] px-3 py-2 font-mono text-xs text-[#a8ad83]\">Selection and compatibility · Not checked</div>\n          </div>\n          <div class=\"bg-[#101400] p-4\">\n            <h3 class=\"font-semibold text-white\">Base artifact checks</h3>\n            <p class=\"mt-2 text-sm leading-5 text-[#c4c99f]\">For staged runs: validate manifest version, model and contract files, contract hash, and <span class=\"font-mono text-[#deff00]\">obs_dim = window × n_features + 5</span>. Resume checkpoints require the same dimension check.</p>\n            <p class=\"mt-2 text-xs leading-5 text-[#a8ad83]\">Evaluation state is shown per artifact. Selecting a base manifest does not imply it passed evaluation or is promotable.</p>\n          </div>\n          </div>\n        </div>\n      </section>\n\n      <section aria-labelledby=\"preflight-title\" class=\"mt-7\">\n        <div class=\"flex flex-wrap items-end justify-between gap-3 border-b border-[#262d05] pb-3\">\n          <div><h2 id=\"preflight-title\" class=\"text-2xl font-bold text-white\">Preflight</h2><p class=\"mt-1 text-sm text-[#a8ad83]\">Verified facts are separated from checks that need the supervisor.</p></div>\n          <span class=\"font-mono text-xs text-[#ff8b8b]\">SERVER CHECKS · NOT CHECKED</span>\n        </div>\n        <div class=\"mt-4 grid grid-cols-[minmax(0,1fr)_300px] gap-5\">\n          <div class=\"divide-y divide-[#262d05] border-y border-[#262d05]\">\n            <div class=\"grid grid-cols-[28px_minmax(0,1fr)_120px] items-center gap-3 py-3\"><span class=\"font-mono text-lg text-[#deff00]\">✓</span><div><div class=\"font-semibold text-white\">Data CSV exists</div><div class=\"font-mono text-xs text-[#a8ad83]\">data/xauusd_h1.csv</div></div><span class=\"text-right font-mono text-[11px] text-[#deff00]\">VERIFIED</span></div>\n            <div class=\"grid grid-cols-[28px_minmax(0,1fr)_120px] items-center gap-3 py-3\"><span class=\"font-mono text-lg text-[#deff00]\">✓</span><div><div class=\"font-semibold text-white\">Virtual environment exists</div><div class=\"font-mono text-xs text-[#a8ad83]\">.venv\\Scripts\\python.exe</div></div><span class=\"text-right font-mono text-[11px] text-[#deff00]\">VERIFIED</span></div>\n            <div class=\"grid grid-cols-[28px_minmax(0,1fr)_120px] items-center gap-3 py-3\"><span aria-hidden=\"true\" class=\"mx-auto block h-3 w-3 rounded-full border border-[#777d5d]\"></span><div><div class=\"font-semibold text-white\">Contract exists for window 64; hash and dimensions match</div><div class=\"text-xs text-[#a8ad83]\">Requires feature_contract.json and runtime n_features.</div></div><span class=\"text-right font-mono text-[11px] text-[#a8ad83]\">NOT CHECKED</span></div>\n            <div class=\"grid grid-cols-[28px_minmax(0,1fr)_120px] items-center gap-3 py-3\"><span class=\"font-mono text-lg text-[#777d5d]\">—</span><div><div class=\"font-semibold text-white\">Train-end split falls inside data range</div><div class=\"text-xs text-[#a8ad83]\">Server must inspect the CSV date range.</div></div><span class=\"text-right font-mono text-[11px] text-[#a8ad83]\">NOT CHECKED</span></div>\n            <div class=\"grid grid-cols-[28px_minmax(0,1fr)_120px] items-center gap-3 py-3\"><span class=\"font-mono text-lg text-[#777d5d]\">—</span><div><div class=\"font-semibold text-white\">Hyperparameters pass schema and range checks</div><div class=\"text-xs text-[#a8ad83]\">Backend re-validates CLI flags before spawn.</div></div><span class=\"text-right font-mono text-[11px] text-[#a8ad83]\">NOT CHECKED</span></div>\n            <div class=\"grid grid-cols-[28px_minmax(0,1fr)_120px] items-center gap-3 py-3\"><span class=\"font-mono text-lg text-[#777d5d]\">—</span><div><div class=\"font-semibold text-white\">Run name is free and artifact directory available</div><div class=\"text-xs text-[#a8ad83]\">Run name is blank; server validation unavailable.</div></div><span class=\"text-right font-mono text-[11px] text-[#a8ad83]\">NOT CHECKED</span></div>\n            <div class=\"grid grid-cols-[28px_minmax(0,1fr)_120px] items-center gap-3 py-3\"><span class=\"font-mono text-lg text-[#777d5d]\">—</span><div><div class=\"font-semibold text-white\">Disk space sufficient for checkpoints and logs</div><div class=\"text-xs text-[#a8ad83]\">Supervisor must report available space.</div></div><span class=\"text-right font-mono text-[11px] text-[#a8ad83]\">NOT CHECKED</span></div>\n            <div class=\"grid grid-cols-[28px_minmax(0,1fr)_120px] items-center gap-3 py-3\"><span class=\"font-mono text-lg text-[#777d5d]\">—</span><div><div class=\"font-semibold text-white\">No other training job is running</div><div class=\"text-xs text-[#a8ad83]\">One-job concurrency guard requires supervisor state.</div></div><span class=\"text-right font-mono text-[11px] text-[#a8ad83]\">NOT CHECKED</span></div>\n            <div class=\"grid grid-cols-[28px_minmax(0,1fr)_120px] items-center gap-3 py-3\"><span class=\"font-mono text-lg text-[#777d5d]\">—</span><div><div class=\"font-semibold text-white\">Base manifest selected and compatible</div><div class=\"text-xs text-[#a8ad83]\">Required only for adversarial or meta-train; validation is server-side.</div></div><span class=\"text-right font-mono text-[11px] text-[#a8ad83]\">NOT CHECKED</span></div>\n          </div>\n          <aside class=\"self-start border border-[#262d05] bg-[#101400] p-5\">\n            <div class=\"flex items-center gap-2\"><i class=\"ti ti-lock text-lg text-[#deff00]\"></i><h3 class=\"text-lg font-bold text-white\">Launch unavailable</h3></div>\n            <p class=\"mt-3 text-sm leading-6 text-[#d1d6b2]\">The supervisor API is not connected. No process will be spawned and no server validation is represented as passed.</p>\n            <div class=\"mt-5 border-t border-[#262d05] pt-4\">\n              <div class=\"font-mono text-[11px] text-[#929878]\">RUN NAME</div>\n              <div class=\"mt-2 font-mono text-sm text-[#777d5d]\">Blank</div>\n            </div>\n            <button type=\"button\" disabled class=\"mt-5 w-full border border-[#555a36] bg-[#777d5d] px-4 py-3 text-left font-bold text-black opacity-60\">Launch run <span class=\"float-right font-mono text-xs\">DISABLED</span></button>\n            <p class=\"mt-3 font-mono text-[11px] leading-5 text-[#a8ad83]\">Enable only after every required preflight check passes and the supervisor is available.</p>\n          </aside>\n        </div>\n        <div class=\"mt-4 border-t border-[#262d05] pt-3 text-xs leading-5 text-[#929878]\">Training may be prepared in demo mode. This screen does not start live trading and does not grant model promotability.</div>\n      </section>\n    </main>\n  </div>\n</div>",
      "comments": [],
      "created": "2026-10-04T12:15:48.830973+00:00",
      "modified": "2026-10-04T12:15:48.830973+00:00",
      "id": "var_589c4d2550bf"
    },
    "var_d6de6d430dc5": {
      "type": "variant",
      "label": "V3 · Training · Artifact strata",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 12320,
        "y": 0,
        "w": 1440,
        "h": 2257
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@500;600&family=DM+Sans:wght@400;500;600;700&family=Josefin+Slab:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css');\nh1, h2, h3 { font-family: 'Josefin Slab', serif; }\n</style>\n<div class=\"min-h-screen bg-[#1E000E] text-[#D6E6CA]\" style=\"font-family:'DM Sans',sans-serif\">\n  <div class=\"mx-auto max-w-[1440px] px-8 pb-12 pt-6\">\n    <header class=\"flex items-center justify-between border-b border-[#594248] pb-5\">\n      <div class=\"flex items-center gap-4\">\n        <div class=\"flex h-11 w-11 items-center justify-center border border-[#C05746] text-[#EBA294]\" aria-hidden=\"true\"><span class=\"text-xl\" style=\"font-family:'Bodoni Moda',serif\">X</span></div>\n        <div>\n          <div class=\"flex items-baseline gap-2\"><span class=\"text-2xl font-medium tracking-tight\" style=\"font-family:'Bodoni Moda',serif\">XAUUSD</span><span class=\"text-[#80676b]\">/</span><span class=\"text-base text-[#D6E6CA]\">Research terminal</span></div>\n          <p class=\"mt-1 text-sm text-[#B7A4A4]\">Training evidence · local control plane</p>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-6 font-mono text-xs\">\n        <div class=\"flex items-center gap-2\"><span class=\"h-2 w-2 rounded-full bg-[#ADC698]\"></span><span class=\"text-[#D6E6CA]\">TRADING_MODE</span><span class=\"text-[#ADC698]\">demo</span></div>\n        <span class=\"h-5 border-l border-[#594248]\"></span>\n        <div class=\"flex items-center gap-2 text-[#EBA294]\"><i class=\"bx bx-lock-alt text-xl\"></i><span>BLOCKED — no promoted model</span></div>\n      </div>\n    </header>\n\n    <nav aria-label=\"Primary\" class=\"flex flex-wrap items-center gap-x-7 gap-y-1 border-b border-[#594248] text-[16px] font-medium\">\n      <a class=\"border-b-2 border-transparent py-4 text-[#B7A4A4] no-underline\" href=\"javascript:void(0)\">Operations</a>\n      <a aria-current=\"page\" class=\"border-b-2 border-[#C05746] py-4 text-[#D6E6CA] no-underline\" href=\"javascript:void(0)\">Training</a>\n      <a class=\"border-b-2 border-transparent py-4 text-[#B7A4A4] no-underline\" href=\"javascript:void(0)\">Prepare Run</a>\n      <a class=\"border-b-2 border-transparent py-4 text-[#B7A4A4] no-underline\" href=\"javascript:void(0)\">Models/Evaluation</a>\n      <a class=\"border-b-2 border-transparent py-4 text-[#B7A4A4] no-underline\" href=\"javascript:void(0)\">Risk/Settings</a>\n    </nav>\n\n    <section class=\"mt-6 grid grid-cols-1 gap-5 border border-[#594248] bg-[#29171D] px-6 py-5 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-8\">\n      <div>\n        <h1 class=\"text-[30px] font-semibold leading-tight\">Training</h1>\n        <p class=\"mt-2 text-[16px] text-[#C3B1AF]\">Supervisor state unavailable <span class=\"px-2 text-[#C05746]\">·</span> No job state has been returned.</p>\n        <div class=\"mt-4 flex flex-wrap gap-x-7 gap-y-2 font-mono text-xs text-[#B7A4A4]\">\n          <span>Job state <b class=\"font-normal text-[#EBA294]\">unavailable</b></span>\n          <span>Active run <b class=\"font-normal text-[#EBA294]\">unavailable</b></span>\n          <span>Device <b class=\"font-normal text-[#D6E6CA]\">CPU-only</b></span>\n        </div>\n      </div>\n      <div class=\"border-t border-[#594248] pt-4 lg:border-l lg:border-t-0 lg:pl-6 lg:pt-0\">\n        <div class=\"flex items-center gap-2 text-[16px] font-semibold\"><i class=\"bx bx-lock-alt text-xl text-[#EBA294]\"></i> Production gate</div>\n        <p class=\"mt-2 font-mono text-sm text-[#EBA294]\">BLOCKED — no promoted model</p>\n        <p class=\"mt-2 text-sm leading-5 text-[#B7A4A4]\">No production manifest exists. Existing evaluations have not passed promotion.</p>\n      </div>\n    </section>\n\n    <div class=\"mt-4 grid grid-cols-1 border-y border-[#594248] py-3 font-mono text-xs sm:grid-cols-3\">\n      <div class=\"flex items-center gap-3\"><span class=\"text-[#8F7A7E]\">SUPERVISOR</span><span class=\"text-[#EBA294]\">Unavailable</span></div>\n      <div class=\"flex items-center justify-center gap-3 border-y border-[#594248] py-2 sm:border-x sm:border-y-0 sm:py-0\"><span class=\"text-[#8F7A7E]\">TRAINING METRICS</span><span class=\"text-[#EBA294]\">No stream</span></div>\n      <div class=\"flex items-center justify-end gap-3\"><span class=\"text-[#8F7A7E]\">RESOURCE DEVICE</span><span class=\"text-[#D6E6CA]\">CPU-only</span></div>\n    </div>\n\n    <main>\n      <section class=\"mt-8\" aria-labelledby=\"metric-heading\">\n        <div class=\"mb-4 flex flex-wrap items-end justify-between gap-3\">\n          <div>\n            <h2 id=\"metric-heading\" class=\"text-[23px] font-semibold\">Dreamer training metrics</h2>\n            <p class=\"mt-1 text-sm text-[#B7A4A4]\">No active job data · the plot is intentionally empty.</p>\n          </div>\n          <p class=\"font-mono text-xs text-[#A89495]\">Source: <span class=\"text-[#D6E6CA]\">DreamerV3Agent.train_step()</span></p>\n        </div>\n        <div class=\"grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_330px]\">\n          <div class=\"border border-[#594248] bg-[#29171D] p-5\">\n            <div class=\"flex flex-wrap items-center justify-between gap-2 border-b border-[#594248] pb-3\">\n              <h3 class=\"text-lg font-semibold\">Loss history</h3>\n              <span class=\"font-mono text-xs text-[#A89495]\">No series available</span>\n            </div>\n            <div class=\"relative mt-4 h-[286px] border border-[#483038] bg-[#1E000E]\">\n              <div class=\"absolute inset-x-0 top-1/4 border-t border-[#35232A]\"></div>\n              <div class=\"absolute inset-x-0 top-2/4 border-t border-[#35232A]\"></div>\n              <div class=\"absolute inset-x-0 top-3/4 border-t border-[#35232A]\"></div>\n              <div class=\"absolute inset-y-0 left-1/4 border-l border-[#35232A]\"></div>\n              <div class=\"absolute inset-y-0 left-2/4 border-l border-[#35232A]\"></div>\n              <div class=\"absolute inset-y-0 left-3/4 border-l border-[#35232A]\"></div>\n              <div class=\"absolute inset-0 flex flex-col items-center justify-center text-center\">\n                <span class=\"mb-3 flex h-9 w-9 items-center justify-center rounded-full border border-[#74565D] text-[#B7A4A4]\"><i class=\"bx bx-line-chart text-xl\"></i></span>\n                <p class=\"text-[16px] font-semibold\">Waiting for supervisor metrics</p>\n                <p class=\"mt-1 font-mono text-xs text-[#A89495]\">No values or series received</p>\n              </div>\n            </div>\n            <div class=\"mt-3 flex justify-between font-mono text-xs text-[#A89495]\"><span>x-axis · training_step</span><span>y-axis · metric value</span></div>\n          </div>\n          <aside class=\"border border-[#594248] bg-[#29171D] px-5 py-4\" aria-label=\"Dreamer metric keys\">\n            <div class=\"flex items-baseline justify-between border-b border-[#594248] pb-3\"><h3 class=\"text-lg font-semibold\">Metric keys</h3><span class=\"font-mono text-[11px] text-[#A89495]\">7 fields</span></div>\n            <ul class=\"mt-2 list-none p-0 font-mono text-[13px] leading-[1.25rem]\">\n              <li class=\"border-b border-[#483038] py-[9px]\">world_model_loss</li>\n              <li class=\"border-b border-[#483038] py-[9px]\">recon_loss</li>\n              <li class=\"border-b border-[#483038] py-[9px]\">reward_loss</li>\n              <li class=\"border-b border-[#483038] py-[9px]\">kl_loss</li>\n              <li class=\"border-b border-[#483038] py-[9px]\">value_loss</li>\n              <li class=\"border-b border-[#483038] py-[9px]\">policy_loss</li>\n              <li class=\"py-[9px]\">entropy</li>\n            </ul>\n            <p class=\"mt-2 border-t border-[#594248] pt-3 text-sm leading-5 text-[#A89495]\">Metric values stay blank until supplied by a training process.</p>\n          </aside>\n        </div>\n      </section>\n\n      <section class=\"mt-8 grid grid-cols-1 gap-x-10 gap-y-7 md:grid-cols-2\">\n        <div>\n          <div class=\"flex flex-wrap items-center justify-between gap-2 border-b border-[#594248] pb-3\">\n            <h2 class=\"text-xl font-semibold\">Environment ticker</h2><span class=\"font-mono text-xs text-[#EBA294]\">Unavailable</span>\n          </div>\n          <p class=\"mt-3 text-sm text-[#B7A4A4]\">No environment step records have been supplied.</p>\n          <div class=\"mt-4 overflow-x-auto\">\n            <table class=\"w-full min-w-[560px] border-collapse text-left font-mono text-xs\">\n              <thead><tr class=\"border-b border-[#594248] text-[#A89495]\"><th class=\"py-2 pr-3 font-normal\">equity</th><th class=\"px-3 py-2 font-normal\">position</th><th class=\"px-3 py-2 font-normal\">pnl</th><th class=\"px-3 py-2 font-normal\">return</th><th class=\"px-3 py-2 font-normal\">cost</th><th class=\"px-3 py-2 font-normal\">swap</th><th class=\"px-3 py-2 font-normal\">drawdown</th><th class=\"px-3 py-2 font-normal\">forced_close</th><th class=\"px-3 py-2 font-normal\">blown_up</th></tr></thead>\n              <tbody><tr><td class=\"py-3 pr-3 text-[#EBA294]\">—</td><td class=\"px-3 py-3 text-[#EBA294]\">—</td><td class=\"px-3 py-3 text-[#EBA294]\">—</td><td class=\"px-3 py-3 text-[#EBA294]\">—</td><td class=\"px-3 py-3 text-[#EBA294]\">—</td><td class=\"px-3 py-3 text-[#EBA294]\">—</td><td class=\"px-3 py-3 text-[#EBA294]\">—</td><td class=\"px-3 py-3 text-[#EBA294]\">—</td><td class=\"px-3 py-3 text-[#EBA294]\">—</td></tr></tbody>\n            </table>\n          </div>\n          <p class=\"mt-2 font-mono text-[11px] text-[#8F7A7E]\">Source: RealisticTradingEnv.step() info · no ticker feed</p>\n        </div>\n\n        <div>\n          <div class=\"flex flex-wrap items-center justify-between gap-2 border-b border-[#594248] pb-3\">\n            <h2 class=\"text-xl font-semibold\">Replay buffer</h2><span class=\"font-mono text-xs text-[#ADC698]\">Documented configuration</span>\n          </div>\n          <div class=\"mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1\">\n            <span class=\"font-mono text-[30px] leading-none\">100,000</span><span class=\"text-[#B7A4A4]\">capacity</span>\n            <span class=\"ml-2 border-l border-[#594248] pl-3 font-mono text-sm\">seq_len <b class=\"font-normal text-[#ADC698]\">64</b></span>\n          </div>\n          <p class=\"mt-3 border-l-2 border-[#C05746] pl-3 text-sm leading-5 text-[#B7A4A4]\">Defaults only. Current buffer size, fill and prefill progress are unavailable.</p>\n          <p class=\"mt-2 font-mono text-[11px] text-[#8F7A7E]\">Source: ReplayBuffer configuration · no live buffer reading</p>\n        </div>\n\n        <div>\n          <div class=\"flex flex-wrap items-center justify-between gap-2 border-b border-[#594248] pb-3\">\n            <h2 class=\"text-xl font-semibold\">Regime labels</h2><span class=\"font-mono text-xs text-[#A89495]\">Vocabulary only</span>\n          </div>\n          <div class=\"mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[13px]\">\n            <span>trend_up</span><span class=\"text-[#70585D]\">·</span><span>trend_down</span><span class=\"text-[#70585D]\">·</span><span>range</span><span class=\"text-[#70585D]\">·</span><span>high_vol</span><span class=\"text-[#70585D]\">·</span><span>low_vol</span><span class=\"text-[#70585D]\">·</span><span class=\"text-[#A89495]\">unknown</span>\n          </div>\n          <p class=\"mt-3 text-sm text-[#B7A4A4]\">No regime timeline, counts or distribution supplied.</p>\n          <p class=\"mt-2 font-mono text-[11px] text-[#8F7A7E]\">Source: MarketRegimeGenerator labels · no labels charted</p>\n        </div>\n\n        <div>\n          <div class=\"flex flex-wrap items-center justify-between gap-2 border-b border-[#594248] pb-3\">\n            <h2 class=\"text-xl font-semibold\">Resources</h2><span class=\"font-mono text-xs text-[#EBA294]\">Readings unavailable</span>\n          </div>\n          <div class=\"mt-4 grid grid-cols-1 gap-4 font-mono text-xs sm:grid-cols-3\">\n            <div><span class=\"text-[#A89495]\">Device</span><p class=\"mt-1 text-sm text-[#D6E6CA]\">CPU-only</p></div>\n            <div><span class=\"text-[#A89495]\">CPU usage</span><p class=\"mt-1 text-sm text-[#EBA294]\">— unavailable</p></div>\n            <div><span class=\"text-[#A89495]\">RAM</span><p class=\"mt-1 text-sm text-[#EBA294]\">— unavailable</p></div>\n          </div>\n          <p class=\"mt-3 font-mono text-[11px] text-[#8F7A7E]\">CPU/RAM source: supervisor process readings · no resource feed</p>\n        </div>\n      </section>\n\n      <section class=\"mt-8 border-y border-[#594248] py-5\">\n        <div class=\"flex flex-wrap items-end justify-between gap-3\">\n          <div><h2 class=\"text-xl font-semibold\">Run controls</h2><p class=\"mt-1 text-sm text-[#B7A4A4]\">Supervisor-only actions · unavailable before API implementation.</p></div>\n          <span class=\"font-mono text-xs text-[#EBA294]\">No control request can be sent</span>\n        </div>\n        <div class=\"mt-5 grid grid-cols-1 gap-6 lg:grid-cols-[1fr_2fr] lg:gap-8\">\n          <div>\n            <h3 class=\"text-sm font-semibold\">Start a run</h3>\n            <button type=\"button\" disabled class=\"mt-3 cursor-not-allowed border border-[#735256] bg-[#3F2A2B] px-5 py-3 text-sm font-semibold text-[#A89495]\">Start training</button>\n            <p class=\"mt-2 text-sm text-[#A89495]\">Disabled · supervisor API not implemented.</p>\n          </div>\n          <div class=\"border-t border-[#594248] pt-5 lg:border-l lg:border-t-0 lg:pl-6 lg:pt-0\">\n            <h3 class=\"text-sm font-semibold\">Current run actions</h3>\n            <div class=\"mt-3 flex flex-wrap gap-2\">\n              <button type=\"button\" disabled class=\"cursor-not-allowed border border-[#594248] px-4 py-3 text-sm text-[#8F7A7E]\">Pause</button>\n              <button type=\"button\" disabled class=\"cursor-not-allowed border border-[#594248] px-4 py-3 text-sm text-[#8F7A7E]\">Resume</button>\n              <button type=\"button\" disabled class=\"cursor-not-allowed border border-[#735256] px-4 py-3 text-sm text-[#A89495]\">Stop cleanly</button>\n              <button type=\"button\" disabled class=\"cursor-not-allowed border border-[#8B514C] bg-[#3F2A2B] px-4 py-3 text-sm text-[#C57D73]\">Kill process</button>\n            </div>\n            <p class=\"mt-2 text-sm text-[#A89495]\">Pause, resume, clean stop and hard kill are separate supervisor actions; all are unavailable here.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"mt-8\" aria-labelledby=\"records-heading\">\n        <div class=\"flex flex-wrap items-end justify-between gap-3 border-b border-[#594248] pb-4\">\n          <div>\n            <h2 id=\"records-heading\" class=\"text-[23px] font-semibold\">Evaluated artifacts</h2>\n            <p class=\"mt-1 text-sm text-[#B7A4A4]\">Historical evaluation files · these are not running jobs.</p>\n          </div>\n          <span class=\"font-mono text-xs text-[#EBA294]\">3 records · 0 promotable</span>\n        </div>\n        <div class=\"mt-4 grid grid-cols-1 gap-5 xl:grid-cols-[minmax(0,1fr)_260px] xl:gap-7\">\n          <div class=\"overflow-x-auto\">\n            <table class=\"w-full min-w-[810px] border-collapse text-left\">\n              <thead><tr class=\"border-b border-[#594248] font-mono text-[11px] text-[#A89495]\"><th class=\"py-3 pr-4 font-normal\">EVALUATION ARTIFACT</th><th class=\"px-3 py-3 font-normal\">SHARPE</th><th class=\"px-3 py-3 font-normal\">RETURN</th><th class=\"px-3 py-3 font-normal\">MAX DD</th><th class=\"px-3 py-3 font-normal\">TRADES</th><th class=\"px-3 py-3 font-normal\">GATE</th></tr></thead>\n              <tbody class=\"font-mono text-[12px]\">\n                <tr class=\"border-b border-[#483038] align-top\">\n                  <td class=\"py-4 pr-4\"><div class=\"text-[#D6E6CA]\">dreamer_20261003T230304213562Z</div><div class=\"mt-1 text-[11px] text-[#8F7A7E]\">evaluation.json · 2026-10-03 23:03 UTC</div></td>\n                  <td class=\"px-3 py-4\">3.10</td><td class=\"px-3 py-4\">+6.04%</td><td class=\"px-3 py-4\">3.04%</td><td class=\"px-3 py-4\"><span class=\"text-[#D6E6CA]\">3 trades (&lt;20)</span><span class=\"block mt-1 text-[11px] text-[#EBA294]\">20 required</span></td><td class=\"px-3 py-4 text-[#EBA294]\">NOT PROMOTABLE</td>\n                </tr>\n                <tr class=\"border-b border-[#483038] align-top\">\n                  <td class=\"py-4 pr-4\"><div class=\"text-[#D6E6CA]\">dreamer_20261003T230535411560Z</div><div class=\"mt-1 text-[11px] text-[#8F7A7E]\">evaluation.json · 2026-10-03 23:06 UTC</div></td>\n                  <td class=\"px-3 py-4\">1.71</td><td class=\"px-3 py-4\">+0.02%</td><td class=\"px-3 py-4\">0.02%</td><td class=\"px-3 py-4\"><span class=\"text-[#D6E6CA]\">1 trade</span><span class=\"block mt-1 text-[11px] text-[#EBA294]\">20 required</span></td><td class=\"px-3 py-4 text-[#EBA294]\">NOT PROMOTABLE</td>\n                </tr>\n                <tr class=\"align-top\">\n                  <td class=\"py-4 pr-4\"><div class=\"text-[#D6E6CA]\">ppo_gold_v1</div><div class=\"mt-1 text-[11px] text-[#8F7A7E]\">evaluation.json · 2026-09-30 16:52 UTC</div></td>\n                  <td class=\"px-3 py-4 text-[#EBA294]\">-3.21</td><td class=\"px-3 py-4 text-[#EBA294]\">-74.74%</td><td class=\"px-3 py-4 text-[#EBA294]\">74.78%</td><td class=\"px-3 py-4\">2,849</td><td class=\"px-3 py-4 text-[#EBA294]\">NOT PROMOTABLE</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n          <aside class=\"bg-[#3A5743] px-5 py-5 text-[#D6E6CA]\">\n            <div class=\"flex items-center gap-2 text-sm font-semibold\"><i class=\"bx bx-folder-open text-xl\"></i> Production slot</div>\n            <p class=\"mt-7 border-t border-[#729078] pt-4 text-[22px] font-semibold\">None trained</p>\n            <p class=\"mt-1 text-sm text-[#D0DDC7]\">Production manifest missing.</p>\n          </aside>\n        </div>\n        <div class=\"mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-[#594248] pt-3 font-mono text-[11px] text-[#A89495]\">\n          <p>Promotion gate: Sharpe ≥ 0.50 · max DD ≤ 20% · trades ≥ 20 · total return &gt; 0%</p>\n          <p>Source: artifacts/models/&lt;run&gt;/evaluation.json · passed: false for all listed</p>\n        </div>\n      </section>\n\n      <section class=\"mt-8 grid grid-cols-1 gap-6 border-t border-[#594248] pt-5 md:grid-cols-2 xl:grid-cols-3\">\n        <div>\n          <div class=\"flex items-center justify-between border-b border-[#594248] pb-3\"><h2 class=\"text-lg font-semibold\">Checkpoints</h2><span class=\"font-mono text-xs text-[#EBA294]\">Unavailable</span></div>\n          <p class=\"mt-3 text-sm text-[#B7A4A4]\">No supervisor checkpoint timeline supplied.</p>\n          <p class=\"mt-2 font-mono text-[11px] text-[#8F7A7E]\">Source: checkpoint files · no listing available</p>\n        </div>\n        <div>\n          <div class=\"flex items-center justify-between border-b border-[#594248] pb-3\"><h2 class=\"text-lg font-semibold\">Logs</h2><span class=\"font-mono text-xs text-[#EBA294]\">Unavailable</span></div>\n          <div class=\"mt-3 border border-[#483038] bg-[#24131A] px-3 py-4 font-mono text-xs text-[#A89495]\">No captured process output available.</div>\n          <p class=\"mt-2 font-mono text-[11px] text-[#8F7A7E]\">Source: supervisor stdout / stderr · no log feed</p>\n        </div>\n        <div>\n          <div class=\"flex items-center justify-between border-b border-[#594248] pb-3\"><h2 class=\"text-lg font-semibold\">Artifact provenance</h2><span class=\"font-mono text-xs text-[#ADC698]\">Verified files</span></div>\n          <p class=\"mt-3 text-sm leading-5 text-[#B7A4A4]\">The rows above are completed evaluations read from artifact files. They do not indicate job activity, progress or a current supervisor state.</p>\n          <p class=\"mt-2 font-mono text-[11px] text-[#8F7A7E]\">No live output fabricated</p>\n        </div>\n      </section>\n    </main>\n    <footer class=\"mt-8 flex flex-wrap justify-between gap-3 border-t border-[#594248] pt-4 font-mono text-[11px] text-[#80676B]\"><span>XAUUSD · Training evidence</span><span>Supervisor API unavailable · display only</span></footer>\n  </div>\n</div>",
