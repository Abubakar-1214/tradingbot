      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Cuprum:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"min-h-full bg-black px-4 py-4 font-['Cuprum',sans-serif] text-[#EDCC69] sm:px-6 sm:py-6\">\n  <div class=\"mx-auto max-w-[1440px] overflow-hidden rounded-[24px] border border-[#554D34] bg-[#0D0A03]\">\n    <header class=\"flex flex-col gap-4 border-b border-[#554D34] px-5 py-4 lg:flex-row lg:items-center lg:justify-between lg:px-7\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"grid size-11 shrink-0 place-items-center rounded-full border border-[#EDCC69]/55 font-['Chakra_Petch',sans-serif] text-xl font-bold\">V1</div>\n        <div>\n          <div class=\"font-['Chakra_Petch',sans-serif] text-lg font-semibold tracking-wide\">XAUUSD <span class=\"text-[#EDCC69]/65\">AI TERMINAL</span></div>\n          <div class=\"text-sm text-[#EDCC69]/70\">Models / Evaluation</div>\n        </div>\n      </div>\n      <div class=\"flex flex-wrap items-center gap-2 text-sm\" aria-label=\"System status\">\n        <div class=\"rounded-full border border-[#554D34] bg-black/40 px-3 py-2 text-[#EDCC69]/75\"><span class=\"text-[#EDCC69]/50\">Process</span> · status unavailable</div>\n        <div class=\"rounded-full border border-[#7B8A68]/65 bg-[#7B8A68]/[.08] px-3 py-2 text-[#D6DDC9]\">Mode · DEMO default</div>\n        <div class=\"rounded-full border border-[#554D34] bg-black/40 px-3 py-2 text-[#EDCC69]/75\">Kill switch · absent at report snapshot</div>\n      </div>\n    </header>\n    <div class=\"grid lg:grid-cols-[216px_minmax(0,1fr)]\">\n      <nav class=\"border-b border-[#554D34] p-3 lg:border-b-0 lg:border-r lg:p-4\" aria-label=\"Main navigation\">\n        <div class=\"flex flex-wrap gap-2 lg:flex-col\">\n          <div class=\"rounded-xl px-4 py-3 text-[15px] text-[#EDCC69]/65\">Operations</div>\n          <div class=\"rounded-xl px-4 py-3 text-[15px] text-[#EDCC69]/65\">Training</div>\n          <div class=\"rounded-xl px-4 py-3 text-[15px] text-[#EDCC69]/65\">Prepare Run</div>\n          <div class=\"rounded-xl border border-[#EDCC69]/35 bg-[#EDCC69]/[.08] px-4 py-3 font-['Chakra_Petch',sans-serif] text-[15px] font-semibold text-[#EDCC69]\" aria-current=\"page\">Models / Evaluation</div>\n          <div class=\"rounded-xl px-4 py-3 text-[15px] text-[#EDCC69]/65\">Risk / Settings</div>\n        </div>\n      </nav>\n      <main class=\"min-w-0 px-4 py-5 sm:px-6 sm:py-7 lg:px-7\">\n        <div class=\"mb-6 flex flex-wrap items-end justify-between gap-3\">\n          <div>\n            <h1 class=\"font-['Chakra_Petch',sans-serif] text-3xl font-semibold tracking-tight sm:text-[34px]\">Models / Evaluation</h1>\n            <p class=\"mt-2 text-base text-[#EDCC69]/75\">Compare each recorded test against the same promotion gate.</p>\n          </div>\n          <div class=\"font-mono text-sm text-[#EDCC69]/65\">3 evaluation records</div>\n        </div>\n\n        <section class=\"mb-7 grid gap-4 xl:grid-cols-[minmax(0,1fr)_310px]\" aria-label=\"Promotion status\">\n          <div class=\"rounded-[22px] border border-[#F4A9A9]/55 bg-[#F4A9A9]/[.055] px-5 py-5 sm:px-6\">\n            <div class=\"flex items-start gap-3\">\n              <span class=\"mt-0.5 text-2xl text-[#F4A9A9]\" aria-hidden=\"true\"><i class=\"ph ph-prohibit\"></i></span>\n              <div>\n                <h2 class=\"font-['Chakra_Petch',sans-serif] text-[22px] font-semibold leading-tight text-[#F4A9A9] sm:text-2xl\">No model has passed the promotion gate</h2>\n                <p class=\"mt-2 text-base leading-6 text-[#EDCC69]/85\">All three evaluations are <strong class=\"font-semibold text-[#F4A9A9]\">NOT PROMOTABLE</strong>. Model-driven live trading remains blocked.</p>\n              </div>\n            </div>\n          </div>\n          <div class=\"rounded-[22px] border border-[#554D34] bg-black/35 px-5 py-5\">\n            <div class=\"text-sm text-[#EDCC69]/65\">Production slot</div>\n            <div class=\"mt-2 font-['Chakra_Petch',sans-serif] text-xl font-semibold\">No production manifest</div>\n            <p class=\"mt-2 text-sm leading-5 text-[#EDCC69]/70\">These evaluation artifacts are not a production model.</p>\n          </div>\n        </section>\n\n        <section class=\"rounded-[22px] border border-[#554D34] bg-black/25 p-4 sm:p-5 lg:p-6\" aria-labelledby=\"ledger-heading\">\n          <div class=\"mb-5 flex flex-wrap items-end justify-between gap-3\">\n            <div>\n              <h2 id=\"ledger-heading\" class=\"font-['Chakra_Petch',sans-serif] text-2xl font-semibold\">Evaluation ledger</h2>\n              <p class=\"mt-1 text-base text-[#EDCC69]/70\">Actual recorded results · rounded for scanning · exact values in each record</p>\n            </div>\n            <div class=\"flex items-center gap-2 text-sm text-[#EDCC69]/65\"><span class=\"inline-block size-2 rounded-full bg-[#F4A9A9]\"></span>Gate failure is explicit per metric</div>\n          </div>\n          <div class=\"eval-matrix overflow-x-auto rounded-xl border-y border-[#554D34]\">\n            <table class=\"w-full min-w-[1010px] border-collapse text-left\" aria-label=\"Model evaluation matrix and promotion thresholds\">\n              <thead>\n                <tr class=\"border-b border-[#554D34] font-['Chakra_Petch',sans-serif] text-sm leading-5 text-[#EDCC69]/85\">\n                  <th scope=\"col\" class=\"w-[30%] py-3 pr-4 font-medium\">Model / evaluation evidence</th>\n                  <th scope=\"col\" class=\"px-3 py-3 font-medium\">Sharpe <span class=\"block font-['Cuprum',sans-serif] text-sm\">≥ 0.5</span></th>\n                  <th scope=\"col\" class=\"px-3 py-3 font-medium\">Max DD <span class=\"block font-['Cuprum',sans-serif] text-sm\">≤ 20%</span></th>\n                  <th scope=\"col\" class=\"px-3 py-3 font-medium\">Trades <span class=\"block font-['Cuprum',sans-serif] text-sm\">≥ 20</span></th>\n                  <th scope=\"col\" class=\"px-3 py-3 font-medium\">Total return <span class=\"block font-['Cuprum',sans-serif] text-sm\">&gt; 0</span></th>\n                  <th scope=\"col\" class=\"px-3 py-3 font-medium\">Buy-and-hold</th>\n                  <th scope=\"col\" class=\"py-3 pl-3 font-medium\">Gate result</th>\n                </tr>\n              </thead>\n              <tbody class=\"text-[15px] [&_th]:py-5 [&_td]:py-5\">\n                <tr class=\"border-b border-[#554D34]/70 align-top\">\n                  <th scope=\"row\" class=\"py-4 pr-4 text-left font-normal\">\n                    <div class=\"font-['Chakra_Petch',sans-serif] text-base font-semibold\">Dreamer</div>\n                    <div class=\"mt-1 break-all font-mono text-[12px] leading-5 text-[#EDCC69]/75\">dreamer_20261003T230304213562Z</div>\n                    <div class=\"mt-2 text-[13px] leading-5 text-[#EDCC69]/70\"><span class=\"text-[#EDCC69]/50\">Evaluated</span> <time datetime=\"2026-10-03T23:03:23.483202+00:00\" class=\"font-mono\">03 Oct 2026 · 23:03 UTC</time></div>\n                    <div class=\"text-[13px] leading-5 text-[#EDCC69]/70\"><span class=\"text-[#EDCC69]/50\">Test</span> <span class=\"font-mono\">31 Aug 2026, 00:00 → 02 Oct 2026, 18:00</span></div>\n                    <details class=\"mt-2 text-[13px] text-[#EDCC69]/85\">\n                      <summary class=\"cursor-pointer list-inside text-[#EDCC69] underline decoration-[#554D34] underline-offset-4\">Full precision &amp; source</summary>\n                      <dl class=\"mt-2 grid grid-cols-[110px_1fr] gap-x-2 gap-y-1 rounded-lg border border-[#554D34]/80 bg-[#0D0A03] p-3 font-mono text-xs leading-5\">\n                        <dt class=\"text-[#EDCC69]/55\">Sharpe</dt><dd>3.104669175667962</dd><dt class=\"text-[#EDCC69]/55\">Max DD %</dt><dd>3.039323949498751</dd><dt class=\"text-[#EDCC69]/55\">Trades</