    "var_8da01de7e8cc": {
      "type": "variant",
      "label": "V2 · Risk · Safe configuration",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 15400,
        "y": 0,
        "w": 1440,
        "h": 2489
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Saira:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\nsection[aria-labelledby=\"limits-title\"] [class*=\"grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)]\"] { min-height: 3.2rem; }\nsection[aria-labelledby=\"limits-title\"] [class*=\"grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)]\"] > :nth-child(2) { text-align: center; }\nsection[aria-labelledby=\"limits-title\"] label { overflow-wrap: break-word; word-break: normal; }\n</style>\n<div class=\"min-h-screen bg-[#080a05] font-[Saira,sans-serif] text-[#edf1d6]\">\n  <header class=\"mx-auto flex max-w-[1440px] items-center justify-between border-b border-[#30371a] px-8 py-5\">\n    <div class=\"flex items-center gap-4\">\n      <div class=\"border border-[#deff00] px-3 py-2 text-sm font-extrabold tracking-tight text-[#deff00]\">XAU<span class=\"text-white\">USD</span></div>\n      <div class=\"hidden border-l border-[#343a20] pl-4 text-sm font-semibold sm:block\">Autonomous trading system</div>\n    </div>\n    <div class=\"flex items-center gap-4 font-[Space_Mono,monospace] text-xs\">\n      <span class=\"hidden text-[#aab18d] sm:inline\">CONTROL PLANE</span>\n      <span class=\"border border-[#5b604a] px-3 py-2 text-[#d1d6bd]\"><span class=\"mr-2 inline-block h-2 w-2 bg-[#a6aa91]\"></span>BACKEND UNAVAILABLE</span>\n    </div>\n  </header>\n\n  <div class=\"mx-auto grid max-w-[1440px] grid-cols-1 gap-7 px-8 py-7 lg:grid-cols-[210px_minmax(0,1fr)]\">\n    <nav aria-label=\"Application\" class=\"border-b border-[#30371a] pb-5 lg:border-b-0 lg:border-r lg:pr-5\">\n      <div class=\"mb-3 font-[Space_Mono,monospace] text-xs text-[#939a78]\">WORKSPACE</div>\n      <div class=\"grid grid-cols-2 gap-1 lg:grid-cols-1\">\n        <div class=\"px-3 py-3 text-[15px] text-[#c5cbaa]\">Operations</div>\n        <div class=\"px-3 py-3 text-[15px] text-[#c5cbaa]\">Training</div>\n        <div class=\"px-3 py-3 text-[15px] text-[#c5cbaa]\">Prepare Run</div>\n        <div class=\"px-3 py-3 text-[15px] text-[#c5cbaa]\">Models / Evaluation</div>\n        <div aria-current=\"page\" class=\"border border-[#deff00] bg-[#deff00] px-3 py-3 text-[15px] font-bold text-black\">Risk / Settings</div>\n      </div>\n      <div class=\"mt-8 hidden border-t border-[#30371a] pt-4 lg:block\">\n        <div class=\"font-[Space_Mono,monospace] text-xs text-[#8f9675]\">TRADING_MODE</div>\n        <div class=\"mt-2 text-lg font-semibold text-[#deff00]\">demo <span class=\"font-normal text-[#c4c9ad]\">· default</span></div>\n      </div>\n    </nav>\n\n    <main id=\"risk-settings\" class=\"min-w-0\">\n      <div class=\"mb-6 flex flex-wrap items-end justify-between gap-4\">\n        <div>\n          <h1 class=\"text-4xl font-extrabold tracking-tight\">Risk / Settings</h1>\n          <p class=\"mt-2 text-[15px] text-[#b6bd9b]\">Risk state, editable limit proposals, and the kill-switch file.</p>\n        </div>\n        <div class=\"border border-[#4a5032] px-4 py-3 font-[Space_Mono,monospace] text-xs\">\n          <span class=\"text-[#aab18d]\">TRADING_MODE</span><span class=\"ml-3 font-bold text-[#deff00]\">DEMO · DEFAULT</span>\n        </div>\n      </div>\n\n      <section aria-labelledby=\"permission-title\" class=\"mb-9 grid border border-[#70201a] xl:grid-cols-[1.05fr_1fr]\">\n        <div class=\"bg-[#8f0000] p-6 text-[#fff2ed] md:p-7\">\n          <div class=\"mb-3 flex items-center gap-2 font-[Space_Mono,monospace] text-xs\"><i class=\"ti ti-lock text-sm\"></i><span>LIVE PERMISSION</span></div>\n          <h2 id=\"permission-title\" class=\"max-w-[560px] text-4xl font-extrabold leading-[1.02] tracking-tight md:text-5xl\">LIVE TRADING<br>BLOCKED</h2>\n          <p class=\"mt-4 max-w-[570px] text-base leading-6\">Live model-driven trading cannot start. The production manifest is absent, and all inspected model evaluations fail the promotion gate.</p>\n        </div>\n        <div class=\"bg-[#11130b] px-6 py-5 md:px-7\">\n          <h3 class=\"mb-1 font-[Space_Mono,monospace] text-xs text-[#deff00]\">PERMISSION BASIS</h3>\n          <div class=\"grid divide-y divide-[#343a20]\">\n            <div class=\"flex flex-wrap items-center justify-between gap-2 py-3\">\n              <span class=\"font-semibold\">Trading mode</span><span class=\"font-[Space_Mono,monospace] text-sm text-[#d9dfbd]\">demo · default</span>\n            </div>\n            <div class=\"flex flex-wrap items-center justify-between gap-2 py-3\">\n              <span class=\"font-semibold\">Production manifest</span><span class=\"font-[Space_Mono,monospace] text-sm text-[#d9dfbd]\">Absent</span>\n            </div>\n            <div class=\"flex flex-wrap items-center justify-between gap-2 py-3\">\n              <span class=\"font-semibold\">Evaluation gate</span><span class=\"font-[Space_Mono,monospace] text-sm text-[#d9dfbd]\">All inspected · passed=false</span>\n            </div>\n            <div class=\"flex flex-wrap items-center justify-between gap-2 pt-3\">\n              <span class=\"font-semibold\">Runtime gate checks</span><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">Unavailable · no backend</span>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section aria-labelledby=\"limits-title\" class=\"mb-9\">\n        <div class=\"mb-4 flex flex-wrap items-end justify-between gap-4 border-b border-[#414625] pb-4\">\n          <div>\n            <h2 id=\"limits-title\" class=\"text-3xl font-bold\">Risk limits</h2>\n            <p class=\"mt-1 text-sm text-[#b6bd9b]\">Whitelist controls for a future host panel. Current configuration values are unavailable.</p>\n          </div>\n          <div class=\"border border-[#68732b] px-3 py-2 font-[Space_Mono,monospace] text-xs text-[#deff00]\">Changes take effect on next process start</div>\n        </div>\n\n        <div class=\"border border-[#414625] bg-[#10120b]\">\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] border-b border-[#414625] bg-[#191c10] px-4 py-3 font-[Space_Mono,monospace] text-[11px] text-[#deff00] sm:px-5 sm:text-xs\">\n            <div>WHITELISTED KEY</div><div>CURRENT</div><div>PROPOSED CHANGE</div>\n          </div>\n\n          <div class=\"border-b border-[#343a20] px-4 py-2 font-[Space_Mono,monospace] text-[11px] text-[#aab18d] sm:px-5\">RISK CONTROLS</div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"max-daily-loss\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">MAX_DAILY_LOSS</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"max-daily-loss\" aria-label=\"Proposed MAX_DAILY_LOSS\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"max-drawdown\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">MAX_DRAWDOWN</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"max-drawdown\" aria-label=\"Proposed MAX_DRAWDOWN\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"max-consecutive-losses\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">MAX_CONSECUTIVE_LOSSES</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"max-consecutive-losses\" aria-label=\"Proposed MAX_CONSECUTIVE_LOSSES\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"max-risk-per-trade\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">MAX_RISK_PER_TRADE</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"max-risk-per-trade\" aria-label=\"Proposed MAX_RISK_PER_TRADE\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"max-position\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">MAX_POSITION</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"max-position\" aria-label=\"Proposed MAX_POSITION\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"max-trades-per-day\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">MAX_TRADES_PER_DAY</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"max-trades-per-day\" aria-label=\"Proposed MAX_TRADES_PER_DAY\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"min-trade-interval-sec\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">MIN_TRADE_INTERVAL_SEC</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"min-trade-interval-sec\" aria-label=\"Proposed MIN_TRADE_INTERVAL_SEC\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"vol-threshold\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">VOL_THRESHOLD</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"vol-threshold\" aria-label=\"Proposed VOL_THRESHOLD\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"max-spread\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">MAX_SPREAD</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"max-spread\" aria-label=\"Proposed MAX_SPREAD\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"market-hours-only\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">MARKET_HOURS_ONLY</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"market-hours-only\" aria-label=\"Proposed MARKET_HOURS_ONLY\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"correlation-guard-enabled\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">CORRELATION_GUARD_ENABLED</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"correlation-guard-enabled\" aria-label=\"Proposed CORRELATION_GUARD_ENABLED\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"correlation-asset\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">CORRELATION_ASSET</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"correlation-asset\" aria-label=\"Proposed CORRELATION_ASSET\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"correlation-block-long-on-up\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">CORRELATION_BLOCK_LONG_ON_UP</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"correlation-block-long-on-up\" aria-label=\"Proposed CORRELATION_BLOCK_LONG_ON_UP\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n\n          <div class=\"border-b border-[#343a20] px-4 py-2 font-[Space_Mono,monospace] text-[11px] text-[#aab18d] sm:px-5\">TRADING BEHAVIOR</div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"min-confidence\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">MIN_CONFIDENCE</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"min-confidence\" aria-label=\"Proposed MIN_CONFIDENCE\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"min-ensemble-agreement\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">MIN_ENSEMBLE_AGREEMENT</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"min-ensemble-agreement\" aria-label=\"Proposed MIN_ENSEMBLE_AGREEMENT\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"use-kelly\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">USE_KELLY</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"use-kelly\" aria-label=\"Proposed USE_KELLY\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 border-b border-[#343a20] px-4 py-1.5 sm:px-5\">\n            <label for=\"kelly-fraction\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">KELLY_FRACTION</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"kelly-fraction\" aria-label=\"Proposed KELLY_FRACTION\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_100px_minmax(185px,0.68fr)] items-center gap-y-1 px-4 py-1.5 sm:px-5\">\n            <label for=\"kelly-min-trades\" class=\"break-all py-2 font-[Space_Mono,monospace] text-xs sm:text-[13px]\">KELLY_MIN_TRADES</label><span class=\"font-[Space_Mono,monospace] text-sm text-[#aeb495]\">—</span><input id=\"kelly-min-trades\" aria-label=\"Proposed KELLY_MIN_TRADES\" class=\"min-w-0 border border-[#50563a] bg-black px-3 py-2 font-[Space_Mono,monospace] text-xs text-white placeholder:text-[#858b70] focus:border-[#deff00] focus:outline-hidden\" placeholder=\"No proposal\" />\n          </div>\n        </div>\n\n        <div class=\"mt-3 grid gap-4 border border-[#414625] bg-[#11130b] p-4 md:grid-cols-[1fr_auto] md:items-center\">\n          <div>\n            <div class=\"font-[Space_Mono,monospace] text-xs text-[#deff00]\">REVIEW BEFORE WRITE</div>\n            <div class=\"mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm\">\n              <span>Propose values</span><span class=\"text-[#69704c]\">→</span><span>Review proposed diff</span><span class=\"text-[#69704c]\">→</span><span>Validated config write</span>\n            </div>\n            <p class=\"mt-2 font-[Space_Mono,monospace] text-xs text-[#aeb495]\">Proposed changes: empty · No review performed · Nothing written</p>\n          </div>\n          <button type=\"button\" disabled aria-disabled=\"true\" class=\"cursor-not-allowed border border-[#50563a] bg-[#1d2014] px-5 py-3 text-sm font-semibold text-[#898f73]\">Review proposed changes <span class=\"ml-2 font-[Space_Mono,monospace] text-[11px]\">UNAVAILABLE</span></button>\n        </div>\n        <p class=\"mt-2 font-[Space_Mono,monospace] text-xs text-[#92997b]\">Future host panel · backend config writer unavailable · inputs are proposals only</p>\n      </section>\n\n      <div class=\"grid gap-9 xl:grid-cols-[0.94fr_1.06fr]\">\n        <section aria-labelledby=\"state-title\">\n          <div class=\"mb-3 flex flex-wrap items-end justify-between gap-3 border-b border-[#414625] pb-3\">\n            <h2 id=\"state-title\" class=\"text-3xl font-bold\">Risk state</h2>\n            <span class=\"font-[Space_Mono,monospace] text-xs text-[#deff00]\">NOT LOADED</span>\n          </div>\n          <p class=\"mb-3 text-sm text-[#b6bd9b]\">RiskSupervisor snapshot unavailable. Values and counts are not assumed.</p>\n          <div class=\"grid grid-cols-[minmax(0,1fr)_minmax(105px,auto)] border-t border-[#343a20]\">\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Current equity</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Peak equity</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Daily PnL</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Daily loss ratio</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Trades today</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Consecutive losses</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Halt remaining</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Trade date</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Total checks</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Approved</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Rejected</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Approval rate</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Rejection rate</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n            <div class=\"border-b border-[#343a20] py-2.5 text-sm\">Rejection reasons</div><div class=\"border-b border-[#343a20] py-2.5 text-right font-[Space_Mono,monospace] text-xs text-[#bbc2a3]\">Not loaded</div>\n          </div>\n        </section>\n\n        <div>\n          <section aria-labelledby=\"catalog-title\" class=\"mb-8\">\n            <div class=\"flex flex-wrap items-end justify-between gap-3 border-b border-[#414625] pb-3\">\n              <h2 id=\"catalog-title\" class=\"text-3xl font-bold\">Supported reason catalog</h2>\n              <span class=\"font-[Space_Mono,monospace] text-xs text-[#aeb495]\">13 IDENTIFIERS</span>\n            </div>\n            <p class=\"mt-3 text-sm text-[#b6bd9b]\">RiskSupervisor reasons; this catalog is not an active-event feed. Counts are not loaded.</p>\n            <div class=\"mt-4 grid grid-cols-1 gap-x-6 sm:grid-cols-2\">\n              <ul class=\"divide-y divide-[#343a20] border-t border-[#343a20] font-[Space_Mono,monospace] text-xs\">\n                <li class=\"py-2.5\">APPROVED</li>\n                <li class=\"py-2.5\">CIRCUIT_BREAKER</li>\n                <li class=\"py-2.5\">HALTED</li>\n                <li class=\"py-2.5\">MAX_DRAWDOWN</li>\n                <li class=\"py-2.5\">POSITION_TOO_LARGE</li>\n                <li class=\"py-2.5\">TOO_MANY_LOSSES</li>\n                <li class=\"py-2.5\">HIGH_VOLATILITY</li>\n              </ul>\n              <ul class=\"divide-y divide-[#343a20] border-t border-[#343a20] font-[Space_Mono,monospace] text-xs\">\n                <li class=\"py-2.5\">CORRELATION_GUARD</li>\n                <li class=\"py-2.5\">EVENT_RISK</li>\n                <li class=\"py-2.5\">MAX_TRADES</li>\n                <li class=\"py-2.5\">COOLDOWN</li>\n                <li class=\"py-2.5\">SPREAD_TOO_WIDE</li>\n                <li class=\"py-2.5\">MARKET_CLOSED</li>\n              </ul>\n            </div>\n          </section>\n\n          <section aria-labelledby=\"kill-title\" class=\"border border-[#5f2923] bg-[#11120c] p-5\">\n            <div class=\"flex flex-wrap items-start justify-between gap-4\">\n              <div>\n                <h2 id=\"kill-title\" class=\"text-2xl font-bold\">Kill switch</h2>\n                <p class=\"mt-2 font-[Space_Mono,monospace] text-xs text-[#c4caaa]\">FILE MECHANISM · <span class=\"text-white\">KILL_SWITCH</span></p>\n              </div>\n              <span class=\"border border-[#555b43] px-3 py-1.5 font-[Space_Mono,monospace] text-xs text-[#d4d9bf]\">BASELINE · FILE ABSENT</span>\n            </div>\n            <p class=\"mt-3 max-w-2xl text-sm leading-5 text-[#b9c09f]\">The live loop polls this supervisor file and halts when it is present. Arming would write the file only; it does not issue broker or order calls.</p>\n            <div class=\"mt-4 flex flex-wrap items-center gap-3\">\n              <button type=\"button\" disabled aria-disabled=\"true\" class=\"cursor-not-allowed border border-[#a1271d] bg-[#8f0000] px-5 py-3 font-bold text-white\">Arm kill switch</button>\n              <span class=\"font-[Space_Mono,monospace] text-xs text-[#d19b8e]\">UNAVAILABLE · backend supervisor absent</span>\n            </div>\n          </section>\n        </div>\n      </div>\n      <footer class=\"mt-9 border-t border-[#30371a] py-4 font-[Space_Mono,monospace] text-xs text-[#909777]\">Control actions unavailable · no backend connected · frontend does not call broker or order functions</footer>\n    </main>\n  </div>\n</div>",
