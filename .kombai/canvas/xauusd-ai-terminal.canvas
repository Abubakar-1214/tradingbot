      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500;6..96,600&family=Josefin+Slab:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#1E000E] text-[#D6E6CA]\" style=\"font-family:'Josefin Slab',serif\">\n  <div class=\"mx-auto max-w-[1400px] px-7 pb-8\">\n    <header class=\"border-b border-[#765752]/60\">\n      <div class=\"flex items-center justify-between gap-6 py-4\">\n        <div class=\"flex items-center gap-3\">\n          <span class=\"grid h-10 w-10 place-items-center border border-[#C05746] text-[17px] font-semibold text-[#EBA294]\" style=\"font-family:'Bodoni Moda',serif\">Au</span>\n          <div>\n            <div class=\"text-[23px] leading-none tracking-wide\" style=\"font-family:'Bodoni Moda',serif\">XAUUSD</div>\n            <div class=\"mt-1 text-[11px] text-[#ADC698]\">OPERATIONS CONSOLE</div>\n          </div>\n        </div>\n        <div class=\"flex items-center gap-3 font-mono text-[11px]\">\n          <span class=\"border-r border-[#765752] pr-4 text-[#ADC698]\">SUPERVISOR VIEW</span>\n          <span class=\"flex items-center gap-2 text-[#EBA294]\"><span class=\"h-2 w-2 rounded-full bg-[#C05746]\"></span>DEMO · DEFAULT</span>\n        </div>\n      </div>\n      <nav aria-label=\"Primary navigation\" class=\"flex flex-wrap items-center gap-x-8 gap-y-2 text-[17px] font-semibold\">\n        <a href=\"#operations\" class=\"border-b-2 border-[#C05746] pb-3 text-[#EBA294]\">Operations</a>\n        <a href=\"#training\" class=\"pb-3 text-[#ADC698]\">Training</a>\n        <a href=\"#prepare-run\" class=\"pb-3 text-[#ADC698]\">Prepare Run</a>\n        <a href=\"#models-evaluation\" class=\"pb-3 text-[#ADC698]\">Models / Evaluation</a>\n        <a href=\"#risk-settings\" class=\"pb-3 text-[#ADC698]\">Risk / Settings</a>\n        <span class=\"ml-auto hidden items-center gap-2 pb-3 text-[13px] text-[#ADC698] lg:flex\"><i class=\"bx bx-history text-xl\"></i>Historical evidence only</span>\n      </nav>\n    </header>\n\n    <main id=\"operations\">\n      <section class=\"mt-5 rounded-2xl border border-[#765752]/70 bg-[#3A5743]/35 px-6 py-5\">\n        <div class=\"flex flex-wrap items-center justify-between gap-x-8 gap-y-4\">\n          <div class=\"max-w-[760px]\">\n            <h1 class=\"text-[40px] leading-[1.04] text-[#D6E6CA]\" style=\"font-family:'Bodoni Moda',serif\">MODEL-DRIVEN TRADING BLOCKED</h1>\n            <p class=\"mt-2 text-[15px] text-[#D6E6CA]/85\">No promoted model is available for production use. Live model-driven trades remain gated.</p>\n          </div>\n          <div class=\"flex min-w-[270px] items-start gap-3 border-l border-[#C05746]/70 pl-4\">\n            <i class=\"bx bx-lock-alt text-[24px] text-[#EBA294]\"></i>\n            <div>\n              <p class=\"text-[15px] font-semibold text-[#EBA294]\">REQUIRE_PROMOTED_MODEL=true</p>\n              <p class=\"mt-1 text-[13px] text-[#D6E6CA]/80\">No production manifest · promotion gate not met</p>\n            </div>\n          </div>\n        </div>\n        <div class=\"mt-5 grid grid-cols-1 divide-y divide-[#D6E6CA]/15 border-t border-[#D6E6CA]/20 sm:grid-cols-3 sm:divide-x sm:divide-y-0\">\n          <div class=\"py-3 sm:pr-5\"><p class=\"text-[13px] text-[#ADC698]\">Trading mode</p><p class=\"mt-1 text-[18px] font-semibold\">DEMO <span class=\"text-[13px] font-normal text-[#ADC698]\">· default</span></p></div>\n          <div class=\"py-3 sm:px-5\"><p class=\"text-[13px] text-[#ADC698]\">Production manifest</p><p class=\"mt-1 text-[18px] font-semibold\">Missing</p></div>\n          <div class=\"py-3 sm:pl-5\"><p class=\"text-[13px] text-[#ADC698]\">Inspected evaluations</p><p class=\"mt-1 text-[18px] font-semibold\">0 / 3 passed <span class=\"font-mono text-[12px] text-[#EBA294]\">· passed=false</span></p></div>\n        </div>\n      </section>\n\n      <section class=\"mt-5 grid grid-cols-1 items-start gap-5 xl:grid-cols-[minmax(0,1fr)_320px]\">\n        <div class=\"overflow-hidden rounded-2xl border border-[#765752] bg-[#100B0D]\">\n          <div class=\"flex flex-wrap items-center justify-between gap-2 border-b border-[#3F2A2B] bg-[#24151A] px-3 py-2.5\">\n            <div class=\"flex flex-wrap items-center gap-1.5 text-[13px]\">\n              <span class=\"px-2.5 py-1.5 text-[17px] font-semibold\">XAUUSD</span>\n              <button class=\"border border-[#765752]/70 bg-[#1E000E] px-3 py-1.5\">1H⌄</button>\n              <button class=\"border border-[#765752]/70 bg-[#1E000E] px-3 py-1.5\">Candles⌄</button>\n              <button class=\"border border-[#765752]/70 bg-[#1E000E] px-3 py-1.5\">Layout 1⌄</button>\n              <button class=\"border border-[#765752]/70 px-3 py-1.5 text-[#ADC698]\"><i class=\"bx bx-line-chart mr-1 text-base\"></i>Indicators</button>\n            </div>\n            <div class=\"flex items-center gap-1.5 text-[17px]\">\n              <button aria-label=\"Undo\" class=\"grid h-8 w-8 place-items-center text-[#ADC698]\"><i class=\"bx bx-undo\"></i></button>\n              <button aria-label=\"Redo\" class=\"grid h-8 w-8 place-items-center text-[#ADC698]\"><i class=\"bx bx-redo\"></i></button>\n              <span class=\"mx-1 h-5 border-l border-[#765752]\"></span>\n              <button class=\"border border-[#765752]/70 px-2.5 py-1 text-[12px]\"><i class=\"bx bx-table mr-1 text-base\"></i>Data window</button>\n              <button class=\"border border-[#765752]/70 px-2.5 py-1 text-[12px]\"><i class=\"bx bx-layer mr-1 text-base\"></i>Object tree</button>\n              <button aria-label=\"Chart settings\" class=\"grid h-8 w-8 place-items-center text-[#ADC698]\"><i class=\"bx bx-cog\"></i></button>\n            </div>\n          </div>\n          <div class=\"flex items-stretch\">\n            <aside aria-label=\"Drawing toolbar\" class=\"flex w-11 shrink-0 flex-col items-center gap-1 border-r border-[#3F2A2B] bg-[#170E11] py-2 text-[20px] text-[#ADC698]\">\n              <button aria-label=\"Cursor\" class=\"grid h-8 w-8 place-items-center bg-[#3F2A2B] text-[#EBA294]\"><i class=\"bx bx-pointer\"></i></button>\n              <button aria-label=\"Crosshair\" class=\"grid h-8 w-8 place-items-center\"><i class=\"bx bx-crosshair\"></i></button>\n              <button aria-label=\"Trend line\" class=\"grid h-8 w-8 place-items-center\"><i class=\"bx bx-trending-up\"></i></button>\n              <button aria-label=\"Horizontal line\" class=\"grid h-8 w-8 place-items-center\"><i class=\"bx bx-minus\"></i></button>\n              <button aria-label=\"Brush\" class=\"grid h-8 w-8 place-items-center\"><i class=\"bx bx-pencil\"></i></button>\n              <button aria-label=\"Measure\" class=\"grid h-8 w-8 place-items-center\"><i class=\"bx bx-ruler\"></i></button>\n              <button aria-label=\"Eraser\" class=\"grid h-8 w-8 place-items-center\"><i class=\"bx bx-eraser\"></i></button>\n              <button aria-label=\"Drawing options\" class=\"grid h-8 w-8 place-items-center\"><i class=\"bx bx-dots-horizontal-rounded\"></i></button>\n            </aside>\n            <div class=\"min-w-0 flex-1\">\n              <div class=\"flex flex-wrap items-center justify-between gap-2 border-b border-[#3F2A2B] px-4 py-2\">\n                <span class=\"text-[14px] font-semibold\">XAUUSD <span class=\"font-normal text-[#ADC698]\">· H1 · OHLCV</span></span>\n                <span class=\"flex items-center gap-2 font-mono text-[11px] font-bold text-[#EBA294]\"><i class=\"bx bx-history text-lg\"></i>HISTORICAL · NOT LIVE</span>\n              </div>\n              <svg viewBox=\"0 0 1000 410\" class=\"block h-[320px] w-full bg-[#100B0D] sm:h-[365px]\" role=\"img\" aria-label=\"Historical XAUUSD hourly candlesticks and volume from the 12 supplied bars\">\n                <rect x=\"52\" y=\"30\" width=\"874\" height=\"285\" fill=\"#100B0D\"/>\n                <g stroke=\"#3F2A2B\" stroke-width=\"1\">\n                  <path d=\"M52 70H926M52 110H926M52 150H926M52 190H926M52 230H926M52 270H926M52 310H926\"/>\n                  <path d=\"M94 30V370M307 30V370M520 30V370M733 30V370M875 30V370\"/>\n                </g>\n                <path d=\"M52 316H926\" stroke=\"#765752\" stroke-width=\"1\"/>\n                <g fill=\"#ADC698\" font-family=\"'Space Mono',monospace\" font-size=\"11\" text-anchor=\"end\">\n                  <text x=\"989\" y=\"74\">4,350</text><text x=\"989\" y=\"114\">4,340</text><text x=\"989\" y=\"154\">4,330</text><text x=\"989\" y=\"194\">4,320</text><text x=\"989\" y=\"234\">4,310</text><text x=\"989\" y=\"274\">4,300</text>\n                </g>\n                <g stroke-width=\"2\">\n                  <g stroke=\"#C05746\" fill=\"#C05746\"><path d=\"M94 150V262\"/><rect x=\"84\" y=\"174\" width=\"20\" height=\"76\"/></g>\n                  <g stroke=\"#ADC698\" fill=\"#ADC698\"><path d=\"M165 210V262\"/><rect x=\"155\" y=\"234\" width=\"20\" height=\"16\"/></g>\n                  <g stroke=\"#ADC698\" fill=\"#ADC698\"><path d=\"M236 206V266\"/><rect x=\"226\" y=\"222\" width=\"20\" height=\"12\"/></g>\n                  <g stroke=\"#ADC698\" fill=\"#ADC698\"><path d=\"M307 86V246\"/><rect x=\"297\" y=\"94\" width=\"20\" height=\"128\"/></g>\n                  <g stroke=\"#ADC698\" fill=\"#ADC698\"><path d=\"M378 62V146\"/><rect x=\"368\" y=\"92\" width=\"20\" height=\"3\"/></g>\n                  <g stroke=\"#C05746\" fill=\"#C05746\"><path d=\"M449 92V170\"/><rect x=\"439\" y=\"94\" width=\"20\" height=\"32\"/></g>\n                  <g stroke=\"#C05746\" fill=\"#C05746\"><path d=\"M520 118V210\"/><rect x=\"510\" y=\"126\" width=\"20\" height=\"60\"/></g>\n                  <g stroke=\"#C05746\" fill=\"#C05746\"><path d=\"M591 158V206\"/><rect x=\"581\" y=\"186\" width=\"20\" height=\"4\"/></g>\n                  <g stroke=\"#C05746\" fill=\"#C05746\"><path d=\"M662 150V214\"/><rect x=\"652\" y=\"190\" width=\"20\" height=\"8\"/></g>\n                  <g stroke=\"#C05746\" fill=\"#C05746\"><path d=\"M733 186V246\"/><rect x=\"723\" y=\"198\" width=\"20\" height=\"32\"/></g>\n                  <g stroke=\"#ADC698\" fill=\"#ADC698\"><path d=\"M804 178V258\"/><rect x=\"794\" y=\"222\" width=\"20\" height=\"8\"/></g>\n                  <g stroke=\"#ADC698\" fill=\"#ADC698\"><path d=\"M875 198V250\"/><rect x=\"865\" y=\"200\" width=\"20\" height=\"22\"/></g>\n                </g>\n                <g fill=\"#ADC698\" opacity=\".68\">\n                  <rect x=\"85\" y=\"347\" width=\"18\" height=\"19\"/><rect x=\"156\" y=\"353\" width=\"18\" height=\"13\"/><rect x=\"227\" y=\"350\" width=\"18\" height=\"16\"/><rect x=\"298\" y=\"337\" width=\"18\" height=\"29\"/><rect x=\"369\" y=\"329\" width=\"18\" height=\"37\"/><rect x=\"440\" y=\"326\" width=\"18\" height=\"40\"/><rect x=\"511\" y=\"342\" width=\"18\" height=\"24\"/><rect x=\"582\" y=\"344\" width=\"18\" height=\"22\"/><rect x=\"653\" y=\"341\" width=\"18\" height=\"25\"/><rect x=\"724\" y=\"345\" width=\"18\" height=\"21\"/><rect x=\"795\" y=\"339\" width=\"18\" height=\"27\"/><rect x=\"866\" y=\"357\" width=\"18\" height=\"9\"/>\n                </g>\n                <g fill=\"#ADC698\" font-family=\"'Space Mono',monospace\" font-size=\"10\">\n                  <text x=\"69\" y=\"397\">10:00</text><text x=\"282\" y=\"397\">13:00</text><text x=\"495\" y=\"397\">16:00</text><text x=\"708\" y=\"397\">19:00</text><text x=\"849\" y=\"397\">21:00 UTC</text>\n                </g>\n                <text x=\"61\" y=\"327\" fill=\"#806868\" font-family=\"'Space Mono',monospace\" font-size=\"9\">VOLUME</text>\n              </svg>\n              <div class=\"flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t border-[#3F2A2B] px-4 py-2 font-mono text-[10px] sm:text-[11px]\">\n                <span class=\"text-[#EBA294]\">data/xauusd_h1.csv · H1 · last row 2025-12-31 21:00 · close 4318.679</span>\n                <a href=\"https://velacharts.dev\" class=\"shrink-0 text-[#EBA294] underline decoration-[#C05746] underline-offset-4\">Vela™ ↗</a>\n              </div>\n              <div class=\"flex flex-wrap items-center justify-between gap-2 border-t border-[#3F2A2B] bg-[#170E11] px-3 py-2 text-[12px]\">\n                <div class=\"flex items-center gap-2\"><i class=\"bx bx-history text-xl text-[#EBA294]\"></i><span>Bar replay</span><span class=\"font-mono text-[10px] text-[#ADC698]\">HISTORICAL DATA ONLY</span></div>\n                <div class=\"flex items-center gap-2 text-[17px] text-[#D6E6CA]\"><button aria-label=\"Step back\" class=\"grid h-7 w-7 place-items-center border border-[#765752]\"><i class=\"bx bx-skip-previous\"></i></button><button aria-label=\"Play replay\" class=\"grid h-7 w-7 place-items-center border border-[#765752] text-[#EBA294]\"><i class=\"bx bx-play\"></i></button><button aria-label=\"Step forward\" class=\"grid h-7 w-7 place-items-center border border-[#765752]\"><i class=\"bx bx-skip-next\"></i></button><span class=\"ml-2 font-mono text-[10px] text-[#ADC698]\">2025-12-31 · UTC</span></div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <aside class=\"flex flex-col gap-4\">\n          <section class=\"border-l border-[#C05746]/75 pl-4\">\n            <div class=\"flex items-center justify-between gap-2\">\n              <h2 class=\"text-[20px] font-semibold\">Source details</h2>\n              <span class=\"font-mono text-[10px] text-[#EBA294]\">HISTORICAL</span>\n            </div>\n            <p class=\"mt-2 break-words font-mono text-[11px] leading-5 text-[#EBA294]\">data/xauusd_h1.csv</p>\n            <p class=\"mt-1 text-[13px] text-[#ADC698]\">12 supplied H1 bars · historical, not live</p>\n            <div class=\"mt-3 border-y border-[#765752]/60 py-3\">\n              <p class=\"text-[13px] text-[#ADC698]\">Last sourced row · 2025-12-31 21:00 UTC</p>\n              <div class=\"mt-2 grid grid-cols-2 gap-x-5 gap-y-1.5 font-mono text-[11px]\"><span>O <b class=\"font-normal text-[#D6E6CA]\">4313.305</b></span><span>H <b class=\"font-normal text-[#D6E6CA]\">4318.719</b></span><span>L <b class=\"font-normal text-[#D6E6CA]\">4306.835</b></span><span>C <b class=\"font-normal text-[#D6E6CA]\">4318.679</b></span><span>V <b class=\"font-normal text-[#D6E6CA]\">0.98619</b></span></div>\n            </div>\n            <div class=\"mt-3 flex items-center justify-between text-[12px] text-[#ADC698]\"><span>Object tree</span><span>Data window</span></div>\n            <div class=\"mt-2 flex gap-2 font-mono text-[10px] text-[#ADC698]\"><span class=\"border border-[#765752]/70 px-2 py-1\">Price · XAUUSD</span><span class=\"border border-[#765752]/70 px-2 py-1\">Volume</span><span class=\"px-2 py-1 text-[#806868]\">Drawings · none</span></div>\n            <p class=\"mt-3 text-[12px] text-[#806868]\">Indicators: none applied · no entry or stop overlays</p>\n          </section>\n\n          <section class=\"border-t border-[#765752]/60 pt-3\">\n            <h2 class=\"text-[19px] font-semibold\">Account &amp; risk</h2>\n            <p class=\"mt-1 text-[14px] text-[#EBA294]\">Live account reading unavailable</p>\n            <p class=\"mt-1 text-[12px] leading-5 text-[#ADC698]\">Account and risk state are not connected in this app.</p>\n            <div class=\"mt-3 grid grid-cols-2 gap-x-3 gap-y-2 border-y border-[#765752]/50 py-2 font-mono text-[11px]\"><span class=\"text-[#ADC698]\">Balance</span><span class=\"text-right\">—</span><span class=\"text-[#ADC698]\">Equity / daily P&amp;L</span><span class=\"text-right\">—</span><span class=\"text-[#ADC698]\">Positions</span><span class=\"text-right\">—</span><span class=\"text-[#ADC698]\">Risk checks</span><span class=\"text-right\">—</span></div>\n            <p class=\"mt-2 text-[11px] text-[#ADC698]\">Source: state files / risk state · unavailable</p>\n          </section>\n\n          <section class=\"border-t border-[#765752]/60 pt-3\">\n            <h2 class=\"text-[19px] font-semibold\">Decision &amp; reconciliation</h2>\n            <p class=\"mt-2 text-[13px] text-[#ADC698]\">No decision records connected.</p>\n            <p class=\"mt-1 text-[13px] text-[#ADC698]\">Reconciliation status unavailable.</p>\n          </section>\n\n          <section class=\"border-t border-[#765752]/60 pt-3\">\n            <div class=\"flex items-center justify-between\"><h2 class=\"text-[19px] font-semibold\">Supervisor controls</h2><i class=\"bx bx-shield-quarter text-xl text-[#EBA294]\"></i></div>\n            <p class=\"mt-1 text-[12px] leading-5 text-[#ADC698]\">Host process controls only. No broker connection or order actions.</p>\n            <div class=\"mt-3 flex gap-2\"><button disabled class=\"cursor-not-allowed border border-[#765752] px-3 py-2 text-[12px] text-[#806868]\">Start loop</button><button disabled class=\"cursor-not-allowed border border-[#765752] px-3 py-2 text-[12px] text-[#806868]\">Stop loop</button></div>\n          </section>\n        </aside>\n      </section>\n\n      <section id=\"models-evaluation\" class=\"mt-5 border-t border-[#765752]/70 pt-4\">\n        <div class=\"flex flex-wrap items-baseline justify-between gap-x-5 gap-y-1\">\n          <h2 class=\"text-[24px] font-semibold\">Evaluation evidence</h2>\n          <p class=\"text-[13px] text-[#ADC698]\">All 3 inspected records: <span class=\"font-mono text-[#EBA294]\">passed=false</span> · none is promotable</p>\n        </div>\n        <div class=\"mt-3 overflow-x-auto\">\n          <table class=\"w-full min-w-[920px] border-collapse text-left\">\n            <thead><tr class=\"border-y border-[#765752]/70 font-mono text-[10px] text-[#ADC698]\"><th class=\"py-2 pr-4 font-normal\">Evaluation artifact</th><th class=\"px-3 py-2 font-normal\">Sharpe</th><th class=\"px-3 py-2 font-normal\">Return</th><th class=\"px-3 py-2 font-normal\">Max drawdown</th><th class=\"px-3 py-2 font-normal\">Trades</th><th class=\"px-3 py-2 font-normal\">Buy &amp; hold</th><th class=\"px-3 py-2 font-normal\">Promotion</th></tr></thead>\n            <tbody class=\"font-mono text-[11px]\">\n              <tr class=\"border-b border-[#765752]/45\"><td class=\"py-3 pr-4 font-semibold text-[#D6E6CA]\">dreamer_20261003T230304213562Z <span class=\"block pt-1 font-sans text-[12px] font-normal text-[#ADC698]\">Evaluation failed: 3 trades recorded; 20 required</span></td><td class=\"px-3 py-3\">3.10</td><td class=\"px-3 py-3 text-[#ADC698]\">+6.04%</td><td class=\"px-3 py-3\">3.04%</td><td class=\"px-3 py-3\">3 / 20</td><td class=\"px-3 py-3\">−5.47%</td><td class=\"px-3 py-3 text-[#EBA294]\">NOT PROMOTABLE</td></tr>\n              <tr class=\"border-b border-[#765752]/45\"><td class=\"py-3 pr-4 font-semibold text-[#D6E6CA]\">dreamer_20261003T230535411560Z <span class=\"block pt-1 font-sans text-[12px] font-normal text-[#ADC698]\">Evaluation failed: 1 trade recorded; 20 required</span></td><td class=\"px-3 py-3\">1.71</td><td class=\"px-3 py-3 text-[#ADC698]\">+0.02%</td><td class=\"px-3 py-3\">0.02%</td><td class=\"px-3 py-3\">1 / 20</td><td class=\"px-3 py-3\">−5.47%</td><td class=\"px-3 py-3 text-[#EBA294]\">NOT PROMOTABLE</td></tr>\n              <tr class=\"border-b border-[#765752]/45\"><td class=\"py-3 pr-4 font-semibold text-[#D6E6CA]\">ppo_gold_v1 <span class=\"block pt-1 font-sans text-[12px] font-normal text-[#ADC698]\">Promotion thresholds not met</span></td><td class=\"px-3 py-3 text-[#EBA294]\">−3.21</td><td class=\"px-3 py-3 text-[#EBA294]\">−74.74%</td><td class=\"px-3 py-3 text-[#EBA294]\">74.78%</td><td class=\"px-3 py-3\">2,849</td><td class=\"px-3 py-3\">+136.48%</td><td class=\"px-3 py-3 text-[#EBA294]\">NOT PROMOTABLE</td></tr>\n            </tbody>\n          </table>\n        </div>\n        <p class=\"mt-2 font-mono text-[10px] text-[#806868]\">Evaluation source: artifacts/models/*/evaluation.json · Gate requires Sharpe ≥ 0.5 · max drawdown ≤ 20% · trades ≥ 20 · return &gt; 0%</p>\n      </section>\n    </main>\n  </div>\n</div>",
