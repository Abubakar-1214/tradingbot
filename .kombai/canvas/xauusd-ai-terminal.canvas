      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Saira:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&family=Alfa+Slab+One&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-black font-['Saira'] text-[#eef5dd]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"flex items-center justify-between border-b border-[#30380b] px-8 py-4\" data-kid=\"1-1\" data-name=\"header bar\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand logo and title container\">\n            <div class=\"flex h-9 w-9 items-center justify-center border border-[#deff00] text-lg font-extrabold text-[#deff00]\" data-kid=\"1-1-1-1\" data-name=\"brand icon\">\n                X\n            </div>\n            <div class=\"leading-tight\" data-kid=\"1-1-1-2\" data-name=\"brand text stack\">\n                <div class=\"text-base font-bold tracking-wide text-white\" data-kid=\"1-1-1-2-1\" data-name=\"app name text\">\n                    XAUUSD\n                    <span class=\"font-medium text-white/50\" data-kid=\"1-1-1-2-1-1\" data-name=\"app descriptive tag\">\n                        AI Terminal\n                    </span>\n                </div>\n                <div class=\"mt-1 font-['Space_Mono'] text-[11px] text-white/45\" data-kid=\"1-1-1-2-2\" data-name=\"control plane label\">\n                    EVALUATION CONTROL PLANE\n                </div>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-6 font-['Space_Mono'] text-xs\" data-kid=\"1-1-2\" data-name=\"status indicator cluster\">\n            <div class=\"flex items-center gap-2 text-white/55\" data-kid=\"1-1-2-1\" data-name=\"trading mode status indicator\">\n                <span class=\"h-2 w-2 bg-[#deff00]\" data-kid=\"1-1-2-1-1\" data-name=\"trading mode light bulb icon\">\n                </span>\n                TRADING MODE\n                <span class=\"font-bold text-[#deff00]\" data-kid=\"1-1-2-1-2\" data-name=\"trading mode status value\">\n                    DEMO\n                </span>\n            </div>\n            <div class=\"border-l border-[#30380b] pl-6 text-white/50\" data-kid=\"1-1-2-2\" data-name=\"model gate status indicator\">\n                MODEL GATE\n                <span class=\"ml-1 text-[#ff7777]\" data-kid=\"1-1-2-2-1\" data-name=\"model gate status value\">\n                    BLOCKED\n                </span>\n            </div>\n        </div>\n    </header>\n    <div class=\"grid grid-cols-[218px_minmax(0,1fr)]\" data-kid=\"1-2\" data-name=\"page main body grid\">\n        <aside class=\"border-r border-[#30380b] px-4 py-7\" data-kid=\"1-2-1\" data-name=\"sidebar navigation\">\n            <div class=\"mb-3 px-3 font-['Space_Mono'] text-[11px] text-white/40\" data-kid=\"1-2-1-1\" data-name=\"sidebar section header\">\n                WORKSPACE\n            </div>\n            <nav aria-label=\"Main navigation\" class=\"space-y-1 text-[15px] font-medium\" data-kid=\"1-2-1-2\" data-name=\"main navigation list\">\n                <div class=\"flex items-center gap-3 px-3 py-3 text-white/60\" data-kid=\"1-2-1-2-1\" data-name=\"navigation link\">\n                    <i class=\"ti ti-layout-dashboard text-lg\" data-kid=\"1-2-1-2-1-1\" data-name=\"navigation icon\">\n                    </i>\n                    Operations\n                </div>\n                <div class=\"flex items-center gap-3 px-3 py-3 text-white/60\" data-kid=\"1-2-1-2-2\" data-name=\"navigation link\">\n                    <i class=\"ti ti-activity text-lg\" data-kid=\"1-2-1-2-2-1\" data-name=\"navigation icon\">\n                    </i>\n                    Training\n                </div>\n                <div class=\"flex items-center gap-3 px-3 py-3 text-white/60\" data-kid=\"1-2-1-2-3\" data-name=\"navigation link\">\n                    <i class=\"ti ti-adjustments text-lg\" data-kid=\"1-2-1-2-3-1\" data-name=\"navigation icon\">\n                    </i>\n                    Prepare Run\n                </div>\n                <div aria-current=\"page\" class=\"flex items-center gap-3 border border-[#deff00] bg-[#deff00] px-3 py-3 font-bold text-black\" data-kid=\"1-2-1-2-4\" data-name=\"active navigation link\">\n                    <i class=\"ti ti-scale text-lg\" data-kid=\"1-2-1-2-4-1\" data-name=\"active navigation icon\">\n                    </i>\n                    Models / Evaluation\n                </div>\n                <div class=\"flex items-center gap-3 px-3 py-3 text-white/60\" data-kid=\"1-2-1-2-5\" data-name=\"navigation link\">\n                    <i class=\"ti ti-shield-lock text-lg\" data-kid=\"1-2-1-2-5-1\" data-name=\"navigation icon\">\n                    </i>\n                    Risk / Settings\n                </div>\n            </nav>\n            <div class=\"mt-9 border-t border-[#30380b] pt-5\" data-kid=\"1-2-1-3\" data-name=\"sidebar footer section\">\n                <div class=\"flex items-center gap-2 font-['Space_Mono'] text-[11px] text-white/45\" data-kid=\"1-2-1-3-1\" data-name=\"sidebar footer status label\">\n                    <i class=\"ti ti-lock text-base text-[#ff5757]\" data-kid=\"1-2-1-3-1-1\" data-name=\"lock icon\">\n                    </i>\n                    LIVE MODEL ACCESS\n                </div>\n                <p class=\"mt-2 px-1 text-sm leading-5 text-white/70\" data-kid=\"1-2-1-3-2\" data-name=\"sidebar footer instructional text\">\n                    Blocked until a production manifest and passing evaluation exist.\n                </p>\n            </div>\n        </aside>\n        <main class=\"min-w-0 px-8 pb-10 pt-7\" data-kid=\"1-2-2\" data-name=\"main content area\">\n            <div class=\"flex items-center justify-between gap-6\" data-kid=\"1-2-2-1\" data-name=\"content header and metadata\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"content title container\">\n                    <h1 class=\"text-[34px] font-extrabold leading-none tracking-tight text-white\" data-kid=\"1-2-2-1-1-1\" data-name=\"page headline\">\n                        Models / Evaluation\n                    </h1>\n                    <p class=\"mt-3 text-[15px] text-white/60\" data-kid=\"1-2-2-1-1-2\" data-name=\"page description\">\n                        Threshold test bench for the three actual evaluated artifacts.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-4 pb-1\" data-kid=\"1-2-2-1-2\" data-name=\"summary metric display\">\n                    <div class=\"border-r border-[#30380b] pr-4 text-right\" data-kid=\"1-2-2-1-2-1\" data-name=\"evaluated artifacts counter\">\n                        <div class=\"font-['Space_Mono'] text-[11px] text-white/45\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"evaluated artifacts label\">\n                            EVALUATED ARTIFACTS\n                        </div>\n                        <div class=\"mt-1 font-['Space_Mono'] text-sm text-white\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"evaluated artifacts count\">\n                            3\n                        </div>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"1-2-2-1-2-2\" data-name=\"passed gate counter\">\n                        <div class=\"font-['Space_Mono'] text-[11px] text-white/45\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"passed gate label\">\n                            PASSED GATE\n                        </div>\n                        <div class=\"mt-1 font-['Space_Mono'] text-sm font-bold text-[#ff6c6c]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"passed gate count\">\n                            0 / 3\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <section aria-label=\"Production slot status\" class=\"mt-6 grid grid-cols-[minmax(0,1fr)_290px] border border-[#8f0000] bg-[#5b0806]\" data-kid=\"1-2-2-2\" data-name=\"production slot status card\">\n                <div class=\"p-5\" data-kid=\"1-2-2-2-1\" data-name=\"production status details\">\n                    <div class=\"flex items-center gap-2 font-['Space_Mono'] text-xs text-[#ffc2ae]\" data-kid=\"1-2-2-2-1-1\" data-name=\"production status label\">\n                        <i class=\"ti ti-lock text-base\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"lock icon\">\n                        </i>\n                        PRODUCTION SLOT · BLOCKED\n                    </div>\n                    <div class=\"mt-2 text-[25px] font-bold leading-tight text-[#eaff9a]\" data-kid=\"1-2-2-2-1-2\" data-name=\"production slot headline\">\n                        No production manifest\n                    </div>\n                    <p class=\"mt-1 text-sm text-white/80\" data-kid=\"1-2-2-2-1-3\" data-name=\"production status description\">\n                        Existing artifact files do not fill the production slot.\n                    </p>\n                    <div class=\"mt-3 border border-[#ffb8a5]/30 px-3 py-2 font-['Space_Mono'] text-[11px] text-[#ffd7ca]\" data-kid=\"1-2-2-2-1-4\" data-name=\"manifest path display\">\n                        Expected source: artifacts/models/production/manifest.json\n                        <span class=\"ml-2 text-[#ff8b79]\" data-kid=\"1-2-2-2-1-4-1\" data-name=\"status label\">\n                            NOT PRESENT\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex flex-col justify-center gap-2 border-l border-[#ff7163]/30 p-5\" data-kid=\"1-2-2-2-2\" data-name=\"production actions cluster\">\n                    <button class=\"cursor-not-allowed border border-[#ff9b8c]/40 bg-[#310b09] px-3 py-2 text-left text-sm text-white/60\" data-kid=\"1-2-2-2-2-1\" data-name=\"promote button\" disabled=\"\" type=\"button\">\n                        Promote artifact\n                        <span class=\"float-right font-['Space_Mono'] text-xs text-[#ff8b79]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"action availability tag\">\n                            UNAVAILABLE\n                        </span>\n                    </button>\n                    <button class=\"cursor-not-allowed border border-[#ff9b8c]/40 bg-[#310b09] px-3 py-2 text-left text-sm text-white/60\" data-kid=\"1-2-2-2-2-2\" data-name=\"start live button\" disabled=\"\" type=\"button\">\n                        Start live\n                        <span class=\"float-right font-['Space_Mono'] text-xs text-[#ff8b79]\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"action availability tag\">\n                            BLOCKED\n                        </span>\n                    </button>\n                    <div class=\"font-['Space_Mono'] text-[10px] leading-4 text-white/55\" data-kid=\"1-2-2-2-2-3\" data-name=\"action dependency instruction\">\n                        REQUIRE_PROMOTED_MODEL · no evaluation passed\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"gate-heading\" class=\"mt-7\" data-kid=\"1-2-2-3\" data-name=\"test bench section\">\n                <div class=\"flex items-end justify-between border-b-2 border-[#deff00] pb-3\" data-kid=\"1-2-2-3-1\" data-name=\"test bench header\">\n                    <div data-kid=\"1-2-2-3-1-1\" data-name=\"test bench title container\">\n                        <h2 class=\"text-[24px] font-bold text-white\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"test bench heading\" id=\"gate-heading\">\n                            Gate test bench\n                        </h2>\n                        <p class=\"mt-1 text-sm text-white/55\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"test bench description\">\n                            Actual measurements against fixed promotion requirements.\n                        </p>\n                    </div>\n                    <div class=\"font-['Space_Mono'] text-[11px] text-white/45\" data-kid=\"1-2-2-3-1-2\" data-name=\"test bench threshold instruction\">\n                        PASS REQUIRES ALL FOUR THRESHOLDS\n                    </div>\n                </div>\n                <div class=\"mt-3 overflow-x-auto\" data-kid=\"1-2-2-3-2\" data-name=\"test bench table wrapper\">\n                    <table class=\"w-full table-fixed border-collapse text-left\" data-kid=\"1-2-2-3-2-1\" data-name=\"evaluation results table\">\n                        <colgroup data-kid=\"1-2-2-3-2-1-1\" data-name=\"table column groups\">\n                            <col data-kid=\"1-2-2-3-2-1-1-1\" data-name=\"table column definition\" style=\"width:27%\"/>\n                            <col data-kid=\"1-2-2-3-2-1-1-2\" data-name=\"table column definition\" style=\"width:11%\"/>\n                            <col data-kid=\"1-2-2-3-2-1-1-3\" data-name=\"table column definition\" style=\"width:13%\"/>\n                            <col data-kid=\"1-2-2-3-2-1-1-4\" data-name=\"table column definition\" style=\"width:11%\"/>\n                            <col data-kid=\"1-2-2-3-2-1-1-5\" data-name=\"table column definition\" style=\"width:14%\"/>\n                            <col data-kid=\"1-2-2-3-2-1-1-6\" data-name=\"table column definition\" style=\"width:24%\"/>\n                        </colgroup>\n                        <thead class=\"bg-[#151a00] font-['Space_Mono'] text-[11px] text-[#c6d08a]\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"table head\">\n                            <tr data-kid=\"1-2-2-3-2-1-2-1\" data-name=\"table head row\">\n                                <th class=\"border border-[#39420a] px-3 py-3 font-normal\" data-kid=\"1-2-2-3-2-1-2-1-1\" data-name=\"column header\">\n                                    ARTIFACT / RUN\n                                </th>\n                                <th class=\"border border-[#39420a] px-3 py-3 font-normal\" data-kid=\"1-2-2-3-2-1-2-1-2\" data-name=\"column header\">\n                                    <span class=\"font-bold text-[#eef5dd]\" data-kid=\"1-2-2-3-2-1-2-1-2-1\" data-name=\"column label\">\n                                        SHARPE\n                                    </span>\n                                    <br data-kid=\"1-2-2-3-2-1-2-1-2-2\" data-name=\"line break\"/>\n                                    <span class=\"text-white/45\" data-kid=\"1-2-2-3-2-1-2-1-2-3\" data-name=\"column threshold\">\n                                        ≥ 0.5\n                                    </span>\n                                </th>\n                                <th class=\"border border-[#39420a] px-3 py-3 font-normal\" data-kid=\"1-2-2-3-2-1-2-1-3\" data-name=\"column header\">\n                                    <span class=\"font-bold text-[#eef5dd]\" data-kid=\"1-2-2-3-2-1-2-1-3-1\" data-name=\"column label\">\n                                        MAX DD\n                                    </span>\n                                    <br data-kid=\"1-2-2-3-2-1-2-1-3-2\" data-name=\"line break\"/>\n                                    <span class=\"text-white/45\" data-kid=\"1-2-2-3-2-1-2-1-3-3\" data-name=\"column threshold\">\n                                        ≤ 20%\n                                    </span>\n                                </th>\n                                <th class=\"border border-[#39420a] px-3 py-3 font-normal\" data-kid=\"1-2-2-3-2-1-2-1-4\" data-name=\"column header\">\n                                    <span class=\"font-bold text-[#eef5dd]\" data-kid=\"1-2-2-3-2-1-2-1-4-1\" data-name=\"column label\">\n                                        TRADES\n                                    </span>\n                                    <br data-kid=\"1-2-2-3-2-1-2-1-4-2\" data-name=\"line break\"/>\n                                    <span class=\"text-white/45\" data-kid=\"1-2-2-3-2-1-2-1-4-3\" data-name=\"column threshold\">\n                                        ≥ 20\n                                    </span>\n                                </th>\n                                <th class=\"border border-[#39420a] px-3 py-3 font-normal\" data-kid=\"1-2-2-3-2-1-2-1-5\" data-name=\"column header\">\n                                    <span class=\"font-bold text-[#eef5dd]\" data-kid=\"1-2-2-3-2-1-2-1-5-1\" data-name=\"column label\">\n                                        TOTAL RETURN\n                                    </span>\n                                    <br data-kid=\"1-2-2-3-2-1-2-1-5-2\" data-name=\"line break\"/>\n                                    <span class=\"text-white/45\" data-kid=\"1-2-2-3-2-1-2-1-5-3\" data-name=\"column threshold\">\n                                        > 0%\n                                    </span>\n                                </th>\n                                <th class=\"border border-[#39420a] px-3 py-3 font-normal\" data-kid=\"1-2-2-3-2-1-2-1-6\" data-name=\"column header\">\n                                    EVALUATION GATE\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody class=\"[&_tr]:transition-colors [&_tr:hover]:bg-[#101500] font-['Space_Mono'] text-xs\" data-kid=\"1-2-2-3-2-1-3\" data-name=\"table body\">\n                            <tr data-kid=\"1-2-2-3-2-1-3-1\" data-name=\"table row\">\n                                <td class=\"border border-[#30380b] px-3 py-3 align-top\" data-kid=\"1-2-2-3-2-1-3-1-1\" data-name=\"artifact info cell\">\n                                    <div class=\"font-['Saira'] text-[15px] font-bold text-white\" data-kid=\"1-2-2-3-2-1-3-1-1-1\" data-name=\"artifact name\">\n                                        Dreamer\n                                    </div>\n                                    <div class=\"mt-0.5 break-all text-[11px] leading-4 text-white/65\" data-kid=\"1-2