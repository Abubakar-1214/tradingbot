      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500;6..96,600&family=Josefin+Slab:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css');\n.font-mono { font-family: 'Space Mono', monospace; }\n</style>\n<div class=\"min-h-screen bg-[#1E000E] px-8 py-6 text-[#D6E6CA] md:px-10\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Josefin Slab',serif\">\n    <header class=\"mx-auto max-w-[1360px] border-b border-[#ADC698]/20 pb-5\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"flex flex-wrap items-center justify-between gap-6\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-1\" data-name=\"brand logo and title group\">\n                <div class=\"flex h-11 w-11 items-center justify-center border border-[#C05746]/70 text-xl font-semibold text-[#EBA294]\" data-kid=\"1-1-1-1-1\" data-name=\"initial letter N\">\n                    N\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"site name and description group\">\n                    <div class=\"text-[20px] font-semibold tracking-wide\" data-kid=\"1-1-1-1-2-1\" data-name=\"terminal title text\">\n                        XAUUSD\n                        <span class=\"text-[#ADC698]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"research terminal subtitle\">\n                            / Research terminal\n                        </span>\n                    </div>\n                    <div class=\"mt-1 text-[14px] text-[#ADC698]/75\" data-kid=\"1-1-1-1-2-2\" data-name=\"historical metadata text\">\n                        Historical evidence · production model missing\n                    </div>\n                </div>\n            </div>\n            <nav aria-label=\"Primary\" class=\"flex flex-wrap items-center gap-x-7 gap-y-2 text-[17px] font-medium\" data-kid=\"1-1-1-2\" data-name=\"primary navigation bar\">\n                <span class=\"text-[#ADC698]\" data-kid=\"1-1-1-2-1\" data-name=\"operations nav link\">\n                    Operations\n                </span>\n                <span class=\"text-[#ADC698]\" data-kid=\"1-1-1-2-2\" data-name=\"training nav link\">\n                    Training\n                </span>\n                <span aria-current=\"page\" class=\"border-b-2 border-[#C05746] pb-2 text-[#EBA294]\" data-kid=\"1-1-1-2-3\" data-name=\"prepare run active nav link\">\n                    Prepare Run\n                </span>\n                <span class=\"text-[#ADC698]\" data-kid=\"1-1-1-2-4\" data-name=\"models and evaluation nav link\">\n                    Models / Evaluation\n                </span>\n                <span class=\"text-[#ADC698]\" data-kid=\"1-1-1-2-5\" data-name=\"risk and settings nav link\">\n                    Risk / Settings\n                </span>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1360px] pb-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section class=\"flex flex-wrap items-end justify-between gap-6 py-8\" data-kid=\"1-2-1\" data-name=\"page header section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"header text block\">\n                <h1 class=\"text-[48px] leading-[1.05] font-medium tracking-[-0.03em] text-[#D6E6CA]\" data-kid=\"1-2-1-1-1\" data-name=\"page title heading\" style=\"font-family:'Bodoni Moda',serif\">\n                    Prepare a run\n                </h1>\n                <p class=\"mt-3 max-w-2xl text-[18px] text-[#ADC698]\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    Review the data source, contract dependency and exact launch inputs before training.\n                </p>\n            </div>\n            <div class=\"flex max-w-[390px] items-start gap-3 border-l border-[#C05746]/70 pl-4 pb-1\" data-kid=\"1-2-1-2\" data-name=\"launch status alert box\">\n                <i class=\"bx bx-lock-alt mt-0.5 text-[24px] text-[#EBA294]\" data-kid=\"1-2-1-2-1\" data-name=\"lock icon\">\n                </i>\n                <div data-kid=\"1-2-1-2-2\" data-name=\"alert text container\">\n                    <div class=\"text-[17px] font-semibold text-[#EBA294]\" data-kid=\"1-2-1-2-2-1\" data-name=\"alert title\">\n                        Launch unavailable\n                    </div>\n                    <p class=\"mt-1 text-[14px] leading-5 text-[#ADC698]\" data-kid=\"1-2-1-2-2-2\" data-name=\"alert message\">\n                        Supervisor API is not present. Backend preflight has not run; no job can be started from this screen.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Source evidence\" class=\"grid grid-cols-1 gap-6 border-y border-[#ADC698]/25 py-6 lg:grid-cols-[1.05fr_0.95fr]\" data-kid=\"1-2-2\" data-name=\"source evidence section\">\n            <div class=\"pr-2\" data-kid=\"1-2-2-1\" data-name=\"data source column\">\n                <div class=\"flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-2-2-1-1\" data-name=\"data source header container\">\n                    <h2 class=\"text-[24px] font-semibold\" data-kid=\"1-2-2-1-1-1\" data-name=\"data source heading\">\n                        Data source\n                    </h2>\n                    <span class=\"font-mono text-[12px] text-[#ADC698]\" data-kid=\"1-2-2-1-1-2\" data-name=\"data source status badge\">\n                        LOCAL EXISTENCE · CONFIRMED\n                    </span>\n                </div>\n                <div class=\"mt-5 flex flex-wrap items-start justify-between gap-5\" data-kid=\"1-2-2-1-2\" data-name=\"data source details grid\">\n                    <div data-kid=\"1-2-2-1-2-1\" data-name=\"data file path container\">\n                        <div class=\"font-mono text-[15px] text-[#EBA294]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"data file path text\">\n                            data/xauusd_h1.csv\n                        </div>\n                        <p class=\"mt-2 text-[15px] text-[#ADC698]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"data file description\">\n                            Historical XAUUSD H1 data · selected input\n                        </p>\n                    </div>\n                    <div class=\"min-w-[180px] border-l border-[#ADC698]/20 pl-5\" data-kid=\"1-2-2-1-2-2\" data-name=\"training cutoff container\">\n                        <div class=\"text-[14px] text-[#ADC698]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"training cutoff label\">\n                            Training cutoff\n                        </div>\n                        <div class=\"mt-1 font-mono text-[15px]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"training cutoff date text\">\n                            2022-01-01\n                        </div>\n                    </div>\n                </div>\n                <p class=\"mt-4 border-t border-[#ADC698]/15 pt-3 text-[14px] text-[#ADC698]/85\" data-kid=\"1-2-2-1-3\" data-name=\"source validation message\">\n                    Source details: the file path is confirmed to exist. Row range, non-empty validation and split coverage await backend preflight.\n                </p>\n            </div>\n            <div class=\"rounded-xl bg-[#3F2A2B]/55 p-5\" data-kid=\"1-2-2-2\" data-name=\"feature contract column\">\n                <div class=\"flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-2-2-2-1\" data-name=\"contract header container\">\n                    <h2 class=\"text-[22px] font-semibold\" data-kid=\"1-2-2-2-1-1\" data-name=\"contract heading\">\n                        Feature contract → observation size\n                    </h2>\n                    <span class=\"font-mono text-[12px] text-[#EBA294]\" data-kid=\"1-2-2-2-1-2\" data-name=\"contract dependency badge\">\n                        DEPENDENCY REQUIRED\n                    </span>\n                </div>\n                <div class=\"mt-4 grid grid-cols-[1fr_auto_1fr] items-center gap-4\" data-kid=\"1-2-2-2-2\" data-name=\"contract detail mapping grid\">\n                    <div data-kid=\"1-2-2-2-2-1\" data-name=\"contract source column\">\n                        <div class=\"text-[14px] text-[#ADC698]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"contract source label\">\n                            Contract source\n                        </div>\n                        <div class=\"mt-1 font-mono text-[13px]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"contract file path\">\n                            feature_contract.json\n                        </div>\n                        <div class=\"mt-1 text-[13px] text-[#EBA294]\" data-kid=\"1-2-2-2-2-1-3\" data-name=\"contract status text\">\n                            Not checked · no contract values asserted\n                        </div>\n                    </div>\n                    <div class=\"text-[#C05746] text-[22px]\" data-kid=\"1-2-2-2-2-2\" data-name=\"mapping arrow\">\n                        →\n                    </div>\n                    <div data-kid=\"1-2-2-2-2-3\" data-name=\"dimension rule column\">\n                        <div class=\"text-[14px] text-[#ADC698]\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"dimension rule label\">\n                            Dimension rule\n                        </div>\n                        <div class=\"mt-1 font-mono text-[14px]\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"dimension rule formula\">\n                            window × n_features + 5\n                        </div>\n                        <div class=\"mt-1 text-[13px] text-[#ADC698]\" data-kid=\"1-2-2-2-2-3-3\" data-name=\"dimension status description\">\n                            Window 64 · n_features awaits contract\n                        </div>\n                    </div>\n 