      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Cuprum:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"bg-black px-5 py-5 font-['Cuprum',sans-serif] text-[#EDCC69] sm:px-8 lg:px-10\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"mx-auto max-w-[1360px]\" data-kid=\"1-1\" data-name=\"inner content wrapper\">\n        <header class=\"flex flex-col gap-5 border-b border-[#554D34] pb-5 xl:flex-row xl:items-center xl:justify-between\" data-kid=\"1-1-1\" data-name=\"header container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"branding and info group\">\n                <div class=\"flex size-11 shrink-0 items-center justify-center rounded-2xl border border-[#554D34] bg-[#0D0A03] font-['Chakra_Petch',sans-serif] text-lg font-bold\" data-kid=\"1-1-1-1-1\" data-name=\"logo badge\">\n                    V1\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"title and subtitle container\">\n                    <p class=\"font-['Chakra_Petch',sans-serif] text-xl font-semibold tracking-wide\" data-kid=\"1-1-1-1-2-1\" data-name=\"terminal name\">\n                        V1\n                        <span class=\"text-[#554D34]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"separator slash\">\n                            /\n                        </span>\n                        XAUUSD\n                    </p>\n                    <p class=\"text-sm text-[#A79D79]\" data-kid=\"1-1-1-1-2-2\" data-name=\"terminal description\">\n                        Autonomous trading terminal\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-2 text-sm\" data-kid=\"1-1-1-2\" data-name=\"system status indicators\">\n                <div class=\"rounded