2-1-3-1-1-2\" data-name=\"model passing status container\">\n                                Dreamer · passed:\n                                <span class=\"text-[#EBA294]\" data-kid=\"1-4-2-1-3-1-1-2-1\" data-name=\"passing status value\">\n                                    false\n                                </span>\n                            </p>\n                        </div>\n                        <div class=\"text-lg font-semibold\" data-kid=\"1-4-2-1-3-1-2\" data-name=\"metric value 1\" style=\"font-family:'Space Mono',monospace\">\n                            1.7140\n                            <div class=\"mt-1 font-normal text-[12px] text-[#ADC698]\" data-kid=\"1-4-2-1-3-1-2-1\" data-name=\"metric explanation 1\" style=\"font-family:'Josefin Slab',serif\">\n                                ≥ 0.5 · meets\n                            </div>\n                        </div>\n                        <div class=\"text-lg font-semibold\" data-kid=\"1-4-2-1-3-1-3\" data-name=\"metric value 2\" style=\"font-family:'Space Mono',monospace\">\n                            0.0183%\n                            <div class=\"mt-1 font-normal text-[12px] text-[#ADC698]\" data-kid=\"1-4-2-1-3-1-3-1\" data-name=\"metric explanation 2\" style=\"font-family:'Josefin Slab',serif\">\n                                ≤ 20% · meets\n                            </div>\n                        </div>\n                        <div class=\"text-lg font-semibold text-[#EBA294]\" data-kid=\"1-4-2-1-3-1-4\" data-name=\"metric value 3\" style=\"font-family:'Space Mono',monospace\">\n                            1\n                            <div class=\"mt-1 font-normal text-[12px] text-[#EBA294]\" data-kid=\"1-4-2-1-3-1-4-1\" data-name=\"metric explanation 3\" style=\"font-family:'Josefin Slab',serif\">\n                                of 20 · fails\n                            </div>\n                        </div>\n                        <div class=\"text-lg font-semibold\" data-kid=\"1-4-2-1-3-1-5\" data-name=\"metric value 4\" style=\"font-family:'Space Mono',monospace\">\n                            +0.0218%\n                            <div class=\"mt-1 font-normal text-[12px] text-[#ADC698]\" data-kid=\"1-4-2-1-3-1-5-1\" data-name=\"metric explanation 4\" style=\"font-family:'Josefin Slab',serif\">\n                                > 0% · meets\n                            </div>\n                            <div class=\"mt-2 text-sm font-normal text-[#ADC698]\" data-kid=\"1-4-2-1-3-1-5-2\" data-name=\"benchmark comparison text\" style=\"font-family:'Josefin Slab',serif\">\n                                Benchmark −5.4743%\n                            </div>\n                        </div>\n                        <div data-kid=\"1-4-2-1-3-1-6\" data-name=\"overall evaluation result container\">\n                            <div class=\"font-bold text-[#EBA294]\" data-kid=\"1-4-2-1-3-1-6-1\" data-name=\"result status headline\">\n                                NOT PROMOTABLE\n                            </div>\n                            <p class=\"mt-1 text-sm leading-snug\" data-kid=\"1-4-2-1-3-1-6-2\" data-name=\"failure reason description\">\n                                Fails trade count: 1 recorded; 20 required.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex min-w-0 flex-wrap gap-x-8 gap-y-4 border-t border-[#6A4D4B] bg-[#302427] px-5 py-4 text-sm\" data-kid=\"1-4-2-1-3-2\" data-name=\"evaluation metadata section\">\n                        <div class=\"min-w-[220px] flex-[2]\" data-kid=\"1-4-2-1-3-2-1\" data-name=\"metadata group 1\">\n                            <div class=\"text-[#ADC698]\" data-kid=\"1-4-2-1-3-2-1-1\" data-name=\"metadata label 1\">\n                                Source file\n                            </div>\n                            <div class=\"mt-1 break-all text-[12px] leading-relaxed\" data-kid=\"1-4-2-1-